  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { RiskGauge } from \'../components/RiskGauge\';\nimport { FactorBar } from \'../components/FactorBar\';\nimport { TriageLadder } from \'../components/TriageLadder\';\nimport { ClinicianSummaryModal } from \'../components/ClinicianSummaryModal\';\nimport { \n  AlertTriangle, \n  CheckCircle2, \n  HelpCircle, \n  Sparkles, \n  FileText, \n  Trash2, \n  ArrowRight, \n  ChevronRight, \n  Info, \n  Heart\n} from \'lucide-react\';\n\nexport const ResultsPage: React.FC = () => {\n  const { result, answers, t, consent, updateConsent, clearAllData } = useApp();\n  const navigate = useNavigate();\n\n  const [detailedView, setDetailedView] = useState(false);\n  const [showClinicianModal, setShowClinicianModal] = useState(false);\n  const [showConsentPromptModal, setShowConsentPromptModal] = useState(false);\n  const [showDeleteConfirmModal, setShowDeleteConfirmModal] = useState(false);\n\n  // If no result exists yet, offer demo or wizard launch\n  if (!result) {\n    return (\n      <div className=\"max-w-md mx-auto my-16 p-8 text-center glass-panel rounded-2xl border border-white/10 space-y-4\">\n        <Sparkles className=\"w-8 h-8 text-[#2DD4BF] mx-auto\" />\n        <h2 className=\"text-base font-semibold font-heading text-[#EAF4F4]\">No Active Screening Found</h2>\n        <p className=\"text-sm text-[#9FB4BA]\">\n          Complete the quick questionnaire or launch a demo case to generate an explainable screening.\n        </p>\n        <div className=\"flex justify-center gap-3 pt-2\">\n          <Link\n            to=\"/consent\"\n            className=\"px-5 py-2.5 rounded-xl bg-[#2DD4BF] text-[#07131A] text-sm font-semibold\"\n          >\n            Start Check\n          </Link>\n          <Link\n            to=\"/\"\n            className=\"px-5 py-2.5 rounded-xl border border-white/10 text-sm font-medium text-[#EAF4F4]\"\n          >\n            Back to Home\n          </Link>\n        </div>\n      </div>\n    );\n  }\n\n  const isUrgent = result.band === \'Urgent\';\n\n  const handleOpenSummary = () => {\n    if (consent.createClinicianSummary) {\n      setShowClinicianModal(true);\n    } else {\n      setShowConsentPromptModal(true);\n    }\n  };\n\n  const handleEnableSummaryConsent = () => {\n    updateConsent({ createClinicianSummary: true });\n    setShowConsentPromptModal(false);\n    setShowClinicianModal(true);\n  };\n\n  const handleConfirmDelete = () => {\n    clearAllData();\n    setShowDeleteConfirmModal(false);\n    navigate(\'/\');\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-8\">\n      {/* Principle Banner: SCREENING, NOT DIAGNOSIS */}\n      <div className=\"p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-between gap-3 text-xs sm:text-sm text-amber-200\">\n        <div className=\"flex items-center gap-2\">\n          <Info className=\"w-4 h-4 text-amber-400 shrink-0\" />\n          <span className=\"font-medium\">{t.screeningNotDiagnosis}</span>\n        </div>\n        <span className=\"text-[11px] font-mono px-2 py-0.5 rounded bg-black/20 text-amber-300 border border-amber-500/20 uppercase whitespace-nowrap\">\n          Rule-Based\n        </span>\n      </div>\n\n      {/* SECTION D: URGENT RED-FLAGS CARD (If any present, show first with prominent calm authority) */}\n      {isUrgent && (\n        <div className=\"p-6 rounded-2xl bg-rose-500/15 border-2 border-rose-500/50 shadow-2xl shadow-rose-500/10 space-y-4\">\n          <div className=\"flex items-start gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-rose-500/30 text-rose-300 flex items-center justify-center shrink-0\">\n              <AlertTriangle className=\"w-5 h-5 text-rose-400\" />\n            </div>\n            <div>\n              <h2 className=\"text-base sm:text-lg font-bold font-heading text-rose-200\">\n                {t.urgentCardTitle}\n              </h2>\n              <p className=\"text-sm text-rose-100/90 mt-1 leading-relaxed\">\n                {t.urgentCardBody}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-black/30 border border-rose-500/30 text-xs sm:text-sm text-rose-200 space-y-1.5\">\n            <span className=\"font-semibold block text-xs uppercase tracking-wider text-rose-300\">\n              Flagged Symptoms Requiring Medical Assessment Today:\n            </span>\n            <ul className=\"list-disc list-inside space-y-1\">\n              {result.redFlags.map((rf, i) => (\n                <li key={i}>{rf}</li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n            <Link\n              to=\"/care\"\n              className=\"px-5 py-2.5 rounded-xl bg-rose-500 text-white text-xs sm:text-sm font-semibold hover:bg-rose-600 transition-colors flex items-center gap-1.5\"\n            >\n              <span>{t.openCareNav} (Urgent Care Centers)</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </Link>\n          </div>\n        </div>\n      )}\n\n      {/* SECTION A: RISK OVERVIEW GAUGE & 1-SENTENCE SUMMARY */}\n      <div className=\"p-6 sm:p-8 rounded-2xl glass-panel border border-white/10 space-y-6\">\n        <div className=\"flex flex-col md:flex-row items-center justify-between gap-6\">\n          <div className=\"space-y-3 text-center md:text-left max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-[#9FB4BA]\">\n              <span>Result Category:</span>\n              <strong className=\"text-[#EAF4F4]\">{result.band} Risk Band</strong>\n            </div>\n\n            <h1 className=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#EAF4F4]\">\n              {result.summary}\n            </h1>\n\n            <p className=\"text-xs sm:text-sm text-[#9FB4BA] leading-relaxed\">\n              Calculated using transparent andrology decision criteria. Every factor contributing to this signal is detailed below so you know exactly why.\n            </p>\n\n            {result.missingInfoNote && (\n              <div className=\"p-3.5 rounded-xl bg-white/[0.03] border border-white/5 text-xs text-[#E8D5B5] flex items-center gap-2\">\n                <Info className=\"w-4 h-4 shrink-0\" />\n                <span>{result.missingInfoNote}</span>\n              </div>\n            )}\n          </div>\n\n          <div className=\"shrink-0\">\n            <RiskGauge score={result.score} band={result.band} size={190} />\n          </div>\n        </div>\n      </div>\n\n      {/* SECTION B: EXPLAINABILITY PANEL (\"Why this result?\") */}\n      <div className=\"p-6 sm:p-8 rounded-2xl glass-panel border border-white/10 space-y-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/5\">\n          <div>\n            <h2 className=\"text-base sm:text-lg font-bold font-heading text-[#EAF4F4]\">\n              {t.whyThisResult}\n            </h2>\n            <p className=\"text-xs sm:text-sm text-[#9FB4BA]\">\n              Zero black-box obscurity. Review the factors that influenced your score.\n            </p>\n          </div>\n\n          {/* Simple vs Detailed Toggle */}\n          <div className=\"flex items-center gap-1 p-1 rounded-xl bg-white/5 border border-white/10 self-start sm:self-auto\">\n            <button\n              onClick={() => setDetailedView(false)}\n              className={`px-3 py-1 text-xs font-medium rounded-lg transition-colors ${\n                !detailedView ? \'bg-[#2DD4BF] text-[#07131A] font-semibold\' : \'text-[#9FB4BA] hover:text-white\'\n              }`}\n            >\n              {t.simpleView}\n            </button>\n            <button\n              onClick={() => setDetailedView(true)}\n              className={`px-3 py-1 text-xs font-medium rounded-lg transition-colors ${\n                detailedView ? \'bg-[#2DD4BF] text-[#07131A] font-semibold\' : \'text-[#9FB4BA] hover:text-white\'\n              }`}\n            >\n              {t.detailedView}\n            </button>\n          </div>\n        </div>\n\n        {/* Contributing Risk Factors */}\n        <div className=\"space-y-3\">\n          <span className=\"text-sm font-semibold text-[#EAF4F4] block\">\n            Primary Modifiable & Identified Factors ({result.factors.length})\n          </span>\n          {result.factors.length > 0 ? (\n            result.factors.map(factor => (\n              <FactorBar key={factor.id} factor={factor} detailed={detailedView} />\n            ))\n          ) : (\n            <div className=\"p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-sm text-emerald-300\">\n              No significant elevated risk factors were identified in your profile.\n            </div>\n          )}\n        </div>\n\n        {/* Favourable Factors Working in User\'s Favour */}\n        {result.favourableFactors.length > 0 && (\n          <div className=\"space-y-3 pt-4 border-t border-white/5\">\n            <span className=\"text-sm font-semibold text-emerald-400 block\">\n              {t.favourableTitle} ({result.favourableFactors.length})\n            </span>\n            <div className=\"grid sm:grid-cols-2 gap-2.5\">\n              {result.favourableFactors.map(factor => (\n                <div\n                  key={factor.id}\n                  className=\"p-3.5 rounded-xl bg-emerald-500/[0.04] border border-emerald-500/20 text-xs sm:text-sm space-y-1\"\n                >\n                  <div className=\"flex items-center gap-1.5 text-emerald-300 font-medium\">\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                    <span>{factor.label}</span>\n                  </div>\n                  <p className=\"text-xs text-[#9FB4BA]\">{factor.explanation}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* What We Did NOT Use */}\n        <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 text-xs text-[#9FB4BA] space-y-1\">\n          <strong className=\"text-[#EAF4F4]\">{t.notUsedTitle}</strong>\n          <p>{t.notUsedList}</p>\n        </div>\n      </div>\n\n      {/* SECTION C: SCREENING VS DIAGNOSIS CARD */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-3 bg-gradient-to-r from-white/[0.02] to-transparent\">\n        <h3 className=\"text-xs font-semibold uppercase tracking-wider text-[#E8D5B5] font-mono\">\n          {t.screeningVsDiagnosis}\n        </h3>\n        <div className=\"grid sm:grid-cols-3 gap-3 text-xs sm:text-sm text-[#9FB4BA]\">\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5\">\n            <span className=\"font-semibold text-white block mb-1\">Signal, Not Disease</span>\n            <span>{t.screeningVs1}</span>\n          </div>\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5\">\n            <span className=\"font-semibold text-white block mb-1\">Doctor-Confirmed</span>\n            <span>{t.screeningVs2}</span>\n          </div>\n          <div className=\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5\">\n            <span className=\"font-semibold text-white block mb-1\">High Reversibility</span>\n            <span>{t.screeningVs3}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* SECTION E: RECOMMENDED NEXT STEP (TRIAGE LADDER) */}\n      <TriageLadder currentLevel={result.triage} reason={result.triageReason} />\n\n      {/* SECTION F: ACTION PLAN */}\n      <div className=\"grid md:grid-cols-2 gap-4\">\n        {/* Things you can start this week */}\n        <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-3\">\n          <div className=\"flex items-center gap-2 text-[#2DD4BF]\">\n            <Heart className=\"w-4 h-4\" />\n            <h3 className=\"font-heading font-semibold text-sm tracking-wide uppercase\">\n              {t.actionPlanTitle}\n            </h3>\n          </div>\n          <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#9FB4BA]\">\n            {result.actions.map((act, i) => (\n              <li key={i} className=\"flex items-start gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-[#2DD4BF] shrink-0 mt-0.5\" />\n                <span>{act}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Questions to ask doctor */}\n        <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-3\">\n          <div className=\"flex items-center gap-2 text-[#E8D5B5]\">\n            <HelpCircle className=\"w-4 h-4\" />\n            <h3 className=\"font-heading font-semibold text-sm tracking-wide uppercase\">\n              {t.questionsToAskDoctor}\n            </h3>\n          </div>\n          <ul className=\"space-y-2.5 text-xs sm:text-sm text-[#9FB4BA]\">\n            {result.doctorQuestions.map((q, i) => (\n              <li key={i} className=\"flex items-start gap-2\">\n                <ChevronRight className=\"w-4 h-4 text-[#E8D5B5] shrink-0 mt-0.5\" />\n                <span>\"{q}\"</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n      </div>\n\n      {/* SECTION G: NAVIGATION & UTILITY BUTTONS */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <div className=\"flex flex-wrap items-center gap-3 w-full sm:w-auto\">\n          <Link\n            to=\"/care\"\n            className=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-[#2DD4BF] to-[#38BDF8] text-[#07131A] text-sm font-heading font-semibold hover:shadow-lg hover:shadow-[#2DD4BF]/25 flex items-center justify-center gap-2 transition-all\"\n          >\n            <span>{t.openCareNav}</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </Link>\n\n          <button\n            onClick={handleOpenSummary}\n            className=\"w-full sm:w-auto px-5 py-3 rounded-xl border border-white/15 hover:border-white/30 text-sm font-medium text-[#EAF4F4] hover:bg-white/5 flex items-center justify-center gap-2 transition-colors\"\n          >\n            <FileText className=\"w-4 h-4 text-[#E8D5B5]\" />\n            <span>{t.createClinicianSummary}</span>\n          </button>\n        </div>\n\n        <button\n          onClick={() => setShowDeleteConfirmModal(true)}\n          className=\"text-xs sm:text-sm text-rose-400 hover:text-rose-300 flex items-center gap-1.5 p-2 rounded-lg hover:bg-rose-500/10 transition-colors\"\n        >\n          <Trash2 className=\"w-4 h-4\" />\n          <span>{t.deleteMyDataNow}</span>\n        </button>\n      </div>\n\n      {/* MODAL: Clinician Summary PDF/Print */}\n      {showClinicianModal && (\n        <ClinicianSummaryModal\n          result={result}\n          answers={answers}\n          onClose={() => setShowClinicianModal(false)}\n        />\n      )}\n\n      {/* MODAL: Prompt to enable Clinician Summary consent toggle */}\n      {showConsentPromptModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md\">\n          <div className=\"max-w-md w-full p-6 rounded-2xl bg-[#0D1F29] border border-white/10 space-y-4\">\n            <h3 className=\"text-base font-bold font-heading text-[#EAF4F4]\">Enable Clinician Summary</h3>\n            <p className=\"text-sm text-[#9FB4BA] leading-relaxed\">\n              To format your inputs into a printable summary for your clinician, please confirm that you permit HAYAT to prepare this document on your device. You retain full control over who receives it.\n            </p>\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                onClick={() => setShowConsentPromptModal(false)}\n                className=\"px-4 py-2 rounded-xl text-sm text-[#9FB4BA] hover:text-white\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleEnableSummaryConsent}\n                className=\"px-5 py-2 rounded-xl bg-[#2DD4BF] text-[#07131A] text-sm font-semibold hover:bg-[#2DD4BF]/90\"\n              >\n                Allow & Open Summary\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL: Delete Data Confirmation */}\n      {showDeleteConfirmModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md\">\n          <div className=\"max-w-md w-full p-6 rounded-2xl bg-[#0D1F29] border border-rose-500/30 space-y-4\">\n            <div className=\"flex items-center gap-2 text-rose-400\">\n              <Trash2 className=\"w-5 h-5\" />\n              <h3 className=\"text-base font-bold font-heading\">Delete All Data Immediately?</h3>\n            </div>\n            <p className=\"text-sm text-[#9FB4BA] leading-relaxed\">\n              This will irreversibly purge your answers, screening score, and any device storage. No copies will remain anywhere.\n            </p>\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                onClick={() => setShowDeleteConfirmModal(false)}\n                className=\"px-4 py-2 rounded-xl text-sm text-[#9FB4BA] hover:text-white\"\n              >\n                Keep my data\n              </button>\n              <button\n                onClick={handleConfirmDelete}\n                className=\"px-5 py-2 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600\"\n              >\n                Yes, Purge Everything\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/ResultsPage.tsx"
        }
        overwrite: true
      }
    }
