  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { NavLink, Link } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { QuickHideButton } from \'./QuickHideButton\';\nimport { LangSwitcher } from \'./LangSwitcher\';\nimport { Sun, Moon, Menu, X, ShieldAlert, Sparkles } from \'lucide-react\';\n\nexport const Navbar: React.FC = () => {\n  const { t, theme, toggleTheme, result } = useApp();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const navLinks = [\n    { to: \'/\', label: t.navHome },\n    { to: \'/check\', label: t.navCheck },\n    { to: \'/care\', label: t.navCare },\n    { to: \'/privacy\', label: t.navPrivacy },\n    { to: \'/evidence\', label: t.navEvidence },\n    { to: \'/how-it-works\', label: t.navHowItWorks },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 w-full backdrop-blur-xl bg-[#07131A]/80 border-b border-white/5 transition-colors\">\n      <div className=\"max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-2\">\n        {/* Logo */}\n        <Link to=\"/\" className=\"flex items-center gap-2.5 group\">\n          <div className=\"relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#2DD4BF] to-[#38BDF8] p-[1.5px] shadow-sm shadow-[#2DD4BF]/20\">\n            <div className=\"w-full h-full rounded-full bg-[#07131A] flex items-center justify-center overflow-hidden\">\n              {/* Minimal wave motif */}\n              <svg viewBox=\"0 0 24 24\" className=\"w-5 h-5 text-[#2DD4BF] transform group-hover:scale-110 transition-transform\">\n                <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" strokeWidth=\"1.5\" fill=\"none\" opacity=\"0.4\" />\n                <path d=\"M7 12C9 10 11 14 13 12C15 10 16 13 17 12\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n              </svg>\n            </div>\n          </div>\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"font-extrabold text-lg tracking-wider text-[#EAF4F4] font-heading\">\n                {t.appName}\n              </span>\n              <span className=\"text-[9px] uppercase tracking-widest text-[#2DD4BF] font-mono px-1.5 py-0.2 rounded bg-[#2DD4BF]/10\">\n                Front Door\n              </span>\n            </div>\n          </div>\n        </Link>\n\n        {/* Desktop Nav Links */}\n        <nav className=\"hidden md:flex items-center gap-1\">\n          {navLinks.map(link => (\n            <NavLink\n              key={link.to}\n              to={link.to}\n              className={({ isActive }) =>\n                `px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                  isActive\n                    ? \'text-[#2DD4BF] bg-[#2DD4BF]/10 font-semibold\'\n                    : \'text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\n                }`\n              }\n            >\n              {link.label}\n            </NavLink>\n          ))}\n          {result && (\n            <NavLink\n              to=\"/results\"\n              className={({ isActive }) =>\n                `flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                  isActive\n                    ? \'text-[#E8D5B5] bg-[#E8D5B5]/15 font-semibold\'\n                    : \'text-[#E8D5B5]/90 hover:text-[#E8D5B5] hover:bg-white/5\'\n                }`\n              }\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-[#E8D5B5]\" />\n              <span>Results</span>\n            </NavLink>\n          )}\n        </nav>\n\n        {/* Right utility items */}\n        <div className=\"flex items-center gap-2\">\n          {/* Theme Toggle */}\n          <button\n            onClick={toggleTheme}\n            aria-label=\"Toggle light/dark theme\"\n            className=\"p-1.5 rounded-lg text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5 transition-colors\"\n          >\n            {theme === \'dark\' ? <Sun className=\"w-4 h-4 text-[#E8D5B5]\" /> : <Moon className=\"w-4 h-4 text-[#0F766E]\" />}\n          </button>\n\n          {/* Language Switcher */}\n          <LangSwitcher />\n\n          {/* Quick Hide */}\n          <QuickHideButton />\n\n          {/* Mobile hamburger */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"md:hidden p-1.5 rounded-lg text-[#9FB4BA] hover:text-white\"\n            aria-label=\"Open menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile Drawer */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-b border-white/10 bg-[#0D1F29] px-4 py-3 space-y-1\">\n          {navLinks.map(link => (\n            <NavLink\n              key={link.to}\n              to={link.to}\n              onClick={() => setMobileMenuOpen(false)}\n              className={({ isActive }) =>\n                `block px-3 py-2 rounded-lg text-sm font-medium ${\n                  isActive\n                    ? \'text-[#2DD4BF] bg-[#2DD4BF]/10 font-semibold\'\n                    : \'text-[#9FB4BA] hover:text-white hover:bg-white/5\'\n                }`\n              }\n            >\n              {link.label}\n            </NavLink>\n          ))}\n          {result && (\n            <NavLink\n              to=\"/results\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold text-[#E8D5B5] bg-[#E8D5B5]/10\"\n            >\n              <Sparkles className=\"w-4 h-4 text-[#E8D5B5]\" />\n              <span>View Results</span>\n            </NavLink>\n          )}\n        </div>\n      )}\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
