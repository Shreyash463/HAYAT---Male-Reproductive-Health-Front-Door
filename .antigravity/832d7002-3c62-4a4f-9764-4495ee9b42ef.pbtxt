    tool_calls {
      id: "call_9760630630338730265"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { MOCK_CLINICS } from \'../data/syntheticCohort\';\\nimport { bookTeleconsult } from \'../services/api\';\\nimport {\\n  Stethoscope,\\n  MapPin,\\n  Video,\\n  Calendar,\\n  CheckCircle2,\\n  Check,\\n  Phone,\\n} from \'lucide-react\';\\n\\nexport const CareNavigatorPage: React.FC = () => {\\n  const { t, result, referralStep, setReferralStep, addLog } = useApp();\\n\\n  const [maleFriendlyOnly, setMaleFriendlyOnly] = useState(false);\\n  const [privateEntranceOnly, setPrivateEntranceOnly] = useState(false);\\n\\n  const [selectedDate, setSelectedDate] = useState(\'2026-11-09\');\\n  const [selectedTime, setSelectedTime] = useState(\'18:30 (Evening)\');\\n  const [discreetLabel] = useState(true);\\n  const [bookingConfirmed, setBookingConfirmed] = useState<{ id: string } | null>(null);\\n\\n  const filteredClinics = MOCK_CLINICS.filter(clinic => {\\n    if (maleFriendlyOnly && !clinic.features.maleFriendly) return false;\\n    if (privateEntranceOnly && !clinic.features.privateEntrance) return false;\\n    return true;\\n  });\\n\\n  const handleBookTeleconsult = async (clinicId: string) => {\\n    const res = await bookTeleconsult({\\n      clinicId,\\n      date: selectedDate,\\n      time: selectedTime,\\n      discreetLabel,\\n    });\\n    setBookingConfirmed({ id: res.bookingId });\\n    setReferralStep(1);\\n    addLog(\'Teleconsultation Requested\', `Booking ref: ${res.bookingId} (Discreet billing: ${discreetLabel})`);\\n  };\\n\\n  const currentTriage = result?.triage || \'Primary care\';\\n\\n  const pathwaySteps = [\\n    { title: \'Screened\', desc: \'Completed private assessment\' },\\n    { title: \'Booked\', desc: \'Consultation slot requested\' },\\n    { title: \'Assessed\', desc: \'Clinical exam with doctor\' },\\n    { title: \'Follow-up\', desc: \'Review tests or progress\' },\\n  ];\\n\\n  return (\\n    <div className=\\\"max-w-4xl mx-auto px-4 py-8 sm:py-10 space-y-8\\\">\\n      {/* Header */}\\n      <div className=\\\"space-y-2\\\">\\n        <div className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)] text-xs font-mono font-semibold border border-[var(--border-hairline)]\\\">\\n          <Stethoscope className=\\\"w-3.5 h-3.5\\\" />\\n          <span>Care Navigation Service</span>\\n        </div>\\n        <h1 className=\\\"text-3xl sm:text-4xl font-bold font-heading text-[var(--text-main)]\\\">\\n          {t.careNavTitle}\\n        </h1>\\n        <p className=\\\"text-base text-[var(--text-muted)]\\\">\\n          {t.careNavSub}\\n        </p>\\n      </div>\\n\\n      {/* Recommended Pathway Card */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-5\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n          <h2 className=\\\"text-lg sm:text-xl font-bold font-heading text-[var(--text-main)]\\\">\\n            Your Recommended Pathway:{\' \'}\\n            <span className=\\\"text-[var(--accent-text)]\\\">{currentTriage}</span>\\n          </h2>\\n          <span className=\\\"text-xs font-mono px-3 py-1 rounded-full bg-[var(--surface)] border border-[var(--border-hairline)] text-[var(--text-muted)]\\\">\\n            Standardized Guidance\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid md:grid-cols-3 gap-4\\\">\\n          <div className=\\\"surface-panel p-4 sm:p-5 space-y-1.5\\\">\\n            <span className=\\\"text-base font-bold text-[var(--text-main)] block\\\">{t.whatToExpect}</span>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              A private, non-judgemental conversation covering health history, timeline, and routine blood or semen checks.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"surface-panel p-4 sm:p-5 space-y-1.5\\\">\\n            <span className=\\\"text-base font-bold text-[var(--text-main)] block\\\">{t.typicalVisit}</span>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              Around 30 minutes initially. If a physical exam is suggested, your comfort and privacy come first.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"surface-panel p-4 sm:p-5 space-y-1.5\\\">\\n            <span className=\\\"text-base font-bold text-[var(--text-main)] block\\\">{t.howToPrepare}</span>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              Bring your HAYAT Clinician Summary, note questions, and allow 2\342\200\2235 days abstinence if a semen test is planned.\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Clean Stepper Timeline */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n            {t.referralTracker}\\n          </h2>\\n          <span className=\\\"text-sm font-mono font-semibold text-[var(--accent-text)]\\\">\\n            Step {referralStep + 1} of 4\\n          </span>\\n        </div>\\n\\n        <div className=\\\"grid sm:grid-cols-4 gap-3\\\">\\n          {pathwaySteps.map((step, idx) => {\\n            const isCompleted = referralStep >= idx;\\n            const isCurrent = referralStep === idx;\\n\\n            return (\\n              <button\\n                key={step.title}\\n                type=\\\"button\\\"\\n                onClick={() => setReferralStep(idx)}\\n                className={`text-start p-4 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between min-h-[116px] ${\\n                  isCompleted\\n                    ? \'bg-[var(--accent-soft)] border-[var(--accent)]\'\\n                    : \'bg-[var(--surface)] border-[var(--border-hairline)] hover:border-[var(--border-strong)]\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between gap-2 w-full\\\">\\n                  <span className=\\\"text-base font-bold text-[var(--text-main)]\\\">\\n                    {idx + 1}. {step.title}\\n                  </span>\\n                  <span\\n                    className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${\\n                      isCompleted\\n                        ? \'bg-[var(--accent)] text-white\'\\n                        : \'border border-[var(--border-strong)] bg-[var(--card)]\'\\n                    }`}\\n                  >\\n                    {isCompleted && <Check className=\\\"w-3.5 h-3.5\\\" />}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-sm text-[var(--text-muted)] mt-2 leading-snug\\\">{step.desc}</p>\\n                <span className=\\\"text-xs font-semibold text-[var(--accent-text)] mt-2\\\">\\n                  {isCurrent ? \'Current stage\' : isCompleted ? \'Completed\' : \'Tap to mark\'}\\n                </span>\\n              </button>\\n            );\\n          })}\\n        </div>\\n      </div>\\n\\n      {/* Discreet Teleconsultation */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-5\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div className=\\\"flex items-center gap-3.5\\\">\\n            <div className=\\\"w-11 h-11 rounded-2xl bg-[var(--accent-soft)] text-[var(--accent-text)] flex items-center justify-center shrink-0\\\">\\n              <Video className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n                {t.privateTeleconsult}\\n              </h2>\\n              <p className=\\\"text-sm sm:text-base text-[var(--text-muted)]\\\">\\n                Speak privately with a male reproductive clinician from home.\\n              </p>\\n            </div>\\n          </div>\\n          <span\\n            className=\\\"text-xs font-semibold px-3 py-1 rounded-full border w-fit\\\"\\n            style={{\\n              color: \'var(--risk-low)\',\\n              backgroundColor: \'var(--risk-low-bg)\',\\n              borderColor: \'var(--risk-low-border)\',\\n            }}\\n          >\\n            Available This Week\\n          </span>\\n        </div>\\n\\n        {bookingConfirmed ? (\\n          <div\\n            className=\\\"p-5 rounded-2xl border text-sm sm:text-base space-y-2\\\"\\n            style={{\\n              backgroundColor: \'var(--risk-low-bg)\',\\n              borderColor: \'var(--risk-low-border)\',\\n              color: \'var(--text-main)\',\\n            }}\\n          >\\n            <div className=\\\"flex items-center gap-2 font-bold text-base\\\" style={{ color: \'var(--risk-low)\' }}>\\n              <CheckCircle2 className=\\\"w-5 h-5\\\" />\\n              <span>Teleconsultation Slot Reserved (Demo)</span>\\n            </div>\\n            <p>\\n              Reference ID: <strong className=\\\"font-mono\\\">{bookingConfirmed.id}</strong> for {selectedDate} at {selectedTime}.\\n            </p>\\n            <p className=\\\"text-sm text-[var(--text-muted)]\\\">\\n              Discreet billing label: &ldquo;Health Wellness Consultation&rdquo;.\\n            </p>\\n          </div>\\n        ) : (\\n          <div className=\\\"grid sm:grid-cols-3 gap-4 items-end\\\">\\n            <div className=\\\"space-y-1.5\\\">\\n              <label htmlFor=\\\"teleconsult-date\\\" className=\\\"text-sm font-medium text-[var(--text-muted)] block\\\">\\n                Select Date\\n              </label>\\n              <select\\n                id=\\\"teleconsult-date\\\"\\n                value={selectedDate}\\n                onChange={e => setSelectedDate(e.target.value)}\\n                className=\\\"w-full min-h-[48px] px-3.5 rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] text-sm sm:text-base text-[var(--text-main)]\\\"\\n              >\\n                <option value=\\\"2026-11-09\\\">Mon, Nov 9</option>\\n                <option value=\\\"2026-11-10\\\">Tue, Nov 10</option>\\n                <option value=\\\"2026-11-12\\\">Thu, Nov 12</option>\\n                <option value=\\\"2026-11-14\\\">Sat, Nov 14 (Weekend)</option>\\n              </select>\\n            </div>\\n\\n            <div className=\\\"space-y-1.5\\\">\\n              <label htmlFor=\\\"teleconsult-time\\\" className=\\\"text-sm font-medium text-[var(--text-muted)] block\\\">\\n                Select Time Slot\\n              </label>\\n              <select\\n                id=\\\"teleconsult-time\\\"\\n                value={selectedTime}\\n                onChange={e => setSelectedTime(e.target.value)}\\n                className=\\\"w-full min-h-[48px] px-3.5 rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] text-sm sm:text-base text-[var(--text-main)]\\\"\\n              >\\n                <option value=\\\"18:30 (Evening)\\\">18:30 (Discreet Evening)</option>\\n                <option value=\\\"19:15 (Evening)\\\">19:15 (Discreet Evening)</option>\\n                <option value=\\\"20:00 (Late)\\\">20:00 (Discreet Late)</option>\\n                <option value=\\\"12:30 (Lunch)\\\">12:30 (Midday Break)</option>\\n              </select>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleBookTeleconsult(\'clinic-1\')}\\n              className=\\\"w-full min-h-[48px] rounded-2xl bg-[var(--accent)] text-white text-base font-semibold hover:opacity-95 transition-opacity flex items-center justify-center gap-2 cursor-pointer\\\"\\n            >\\n              <Calendar className=\\\"w-4 h-4\\\" />\\n              <span>{t.bookSlot}</span>\\n            </button>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Sample Clinics (Demo Data) */}\\n      <div className=\\\"space-y-5\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div>\\n            <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n              <h2 className=\\\"text-xl font-bold font-heading text-[var(--text-main)]\\\">\\n                Sample clinics (demo data)\\n              </h2>\\n              <span\\n                className=\\\"text-xs font-mono uppercase font-semibold px-2.5 py-0.5 rounded-full border\\\"\\n                style={{\\n                  color: \'var(--risk-mod)\',\\n                  backgroundColor: \'var(--risk-mod-bg)\',\\n                  borderColor: \'var(--risk-mod-border)\',\\n                }}\\n              >\\n                Sample data\\n              </span>\\n            </div>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] mt-1\\\">\\n              Fictional clinics illustrating privacy-conscious intake options and amenities.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2 text-sm\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setMaleFriendlyOnly(!maleFriendlyOnly)}\\n              className={`min-h-[44px] px-4 rounded-2xl border font-medium transition-colors cursor-pointer ${\\n                maleFriendlyOnly\\n                  ? \'bg-[var(--accent-soft)] border-[var(--accent)] text-[var(--accent-text)]\'\\n                  : \'bg-[var(--card)] border-[var(--border-hairline)] text-[var(--text-muted)] hover:text-[var(--text-main)]\'\\n              }`}\\n            >\\n              {t.filterMaleFriendly}\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setPrivateEntranceOnly(!privateEntranceOnly)}\\n              className={`min-h-[44px] px-4 rounded-2xl border font-medium transition-colors cursor-pointer ${\\n                privateEntranceOnly\\n                  ? \'bg-[var(--accent-soft)] border-[var(--accent)] text-[var(--accent-text)]\'\\n                  : \'bg-[var(--card)] border-[var(--border-hairline)] text-[var(--text-muted)] hover:text-[var(--text-main)]\'\\n              }`}\\n            >\\n              {t.filterPrivateEntrance}\\n            </button>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid md:grid-cols-2 gap-4\\\">\\n          {filteredClinics.map(clinic => (\\n            <div key={clinic.id} className=\\\"paper-card p-6 space-y-4 flex flex-col justify-between\\\">\\n              <div>\\n                <div className=\\\"flex items-start justify-between gap-2\\\">\\n                  <h3 className=\\\"font-heading font-bold text-base text-[var(--text-main)]\\\">\\n                    {clinic.name}\\n                  </h3>\\n                  <span className=\\\"text-xs font-mono text-[var(--text-muted)] shrink-0 bg-[var(--surface)] border border-[var(--border-hairline)] px-2.5 py-0.5 rounded-full\\\">\\n                    {clinic.distance}\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-1.5 text-sm text-[var(--text-muted)] mt-1.5\\\">\\n                  <MapPin className=\\\"w-4 h-4 text-[var(--accent-text)] shrink-0\\\" />\\n                  <span>{clinic.location}</span>\\n                </div>\\n\\n                <div className=\\\"flex flex-wrap gap-1.5 mt-3\\\">\\n                  {clinic.features.privateEntrance && (\\n                    <span className=\\\"text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--surface)] text-[var(--text-main)] border border-[var(--border-hairline)]\\\">\\n                      Private Entrance\\n                    </span>\\n                  )}\\n                  {clinic.features.maleClinicianAvailable && (\\n                    <span className=\\\"text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)] border border-[var(--border-hairline)]\\\">\\n                      Male Consultant\\n                    </span>\\n                  )}\\n                  {clinic.features.telehealthAvailable && (\\n                    <span className=\\\"text-xs font-medium px-2.5 py-1 rounded-full bg-[var(--brand-soft)] text-[var(--brand)] border border-[var(--border-hairline)]\\\">\\n                      Telehealth\\n                    </span>\\n                  )}\\n                </div>\\n\\n                <div className=\\\"mt-3 text-sm text-[var(--text-muted)]\\\">\\n                  <strong className=\\\"text-[var(--text-main)]\\\">Services:</strong> {clinic.services.join(\' \342\200\242 \')}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-3 border-t border-[var(--border-hairline)] flex items-center justify-between gap-2 text-sm\\\">\\n                <span className=\\\"text-xs sm:text-sm text-[var(--text-muted)] font-mono\\\">\\n                  Illustrative wait: ~{clinic.waitDays} days\\n                </span>\\n                <a\\n                  href={`tel:${clinic.phone}`}\\n                  className=\\\"px-4 min-h-[44px] rounded-xl bg-[var(--surface)] hover:bg-[var(--card-alt)] border border-[var(--border-hairline)] text-[var(--text-main)] text-sm font-medium flex items-center gap-1.5 transition-colors\\\"\\n                >\\n                  <Phone className=\\\"w-4 h-4 text-[var(--accent-text)]\\\" />\\n                  <span>Call Discreetly</span>\\n                </a>\\n              </div>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign CareNavigatorPage with matte paper cards, clean stepper timeline, and sample data labels\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/CareNavigatorPage.tsx\", \"toolAction\":\"Updating CareNavigatorPage component\", \"toolSummary\":\"Update CareNavigatorPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9760630630338729196"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { exportData } from \'../services/api\';\\nimport { getHumanReadableInventory } from \'../utils/formatters\';\\nimport {\\n  ShieldCheck,\\n  Trash2,\\n  Download,\\n  Clock,\\n  ChevronDown,\\n  ChevronUp,\\n  AlertCircle,\\n  CheckCircle2,\\n  Database,\\n  GlobeLock,\\n} from \'lucide-react\';\\n\\nexport const PrivacyDashboardPage: React.FC = () => {\\n  const {\\n    t,\\n    consent,\\n    updateConsent,\\n    answers,\\n    result,\\n    clearAllData,\\n    accessLogs,\\n    addLog,\\n  } = useApp();\\n\\n  const [expandedFaq, setExpandedFaq] = useState<number | null>(null);\\n  const [showWipeModal, setShowWipeModal] = useState(false);\\n  const [wipeSuccess, setWipeSuccess] = useState(false);\\n\\n  const handleExport = async () => {\\n    const jsonStr = await exportData(answers, result, consent);\\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `hayat-privacy-export-${new Date().toISOString().slice(0, 10)}.json`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n    addLog(\'Data Exported\', \'Full JSON archive downloaded to user device\');\\n  };\\n\\n  const handleWipe = () => {\\n    clearAllData();\\n    setShowWipeModal(false);\\n    setWipeSuccess(true);\\n    setTimeout(() => setWipeSuccess(false), 5000);\\n  };\\n\\n  const inventoryItems = getHumanReadableInventory(answers);\\n\\n  return (\\n    <div className=\\\"max-w-4xl mx-auto px-4 py-8 sm:py-10 space-y-8\\\">\\n      {/* Header */}\\n      <div className=\\\"space-y-2\\\">\\n        <div className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)] text-xs font-mono font-semibold border border-[var(--border-hairline)]\\\">\\n          <ShieldCheck className=\\\"w-3.5 h-3.5\\\" />\\n          <span>You&apos;re in control</span>\\n        </div>\\n        <h1 className=\\\"text-3xl sm:text-4xl font-bold font-heading text-[var(--text-main)]\\\">\\n          {t.privacyTitle}\\n        </h1>\\n        <p className=\\\"text-base text-[var(--text-muted)]\\\">\\n          {t.privacySub}\\n        </p>\\n      </div>\\n\\n      {wipeSuccess && (\\n        <div\\n          className=\\\"p-4 rounded-2xl border text-base flex items-center gap-2.5\\\"\\n          style={{\\n            backgroundColor: \'var(--risk-low-bg)\',\\n            borderColor: \'var(--risk-low-border)\',\\n            color: \'var(--risk-low)\',\\n          }}\\n        >\\n          <CheckCircle2 className=\\\"w-5 h-5 shrink-0\\\" />\\n          <span>All answers, screening results, and local storage entries were completely deleted from this device.</span>\\n        </div>\\n      )}\\n\\n      {/* What left your device */}\\n      <div className=\\\"paper-card p-6 sm:p-7 space-y-3 border-s-4\\\" style={{ borderInlineStartColor: \'var(--accent)\' }}>\\n        <div className=\\\"flex items-center gap-2.5 text-[var(--accent-text)]\\\">\\n          <GlobeLock className=\\\"w-5 h-5 shrink-0\\\" />\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n            What left your device\\n          </h2>\\n        </div>\\n        <div className=\\\"grid sm:grid-cols-2 gap-3 text-sm sm:text-base\\\">\\n          <div className=\\\"surface-panel p-4\\\">\\n            <strong className=\\\"text-[var(--text-main)] block mb-1\\\">Personal Health Answers</strong>\\n            <p className=\\\"text-[var(--text-muted)]\\\">\\n              <strong style={{ color: \'var(--risk-low)\' }}>Nothing left this device.</strong> All scoring and What-If calculations run locally inside your browser.\\n            </p>\\n          </div>\\n          <div className=\\\"surface-panel p-4\\\">\\n            <strong className=\\\"text-[var(--text-main)] block mb-1\\\">Network & Third-Party Trackers</strong>\\n            <p className=\\\"text-[var(--text-muted)]\\\">\\n              Zero ad pixels, zero analytics cookies, and zero external API calls. Fonts load for display only.\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Export & Purge Controls */}\\n      <div className=\\\"paper-card p-6 flex flex-wrap items-center justify-between gap-4\\\">\\n        <div className=\\\"max-w-md\\\">\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">Export or Delete Your Data</h2>\\n          <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] mt-0.5\\\">\\n            Download a portable JSON copy or erase every stored value immediately.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleExport}\\n            className=\\\"px-5 min-h-[48px] rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] hover:bg-[var(--card-alt)] text-sm sm:text-base font-semibold text-[var(--text-main)] flex items-center gap-2 transition-colors cursor-pointer\\\"\\n          >\\n            <Download className=\\\"w-4 h-4 text-[var(--accent-text)]\\\" />\\n            <span>{t.exportJson}</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowWipeModal(true)}\\n            className=\\\"px-5 min-h-[48px] rounded-2xl border text-sm sm:text-base font-semibold flex items-center gap-2 transition-colors cursor-pointer\\\"\\n            style={{\\n              color: \'var(--risk-urg)\',\\n              backgroundColor: \'var(--risk-urg-bg)\',\\n              borderColor: \'var(--risk-urg-border)\',\\n            }}\\n          >\\n            <Trash2 className=\\\"w-4 h-4\\\" />\\n            <span>{t.deleteEverything}</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Plain-Language Data Inventory */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Database className=\\\"w-5 h-5 text-[var(--accent-text)]\\\" />\\n            <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n              {t.dataInventory}\\n            </h2>\\n          </div>\\n          <span className=\\\"text-xs font-mono text-[var(--text-muted)] bg-[var(--surface)] border border-[var(--border-hairline)] px-3 py-1 rounded-full\\\">\\n            Storage: {consent.saveOnDevice ? \'Local browser storage (authorized)\' : \'Ephemeral session memory only\'}\\n          </span>\\n        </div>\\n\\n        <div className=\\\"border border-[var(--border-hairline)] rounded-2xl overflow-x-auto bg-[var(--surface)]\\\">\\n          <table className=\\\"w-full text-start text-sm sm:text-base\\\">\\n            <thead className=\\\"bg-[var(--card-alt)] text-[var(--text-main)] border-b border-[var(--border-hairline)]\\\">\\n              <tr>\\n                <th className=\\\"p-4 font-bold text-start\\\">Topic</th>\\n                <th className=\\\"p-4 font-bold text-start\\\">Your Answer</th>\\n                <th className=\\\"p-4 font-bold text-start\\\">Where It Lives</th>\\n                <th className=\\\"p-4 font-bold text-start\\\">Why We Ask</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-[var(--border-hairline)]\\\">\\n              {inventoryItems.map((item, idx) => (\\n                <tr key={idx} className=\\\"hover:bg-[var(--card)] transition-colors\\\">\\n                  <td className=\\\"p-4 font-semibold text-[var(--text-main)]\\\">{item.field}</td>\\n                  <td className=\\\"p-4 font-medium text-[var(--accent-text)]\\\">{item.val}</td>\\n                  <td className=\\\"p-4 text-sm text-[var(--text-muted)]\\\">{item.storage}</td>\\n                  <td className=\\\"p-4 text-sm text-[var(--text-muted)] leading-relaxed\\\">{item.purpose}</td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n\\n      {/* Live Consent Toggles */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n            Live Consent Settings\\n          </h2>\\n          <span className=\\\"text-xs sm:text-sm text-[var(--accent-text)] font-mono font-medium\\\">\\n            Changes apply immediately\\n          </span>\\n        </div>\\n\\n        <div className=\\\"space-y-3\\\">\\n          {[\\n            {\\n              key: \'processAnswers\' as const,\\n              title: t.consentOpt1,\\n              sub: \'Processes answers in browser memory to compute your results.\',\\n            },\\n            {\\n              key: \'saveOnDevice\' as const,\\n              title: t.consentOpt2,\\n              sub: \'Saves session in browser localStorage for later review.\',\\n            },\\n            {\\n              key: \'shareAnonymisedResearch\' as const,\\n              title: t.consentOpt3,\\n              sub: \'Simulated preference toggle; no data is transmitted in this prototype.\',\\n            },\\n            {\\n              key: \'createClinicianSummary\' as const,\\n              title: t.consentOpt4,\\n              sub: \'Permits formatting of printable clinician summary documents.\',\\n            },\\n          ].map(item => (\\n            <label\\n              key={item.key}\\n              className=\\\"flex items-center justify-between gap-4 p-4 min-h-[56px] rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] cursor-pointer hover:border-[var(--border-strong)] transition-colors\\\"\\n            >\\n              <div>\\n                <span className=\\\"text-base font-semibold text-[var(--text-main)] block\\\">\\n                  {item.title}\\n                </span>\\n                <span className=\\\"text-sm text-[var(--text-muted)]\\\">\\n                  {item.sub}\\n                </span>\\n              </div>\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={consent[item.key]}\\n                onChange={e => updateConsent({ [item.key]: e.target.checked })}\\n                className=\\\"w-5 h-5 rounded accent-[var(--accent)] shrink-0 cursor-pointer\\\"\\n              />\\n            </label>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Device Access Log */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <Clock className=\\\"w-5 h-5 text-[var(--brand)]\\\" />\\n            <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n              {t.accessLog}\\n            </h2>\\n          </div>\\n          <span className=\\\"text-xs font-mono text-[var(--text-muted)]\\\">\\n            {accessLogs.length} events logged\\n          </span>\\n        </div>\\n\\n        <div className=\\\"space-y-2.5 max-h-56 overflow-y-auto pe-1\\\">\\n          {accessLogs.map(log => (\\n            <div\\n              key={log.id}\\n              className=\\\"p-3.5 rounded-2xl surface-panel flex items-center justify-between gap-3 text-sm sm:text-base\\\"\\n            >\\n              <div>\\n                <span className=\\\"font-semibold text-[var(--text-main)]\\\">{log.action}</span>\\n                <span className=\\\"text-sm text-[var(--text-muted)] block mt-0.5\\\">{log.detail}</span>\\n              </div>\\n              <span className=\\\"text-xs font-mono text-[var(--text-muted)] shrink-0\\\">\\n                {new Date(log.timestamp).toLocaleTimeString()}\\n              </span>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Protection Accordion */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n          {t.howProtected}\\n        </h2>\\n\\n        <div className=\\\"space-y-2.5\\\">\\n          {[\\n            {\\n              title: \'Data Minimisation & Ephemerality\',\\n              body: \'HAYAT never asks for identity markers (name, phone, national ID, or email). Evaluation happens strictly inside your browser session.\'\\n            },\\n            {\\n              title: \'Zero Third-Party Trackers or Ad Cookies\',\\n              body: \'We omit analytics SDKs, advertising identifiers, or tracking cookies. Nothing is profiled or sold.\'\\n            },\\n            {\\n              title: \'Sandboxed Local Storage Option\',\\n              body: \'Only if you explicitly check \\\"Save on device\\\" will preferences persist in your own browser storage.\'\\n            },\\n            {\\n              title: \'Instant Full Wipe\',\\n              body: \'Clicking \\\"Delete everything now\\\" clears all application state and browser storage keys immediately.\'\\n            }\\n          ].map((item, idx) => (\\n            <div key={idx} className=\\\"border border-[var(--border-hairline)] rounded-2xl overflow-hidden bg-[var(--surface)]\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setExpandedFaq(expandedFaq === idx ? null : idx)}\\n                className=\\\"w-full text-start px-4 min-h-[52px] hover:bg-[var(--card-alt)] flex items-center justify-between text-base font-semibold text-[var(--text-main)] transition-colors cursor-pointer\\\"\\n              >\\n                <span>{item.title}</span>\\n                {expandedFaq === idx ? <ChevronUp className=\\\"w-4 h-4 shrink-0\\\" /> : <ChevronDown className=\\\"w-4 h-4 shrink-0\\\" />}\\n              </button>\\n              {expandedFaq === idx && (\\n                <div className=\\\"p-4 text-sm sm:text-base text-[var(--text-muted)] bg-[var(--card)] leading-relaxed border-t border-[var(--border-hairline)]\\\">\\n                  {item.body}\\n                </div>\\n              )}\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Wipe Modal */}\\n      {showWipeModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\\\">\\n          <div className=\\\"max-w-md w-full p-6 sm:p-7 paper-card border-2 space-y-4\\\" style={{ borderColor: \'var(--risk-urg-border)\' }}>\\n            <div className=\\\"flex items-center gap-2\\\" style={{ color: \'var(--risk-urg)\' }}>\\n              <AlertCircle className=\\\"w-5 h-5\\\" />\\n              <h3 className=\\\"text-lg font-bold font-heading\\\">Permanently Erase All Data?</h3>\\n            </div>\\n            <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              This will immediately wipe your answers, screening results, consent records, and audit events. This action cannot be reversed.\\n            </p>\\n            <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowWipeModal(false)}\\n                className=\\\"px-4 min-h-[44px] rounded-xl text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleWipe}\\n                className=\\\"px-5 min-h-[44px] rounded-xl text-white text-sm font-semibold hover:opacity-95 transition-opacity cursor-pointer\\\"\\n                style={{ backgroundColor: \'var(--risk-urg)\' }}\\n              >\\n                Erase Everything Now\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign PrivacyDashboardPage with plain-language table, \'What left your device\' panel, and matte paper cards\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/PrivacyDashboardPage.tsx\", \"toolAction\":\"Updating PrivacyDashboardPage component\", \"toolSummary\":\"Update PrivacyDashboardPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9760630630338728127"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { getEvidence } from \'../services/api\';\\nimport { SyntheticCohortMetrics } from \'../types\';\\nimport {\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  ResponsiveContainer,\\n  Cell,\\n  Legend,\\n  LabelList,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport {\\n  Activity,\\n  CheckCircle2,\\n  Scale,\\n  FileCheck,\\n  AlertCircle,\\n} from \'lucide-react\';\\n\\nexport const EvidencePage: React.FC = () => {\\n  const { t } = useApp();\\n  const [metrics, setMetrics] = useState<SyntheticCohortMetrics | null>(null);\\n\\n  useEffect(() => {\\n    getEvidence().then(setMetrics);\\n  }, []);\\n\\n  if (!metrics) {\\n    return (\\n      <div className=\\\"min-h-[50vh] flex items-center justify-center\\\">\\n        <div className=\\\"w-8 h-8 rounded-full border-2 border-[var(--accent)] border-t-transparent animate-spin\\\" />\\n      </div>\\n    );\\n  }\\n\\n  const triageColors: Record<string, string> = {\\n    \'Self-care\': \'var(--risk-low)\',\\n    \'Primary care\': \'var(--risk-mod)\',\\n    \'Andrology/Urology\': \'var(--risk-elev)\',\\n    \'Fertility service\': \'var(--accent)\',\\n    \'Urgent assessment\': \'var(--risk-urg)\',\\n  };\\n\\n  const tooltipStyle = {\\n    backgroundColor: \'var(--card)\',\\n    borderColor: \'var(--border-strong)\',\\n    borderRadius: \'14px\',\\n    color: \'var(--text-main)\',\\n    fontSize: \'13px\',\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-5xl mx-auto px-4 py-8 sm:py-10 space-y-8\\\">\\n      {/* Header */}\\n      <div className=\\\"space-y-2\\\">\\n        <div\\n          className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-mono font-semibold border\\\"\\n          style={{\\n            color: \'var(--risk-mod)\',\\n            backgroundColor: \'var(--risk-mod-bg)\',\\n            borderColor: \'var(--risk-mod-border)\',\\n          }}\\n        >\\n          <Activity className=\\\"w-3.5 h-3.5\\\" />\\n          <span>Simulated evaluation, not real patients</span>\\n        </div>\\n        <h1 className=\\\"text-3xl sm:text-4xl font-bold font-heading text-[var(--text-main)]\\\">\\n          {t.evidenceTitle}\\n        </h1>\\n        <p className=\\\"text-base text-[var(--text-muted)]\\\">\\n          500 synthetic cases run directly through the rule-based screening engine to verify rule behavior and parity.\\n        </p>\\n      </div>\\n\\n      {/* KPI Row */}\\n      <div className=\\\"grid grid-cols-2 md:grid-cols-5 gap-3.5\\\">\\n        <div className=\\\"paper-card p-5 space-y-1\\\">\\n          <span className=\\\"text-xs sm:text-sm text-[var(--text-muted)] block\\\">{t.kpiCompletion}</span>\\n          <div className=\\\"text-2xl sm:text-3xl font-extrabold font-heading text-[var(--accent-text)]\\\">\\n            {metrics.completionRate}%\\n          </div>\\n          <span className=\\\"text-xs text-[var(--text-muted)] font-mono\\\">500 simulated</span>\\n        </div>\\n\\n        <div className=\\\"paper-card p-5 space-y-1\\\">\\n          <span className=\\\"text-xs sm:text-sm text-[var(--text-muted)] block\\\">{t.kpiTime}</span>\\n          <div className=\\\"text-2xl sm:text-3xl font-extrabold font-heading text-[var(--brand)]\\\">\\n            {metrics.medianTimeWithHayatMonths} mo\\n          </div>\\n          <span className=\\\"text-xs font-mono\\\" style={{ color: \'var(--risk-low)\' }}>\\n            vs 7.5 mo standard\\n          </span>\\n        </div>\\n\\n        <div className=\\\"paper-card p-5 space-y-1\\\">\\n          <span className=\\\"text-xs sm:text-sm text-[var(--text-muted)] block\\\">{t.kpiReferral}</span>\\n          <div className=\\\"text-2xl sm:text-3xl font-extrabold font-heading text-[var(--accent-text)]\\\">\\n            {metrics.referralCompletionRate}%\\n          </div>\\n          <span className=\\\"text-xs text-[var(--text-muted)] font-mono\\\">Simulated follow-up</span>\\n        </div>\\n\\n        <div className=\\\"paper-card p-5 space-y-1\\\">\\n          <span className=\\\"text-xs sm:text-sm text-[var(--text-muted)] block\\\">{t.kpiTrust}</span>\\n          <div className=\\\"text-2xl sm:text-3xl font-extrabold font-heading\\\" style={{ color: \'var(--risk-low)\' }}>\\n            {metrics.trustScore} / 5.0\\n          </div>\\n          <span className=\\\"text-xs text-[var(--text-muted)] font-mono\\\">Simulated feedback</span>\\n        </div>\\n\\n        <div\\n          className=\\\"paper-card p-5 space-y-1 col-span-2 md:col-span-1 border\\\"\\n          style={{\\n            backgroundColor: \'var(--risk-urg-bg)\',\\n            borderColor: \'var(--risk-urg-border)\',\\n          }}\\n        >\\n          <span className=\\\"text-xs sm:text-sm font-semibold block\\\" style={{ color: \'var(--risk-urg)\' }}>\\n            Red-Flag Safety Rule\\n          </span>\\n          <div className=\\\"text-2xl sm:text-3xl font-extrabold font-heading\\\" style={{ color: \'var(--risk-urg)\' }}>\\n            100%\\n          </div>\\n          <span className=\\\"text-xs text-[var(--text-main)] leading-snug block\\\">\\n            20/20 urgent synthetic cases triggered Urgent Assessment override.\\n          </span>\\n        </div>\\n      </div>\\n\\n      {/* Charts Row 1 */}\\n      <div className=\\\"grid md:grid-cols-2 gap-6\\\">\\n        <div className=\\\"paper-card p-6 sm:p-7 space-y-4\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n              Assessment Completion Funnel\\n            </h2>\\n            <p className=\\\"text-sm text-[var(--text-muted)]\\\">\\n              Simulated retention across steps stays above 91%.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"h-72\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart\\n                data={metrics.completionFunnel}\\n                layout=\\\"vertical\\\"\\n                margin={{ left: 10, right: 42, top: 8, bottom: 8 }}\\n              >\\n                <CartesianGrid horizontal={false} stroke=\\\"var(--chart-grid)\\\" strokeDasharray=\\\"3 3\\\" />\\n                <XAxis type=\\\"number\\\" domain={[80, 100]} stroke=\\\"var(--chart-axis)\\\" fontSize={12} unit=\\\"%\\\" />\\n                <YAxis\\n                  dataKey=\\\"step\\\"\\n                  type=\\\"category\\\"\\n                  stroke=\\\"var(--chart-axis)\\\"\\n                  fontSize={12}\\n                  width={135}\\n                  tickLine={false}\\n                />\\n                <Tooltip formatter={(val: any) => [`${val}%`, \'Completion\']} contentStyle={tooltipStyle} />\\n                <Bar dataKey=\\\"completionRate\\\" fill=\\\"var(--accent)\\\" radius={[0, 6, 6, 0]}>\\n                  <LabelList\\n                    dataKey=\\\"completionRate\\\"\\n                    position=\\\"right\\\"\\n                    formatter={(v: any) => `${v}%`}\\n                    style={{ fill: \'var(--chart-axis)\', fontSize: 12, fontWeight: 600 }}\\n                  />\\n                </Bar>\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"paper-card p-6 sm:p-7 space-y-4\\\">\\n          <div>\\n            <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n              Median Months to Specialist Evaluation\\n            </h2>\\n            <p className=\\\"text-sm text-[var(--text-muted)]\\\">\\n              Simulated care-pathway timing vs historical delay baseline.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"h-72\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={metrics.timeComparison} margin={{ top: 24, right: 20, left: 10, bottom: 10 }}>\\n                <CartesianGrid vertical={false} stroke=\\\"var(--chart-grid)\\\" strokeDasharray=\\\"3 3\\\" />\\n                <XAxis dataKey=\\\"group\\\" stroke=\\\"var(--chart-axis)\\\" fontSize={12} tickLine={false} />\\n                <YAxis stroke=\\\"var(--chart-axis)\\\" fontSize={12} unit=\\\" mo\\\" />\\n                <Tooltip formatter={(val: any) => [`${val} months`, \'Median Duration\']} contentStyle={tooltipStyle} />\\n                <Bar dataKey=\\\"months\\\" radius={[8, 8, 0, 0]} maxBarSize={76}>\\n                  {metrics.timeComparison.map((_, index) => (\\n                    <Cell key={`cell-${index}`} fill={index === 0 ? \'var(--brand)\' : \'var(--accent)\'} />\\n                  ))}\\n                  <LabelList\\n                    dataKey=\\\"months\\\"\\n                    position=\\\"top\\\"\\n                    formatter={(v: any) => `${v} mo`}\\n                    style={{ fill: \'var(--chart-axis)\', fontSize: 12, fontWeight: 600 }}\\n                  />\\n                </Bar>\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Triage Distribution */}\\n      <div className=\\\"paper-card p-6 sm:p-7 space-y-4\\\">\\n        <div>\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n            Triage Distribution Across 500 Simulated Cases\\n          </h2>\\n          <p className=\\\"text-sm text-[var(--text-muted)]\\\">\\n            Live output distribution produced by the deterministic rule engine.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"h-72\\\">\\n          <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n            <BarChart data={metrics.triageDistribution} margin={{ top: 24, right: 20, left: 10, bottom: 10 }}>\\n              <CartesianGrid vertical={false} stroke=\\\"var(--chart-grid)\\\" strokeDasharray=\\\"3 3\\\" />\\n              <XAxis dataKey=\\\"level\\\" stroke=\\\"var(--chart-axis)\\\" fontSize={12} tickLine={false} />\\n              <YAxis stroke=\\\"var(--chart-axis)\\\" fontSize={12} unit=\\\"%\\\" />\\n              <Tooltip formatter={(val: any) => [`${val}%`, \'Share of cases\']} contentStyle={tooltipStyle} />\\n              <Bar dataKey=\\\"percentage\\\" radius={[8, 8, 0, 0]} maxBarSize={68}>\\n                {metrics.triageDistribution.map((entry, index) => (\\n                  <Cell key={`triage-${index}`} fill={triageColors[entry.level] || \'var(--accent)\'} />\\n                ))}\\n                <LabelList\\n                  dataKey=\\\"percentage\\\"\\n                  position=\\\"top\\\"\\n                  formatter={(v: any) => `${v}%`}\\n                  style={{ fill: \'var(--chart-axis)\', fontSize: 12, fontWeight: 600 }}\\n                />\\n              </Bar>\\n            </BarChart>\\n          </ResponsiveContainer>\\n        </div>\\n      </div>\\n\\n      {/* Fairness Audit */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <Scale className=\\\"w-5 h-5 text-[var(--accent-text)]\\\" />\\n              <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n                Demographic Fairness & Parity Audit\\n              </h2>\\n            </div>\\n            <p className=\\\"text-sm text-[var(--text-muted)] mt-0.5\\\">\\n              Checking rule consistency across age groups and interface languages.\\n            </p>\\n          </div>\\n\\n          <div\\n            className=\\\"flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs sm:text-sm font-semibold w-fit\\\"\\n            style={{\\n              color: \'var(--risk-low)\',\\n              backgroundColor: \'var(--risk-low-bg)\',\\n              borderColor: \'var(--risk-low-border)\',\\n            }}\\n          >\\n            <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>Max Disparity: {metrics.maxGapPercentage}% (&lt; 5% target)</span>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid md:grid-cols-2 gap-6\\\">\\n          <div className=\\\"surface-panel p-4 sm:p-5 space-y-3\\\">\\n            <h3 className=\\\"text-sm font-bold text-[var(--text-main)]\\\">Simulated Parity by Age Bracket</h3>\\n            <div className=\\\"h-56\\\">\\n              <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                <BarChart data={metrics.fairnessByAge} margin={{ top: 10, right: 10, left: 0, bottom: 5 }}>\\n                  <CartesianGrid vertical={false} stroke=\\\"var(--chart-grid)\\\" strokeDasharray=\\\"3 3\\\" />\\n                  <XAxis dataKey=\\\"ageGroup\\\" stroke=\\\"var(--chart-axis)\\\" fontSize={12} />\\n                  <YAxis domain={[85, 100]} stroke=\\\"var(--chart-axis)\\\" fontSize={12} unit=\\\"%\\\" />\\n                  <Tooltip contentStyle={tooltipStyle} />\\n                  <Legend wrapperStyle={{ fontSize: \'12px\' }} />\\n                  <Bar dataKey=\\\"completion\\\" fill=\\\"var(--accent)\\\" name=\\\"Completion Rate\\\" radius={[4, 4, 0, 0]} />\\n                  <Bar dataKey=\\\"triageAccuracy\\\" fill=\\\"var(--brand)\\\" name=\\\"Rule Consistency\\\" radius={[4, 4, 0, 0]} />\\n                </BarChart>\\n              </ResponsiveContainer>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"surface-panel p-4 sm:p-5 space-y-3\\\">\\n            <h3 className=\\\"text-sm font-bold text-[var(--text-main)]\\\">Simulated Parity by Language</h3>\\n            <div className=\\\"h-56\\\">\\n              <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                <BarChart data={metrics.fairnessByLanguage} margin={{ top: 10, right: 10, left: 0, bottom: 5 }}>\\n                  <CartesianGrid vertical={false} stroke=\\\"var(--chart-grid)\\\" strokeDasharray=\\\"3 3\\\" />\\n                  <XAxis dataKey=\\\"language\\\" stroke=\\\"var(--chart-axis)\\\" fontSize={12} />\\n                  <YAxis domain={[85, 100]} stroke=\\\"var(--chart-axis)\\\" fontSize={12} unit=\\\"%\\\" />\\n                  <Tooltip contentStyle={tooltipStyle} />\\n                  <Legend wrapperStyle={{ fontSize: \'12px\' }} />\\n                  <Bar dataKey=\\\"completion\\\" fill=\\\"var(--accent)\\\" name=\\\"Completion Rate\\\" radius={[4, 4, 0, 0]} />\\n                  <Bar dataKey=\\\"triageAccuracy\\\" fill=\\\"var(--brand)\\\" name=\\\"Rule Consistency\\\" radius={[4, 4, 0, 0]} />\\n                </BarChart>\\n              </ResponsiveContainer>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Honest Method and Limits Panel */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <div className=\\\"flex items-center gap-2.5 text-[var(--text-main)]\\\">\\n          <FileCheck className=\\\"w-5 h-5 text-[var(--accent-text)] shrink-0\\\" />\\n          <h2 className=\\\"text-lg sm:text-xl font-bold font-heading\\\">\\n            Method and limits\\n          </h2>\\n        </div>\\n\\n        <div className=\\\"p-4 rounded-2xl surface-panel flex items-start gap-3 text-sm sm:text-base text-[var(--text-main)]\\\">\\n          <AlertCircle className=\\\"w-5 h-5 shrink-0 mt-0.5\\\" style={{ color: \'var(--risk-mod)\' }} />\\n          <p className=\\\"leading-relaxed\\\">\\n            <strong>Important honesty note:</strong> These simulated results illustrate how the HAYAT rule set behaves across 500 synthetic profiles and{\' \'}\\n            <strong>do not prove real-world clinical accuracy, diagnostic sensitivity, or patient outcomes.</strong>\\n          </p>\\n        </div>\\n\\n        <div className=\\\"space-y-2.5 text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">\\n          <p>\\n            \342\200\242 Each of the 500 profiles was generated deterministically with seeded distributions and evaluated on-device by{\' \'}\\n            <code className=\\\"text-[var(--accent-text)] font-mono\\\">assessRisk</code>.\\n          </p>\\n          <p>\\n            \342\200\242 Every simulated case carrying an acute symptom (20/20) triggered the deterministic Urgent Assessment override by design.\\n          </p>\\n          <p>\\n            \342\200\242 Prospective clinical validation with real patient cohorts and licensed clinicians would be required before any clinical deployment.\\n          </p>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign EvidencePage with theme-aware Recharts colors, direct labels, and honest Method and limits panel\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/EvidencePage.tsx\", \"toolAction\":\"Updating EvidencePage component\", \"toolSummary\":\"Update EvidencePage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9760630630338731154"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  HelpCircle,\\n  ChevronDown,\\n  ChevronUp,\\n  AlertTriangle,\\n  Heart,\\n} from \'lucide-react\';\\n\\nexport const HowItWorksPage: React.FC = () => {\\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\\n\\n  const steps = [\\n    { num: \'01\', title: \'Private Intake\', desc: \'Answer questions on lifestyle, journey, and symptoms anonymously without login.\' },\\n    { num: \'02\', title: \'Rule-Based Engine\', desc: \'Transparent scoring informed by clinical guidelines, surfacing modifiable risks.\' },\\n    { num: \'03\', title: \'Explainable Guidance\', desc: \'Plain-language breakdown of exactly why each factor shaped your screening.\' },\\n    { num: \'04\', title: \'Targeted Triage\', desc: \'Calm pathway toward self-care, teleconsultation, or qualified andrologists.\' }\\n  ];\\n\\n  const ruleCategories = [\\n    { title: \'Conception Timeline\', weight: \'High\', desc: \'12+ months actively trying triggers recommendation for concurrent partner & male evaluation.\' },\\n    { title: \'Lifestyle & Heat Exposure\', weight: \'High (Modifiable)\', desc: \'Nicotine, alcohol, short sleep, high stress, and frequent heat exposure may raise oxidative stress.\' },\\n    { title: \'Metabolic & Endocrine Balance\', weight: \'Moderate\', desc: \'BMI, waist concern, blood glucose, and thyroid balance are associated with hormone signaling.\' },\\n    { title: \'Anatomical & Physical Signals\', weight: \'High\', desc: \'Vein heaviness (possible varicocele) or childhood history guide toward specialist physical exam.\' },\\n    { title: \'Semen Analysis (WHO 2021)\', weight: \'Direct Reference\', desc: \'Compares optional lab values against 2021 WHO 6th edition lower reference limits.\' }\\n  ];\\n\\n  const faqs = [\\n    {\\n      q: \'Is HAYAT a medical diagnosis?\',\\n      a: \'No. HAYAT is strictly a risk-screening and guidance tool. Only a qualified doctor with physical exam and laboratory testing can make a clinical diagnosis.\'\\n    },\\n    {\\n      q: \'Who can see my data?\',\\n      a: \'Only you. HAYAT does not ask for your name, phone number, or email. Answers stay in browser memory unless you clear them or save locally.\'\\n    },\\n    {\\n      q: \'Why do you ask about lifestyle and sleep?\',\\n      a: \'Sperm development takes roughly 72 to 90 days. Habits like sleep, cooling, stress, and nicotine avoidance can meaningfully support cellular quality.\'\\n    },\\n    {\\n      q: \'What if I do not have semen test results?\',\\n      a: \'You can skip that step completely. HAYAT provides an initial screening from your lifestyle, history, and symptoms alone.\'\\n    },\\n    {\\n      q: \'How does the Quick Hide feature work?\',\\n      a: \'Clicking Quick Hide, double-tapping the HAYAT logo, or pressing Esc immediately replaces the screen with a neutral wellness journal without losing your progress.\'\\n    },\\n    {\\n      q: \'What are clinical red flags?\',\\n      a: \'Red flags include sudden severe testicular pain, rapid swelling, fever with testicular ache, blood in semen, or a firm painless lump. These require same-day urgent medical evaluation.\'\\n    },\\n    {\\n      q: \'Can partners complete this together?\',\\n      a: \'Yes. Language is neutral and respectful, and can be used privately or together to prepare questions before a visit.\'\\n    },\\n    {\\n      q: \'How does HAYAT protect cultural sensitivities?\',\\n      a: \'Word choices avoid blame or assumptions, and full Arabic RTL and Hindi translations support accessibility across diverse backgrounds.\'\\n    }\\n  ];\\n\\n  return (\\n    <div className=\\\"max-w-4xl mx-auto px-4 py-8 sm:py-10 space-y-10\\\">\\n      {/* Header */}\\n      <div className=\\\"space-y-2.5 text-center max-w-2xl mx-auto\\\">\\n        <div className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)] text-xs font-mono font-semibold border border-[var(--border-hairline)]\\\">\\n          <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n          <span>Operational Transparency</span>\\n        </div>\\n        <h1 className=\\\"text-3xl sm:text-4xl font-bold font-heading text-[var(--text-main)]\\\">\\n          How HAYAT Works & Safety Boundaries\\n        </h1>\\n        <p className=\\\"text-base text-[var(--text-muted)]\\\">\\n          A transparent, rule-based screening system designed to lower stigma without sacrificing clinical clarity.\\n        </p>\\n      </div>\\n\\n      {/* 4-step overview */}\\n      <div className=\\\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        {steps.map(step => (\\n          <div key={step.num} className=\\\"paper-card p-6 space-y-2\\\">\\n            <span className=\\\"text-xs font-mono font-bold text-[var(--accent-text)] block\\\">{step.num}</span>\\n            <h2 className=\\\"font-heading font-bold text-base text-[var(--text-main)]\\\">{step.title}</h2>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">{step.desc}</p>\\n          </div>\\n        ))}\\n      </div>\\n\\n      {/* Rule categories */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-5\\\">\\n        <div>\\n          <h2 className=\\\"text-lg sm:text-xl font-bold font-heading text-[var(--text-main)]\\\">\\n            Transparent Risk Rule Categories\\n          </h2>\\n          <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] mt-0.5\\\">\\n            HAYAT uses deterministic, inspectable rules rather than opaque black-box models.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"space-y-3\\\">\\n          {ruleCategories.map((cat, idx) => (\\n            <div key={idx} className=\\\"surface-panel p-4 sm:p-5 space-y-1\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                <span className=\\\"text-base font-bold text-[var(--text-main)]\\\">{cat.title}</span>\\n                <span className=\\\"text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)]\\\">\\n                  {cat.weight}\\n                </span>\\n              </div>\\n              <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\\\">{cat.desc}</p>\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n\\n      {/* Safety & Clinical Limits */}\\n      <div\\n        className=\\\"paper-card p-6 sm:p-8 space-y-4 border-2\\\"\\n        style={{\\n          backgroundColor: \'var(--risk-urg-bg)\',\\n          borderColor: \'var(--risk-urg-border)\',\\n        }}\\n      >\\n        <div className=\\\"flex items-center gap-2.5\\\" style={{ color: \'var(--risk-urg)\' }}>\\n          <AlertTriangle className=\\\"w-5 h-5 shrink-0\\\" />\\n          <h2 className=\\\"text-lg font-bold font-heading\\\">\\n            Safety Limits & When to Seek Urgent Care\\n          </h2>\\n        </div>\\n\\n        <p className=\\\"text-base text-[var(--text-main)] leading-relaxed\\\">\\n          If you ever experience sudden severe testicular pain, rapid swelling, fever with groin ache, blood in semen, or a firm painless lump, do not wait for routine appointments. Seek same-day in-person emergency medical evaluation.\\n        </p>\\n\\n        <div className=\\\"p-4 rounded-2xl bg-[var(--card)] border border-[var(--border-hairline)] text-sm sm:text-base text-[var(--text-main)]\\\">\\n          <strong className=\\\"text-[var(--brand)] block mb-1\\\">Human-in-the-Loop Policy:</strong>\\n          Only licensed healthcare professionals make diagnostic conclusions, imaging orders, or treatment plans.\\n        </div>\\n      </div>\\n\\n      {/* Cultural respect */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-3\\\">\\n        <div className=\\\"flex items-center gap-2 text-[var(--brand)]\\\">\\n          <Heart className=\\\"w-5 h-5\\\" />\\n          <h2 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">\\n            Cultural Respect & Non-Stigmatising Design\\n          </h2>\\n        </div>\\n        <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n          Reproductive health can carry unnecessary shame or silence. HAYAT uses respectful, everyday language with full Arabic RTL and Hindi support so men can take a first step privately.\\n        </p>\\n      </div>\\n\\n      {/* FAQ Accordion */}\\n      <div className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <h2 className=\\\"text-lg sm:text-xl font-bold font-heading text-[var(--text-main)]\\\">\\n          Frequently Asked Questions (FAQ)\\n        </h2>\\n\\n        <div className=\\\"space-y-2.5\\\">\\n          {faqs.map((faq, idx) => (\\n            <div key={idx} className=\\\"border border-[var(--border-hairline)] rounded-2xl overflow-hidden bg-[var(--surface)]\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setOpenFaq(openFaq === idx ? null : idx)}\\n                className=\\\"w-full text-start px-4 min-h-[52px] hover:bg-[var(--card-alt)] flex items-center justify-between gap-3 text-base font-semibold text-[var(--text-main)] transition-colors cursor-pointer\\\"\\n              >\\n                <span>{faq.q}</span>\\n                {openFaq === idx ? (\\n                  <ChevronUp className=\\\"w-4 h-4 text-[var(--accent-text)] shrink-0\\\" />\\n                ) : (\\n                  <ChevronDown className=\\\"w-4 h-4 text-[var(--text-muted)] shrink-0\\\" />\\n                )}\\n              </button>\\n              {openFaq === idx && (\\n                <div className=\\\"p-4 text-sm sm:text-base text-[var(--text-muted)] bg-[var(--card)] leading-relaxed border-t border-[var(--border-hairline)]\\\">\\n                  {faq.a}\\n                </div>\\n              )}\\n            </div>\\n          ))}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Redesign HowItWorksPage with matte paper cards, 16px copy, and 44px+ accordion triggers\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/HowItWorksPage.tsx\", \"toolAction\":\"Updating HowItWorksPage component\", \"toolSummary\":\"Update HowItWorksPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9760630630338730085"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { Suspense } from \'react\';\\nimport { HashRouter, Routes, Route, Navigate } from \'react-router-dom\';\\nimport { AppProvider, useApp } from \'./store/AppContext\';\\nimport { Navbar } from \'./components/Navbar\';\\nimport { SafetyFooter } from \'./components/SafetyFooter\';\\nimport { QuickHideScreen } from \'./components/QuickHideScreen\';\\n\\n// Route-level code splitting\\nconst LandingPage = React.lazy(() =>\\n  import(\'./pages/LandingPage\').then(m => ({ default: m.LandingPage }))\\n);\\nconst ConsentPage = React.lazy(() =>\\n  import(\'./pages/ConsentPage\').then(m => ({ default: m.ConsentPage }))\\n);\\nconst WizardPage = React.lazy(() =>\\n  import(\'./pages/WizardPage\').then(m => ({ default: m.WizardPage }))\\n);\\nconst AnalysingPage = React.lazy(() =>\\n  import(\'./pages/AnalysingPage\').then(m => ({ default: m.AnalysingPage }))\\n);\\nconst ResultsPage = React.lazy(() =>\\n  import(\'./pages/ResultsPage\').then(m => ({ default: m.ResultsPage }))\\n);\\nconst CareNavigatorPage = React.lazy(() =>\\n  import(\'./pages/CareNavigatorPage\').then(m => ({ default: m.CareNavigatorPage }))\\n);\\nconst PrivacyDashboardPage = React.lazy(() =>\\n  import(\'./pages/PrivacyDashboardPage\').then(m => ({ default: m.PrivacyDashboardPage }))\\n);\\nconst EvidencePage = React.lazy(() =>\\n  import(\'./pages/EvidencePage\').then(m => ({ default: m.EvidencePage }))\\n);\\nconst HowItWorksPage = React.lazy(() =>\\n  import(\'./pages/HowItWorksPage\').then(m => ({ default: m.HowItWorksPage }))\\n);\\n\\nconst PageFallback: React.FC = () => (\\n  <div className=\\\"min-h-[50vh] flex items-center justify-center\\\">\\n    <div className=\\\"w-8 h-8 rounded-full border-2 border-[var(--accent)] border-t-transparent animate-spin\\\" />\\n  </div>\\n);\\n\\nconst AppLayout: React.FC = () => {\\n  const { isQuickHideActive } = useApp();\\n\\n  if (isQuickHideActive) {\\n    return <QuickHideScreen />;\\n  }\\n\\n  return (\\n    <div className=\\\"min-h-screen flex flex-col subtle-sand-bg\\\">\\n      <Navbar />\\n      <main className=\\\"flex-1\\\">\\n        <Suspense fallback={<PageFallback />}>\\n          <Routes>\\n            <Route path=\\\"/\\\" element={<LandingPage />} />\\n            <Route path=\\\"/consent\\\" element={<ConsentPage />} />\\n            <Route path=\\\"/check\\\" element={<WizardPage />} />\\n            <Route path=\\\"/analysing\\\" element={<AnalysingPage />} />\\n            <Route path=\\\"/results\\\" element={<ResultsPage />} />\\n            <Route path=\\\"/care\\\" element={<CareNavigatorPage />} />\\n            <Route path=\\\"/privacy\\\" element={<PrivacyDashboardPage />} />\\n            <Route path=\\\"/evidence\\\" element={<EvidencePage />} />\\n            <Route path=\\\"/how-it-works\\\" element={<HowItWorksPage />} />\\n            <Route path=\\\"*\\\" element={<Navigate to=\\\"/\\\" replace />} />\\n          </Routes>\\n        </Suspense>\\n      </main>\\n      <SafetyFooter />\\n    </div>\\n  );\\n};\\n\\nexport default function App() {\\n  return (\\n    <HashRouter>\\n      <AppProvider>\\n        <AppLayout />\\n      </AppProvider>\\n    </HashRouter>\\n  );\\n}\\n\", \"Description\":\"Update App.tsx with route-level React.lazy code splitting and warm sand background token\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx with code splitting\", \"toolSummary\":\"Update App.tsx\"}"
      original_name: "write_to_file"
    }
