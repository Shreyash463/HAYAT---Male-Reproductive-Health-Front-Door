      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { ArrowLeft, Compass } from \'lucide-react\';\\nimport { Reveal } from \'../motion\';\\n\\nexport const NotFoundPage: React.FC = () => {\\n  return (\\n    <div className=\\\"max-w-lg mx-auto my-20 px-4\\\">\\n      <Reveal className=\\\"paper-card p-8 sm:p-10 text-center space-y-5\\\">\\n        <div className=\\\"w-12 h-12 rounded-2xl bg-[var(--accent-soft)] text-[var(--accent-text)] border border-[var(--border-hairline)] flex items-center justify-center mx-auto\\\">\\n          <Compass className=\\\"w-6 h-6\\\" />\\n        </div>\\n        <div className=\\\"space-y-2\\\">\\n          <span className=\\\"text-xs font-mono font-bold uppercase tracking-widest text-[var(--brand)] block\\\">\\n            404 \302\267 Page Not Found\\n          </span>\\n          <h1 className=\\\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\\\">\\n            This pathway does not exist\\n          </h1>\\n          <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n            The screen you requested could not be found. Your privacy settings and any in-session progress remain untouched on your device.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap justify-center gap-3 pt-2\\\">\\n          <Link\\n            to=\\\"/\\\"\\n            className=\\\"px-6 min-h-[48px] rounded-2xl bg-[var(--accent)] text-white text-base font-heading font-semibold hover:opacity-95 inline-flex items-center gap-2\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4 rtl:rotate-180\\\" />\\n            <span>Return to HAYAT</span>\\n          </Link>\\n          <Link\\n            to=\\\"/consent\\\"\\n            className=\\\"px-5 min-h-[48px] rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] text-base font-medium text-[var(--text-main)] hover:bg-[var(--card-alt)] inline-flex items-center\\\"\\n          >\\n            Start Private Check\\n          </Link>\\n        </div>\\n      </Reveal>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create tidy 404 NotFoundPage route\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/NotFoundPage.tsx\", \"toolAction\":\"Creating NotFoundPage.tsx\", \"toolSummary\":\"Create NotFoundPage.tsx\"}"
