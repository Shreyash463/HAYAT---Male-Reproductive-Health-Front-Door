  code_action {
    action_spec {
      create_file {
        instruction: "import React, { Suspense, useEffect, useRef } from \'react\';\nimport { HashRouter, Routes, Route, useLocation } from \'react-router-dom\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport Lenis from \'lenis\';\nimport gsap from \'gsap\';\nimport { ScrollTrigger } from \'gsap/ScrollTrigger\';\nimport { AppProvider, useApp } from \'./store/AppContext\';\nimport { Navbar } from \'./components/Navbar\';\nimport { SafetyFooter } from \'./components/SafetyFooter\';\nimport { QuickHideScreen } from \'./components/QuickHideScreen\';\nimport { AmbientWaveBackground } from \'./components/AmbientWaveBackground\';\nimport { CursorGlow } from \'./components/CursorGlow\';\nimport { EASE_CALM, useIsTouchDevice, usePrefersReducedMotion } from \'./motion\';\n\ngsap.registerPlugin(ScrollTrigger);\n\n// Route-level code splitting\nconst LandingPage = React.lazy(() =>\n  import(\'./pages/LandingPage\').then(m => ({ default: m.LandingPage }))\n);\nconst ConsentPage = React.lazy(() =>\n  import(\'./pages/ConsentPage\').then(m => ({ default: m.ConsentPage }))\n);\nconst WizardPage = React.lazy(() =>\n  import(\'./pages/WizardPage\').then(m => ({ default: m.WizardPage }))\n);\nconst AnalysingPage = React.lazy(() =>\n  import(\'./pages/AnalysingPage\').then(m => ({ default: m.AnalysingPage }))\n);\nconst ResultsPage = React.lazy(() =>\n  import(\'./pages/ResultsPage\').then(m => ({ default: m.ResultsPage }))\n);\nconst CareNavigatorPage = React.lazy(() =>\n  import(\'./pages/CareNavigatorPage\').then(m => ({ default: m.CareNavigatorPage }))\n);\nconst PrivacyDashboardPage = React.lazy(() =>\n  import(\'./pages/PrivacyDashboardPage\').then(m => ({ default: m.PrivacyDashboardPage }))\n);\nconst EvidencePage = React.lazy(() =>\n  import(\'./pages/EvidencePage\').then(m => ({ default: m.EvidencePage }))\n);\nconst HowItWorksPage = React.lazy(() =>\n  import(\'./pages/HowItWorksPage\').then(m => ({ default: m.HowItWorksPage }))\n);\nconst NotFoundPage = React.lazy(() =>\n  import(\'./pages/NotFoundPage\').then(m => ({ default: m.NotFoundPage }))\n);\n\nconst PageFallback: React.FC = () => (\n  <div className=\"max-w-4xl mx-auto px-4 py-12 space-y-6\" aria-busy=\"true\" aria-label=\"Loading screen\">\n    <div className=\"paper-card p-6 sm:p-8 space-y-4\">\n      <div className=\"h-5 w-36 rounded-full skeleton-shimmer\" />\n      <div className=\"h-9 w-3/4 rounded-2xl skeleton-shimmer\" />\n      <div className=\"h-4 w-2/3 rounded-xl skeleton-shimmer\" />\n    </div>\n    <div className=\"grid sm:grid-cols-2 gap-4\">\n      <div className=\"paper-card p-6 h-40 skeleton-shimmer\" />\n      <div className=\"paper-card p-6 h-40 skeleton-shimmer\" />\n    </div>\n  </div>\n);\n\nconst AppLayout: React.FC = () => {\n  const { isQuickHideActive } = useApp();\n  const location = useLocation();\n  const reduced = usePrefersReducedMotion();\n  const isTouch = useIsTouchDevice();\n  const lenisRef = useRef<Lenis | null>(null);\n\n  // Desktop-only Lenis smooth scrolling synced with GSAP ScrollTrigger\n  useEffect(() => {\n    if (reduced || isTouch || isQuickHideActive) {\n      lenisRef.current?.destroy();\n      lenisRef.current = null;\n      return;\n    }\n\n    const lenis = new Lenis({\n      duration: 1.05,\n      easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n      smoothWheel: true,\n    });\n    lenisRef.current = lenis;\n\n    const handleLenisScroll = () => ScrollTrigger.update();\n    lenis.on(\'scroll\', handleLenisScroll);\n\n    const tick = (time: number) => {\n      lenis.raf(time * 1000);\n    };\n    gsap.ticker.add(tick);\n    gsap.ticker.lagSmoothing(0);\n\n    return () => {\n      gsap.ticker.remove(tick);\n      lenis.off(\'scroll\', handleLenisScroll);\n      lenis.destroy();\n      if (lenisRef.current === lenis) {\n        lenisRef.current = null;\n      }\n    };\n  }, [reduced, isTouch, isQuickHideActive]);\n\n  // Reset scroll to top on route transitions & refresh ScrollTrigger\n  useEffect(() => {\n    if (isQuickHideActive) return;\n    if (lenisRef.current) {\n      lenisRef.current.scrollTo(0, { immediate: true });\n    } else {\n      window.scrollTo(0, 0);\n    }\n    const timer = window.setTimeout(() => ScrollTrigger.refresh(), 120);\n    return () => window.clearTimeout(timer);\n  }, [location.pathname, isQuickHideActive]);\n\n  // SAFETY EXCEPTION: Quick Hide switches INSTANTLY with zero transition\n  if (isQuickHideActive) {\n    return <QuickHideScreen />;\n  }\n\n  return (\n    <div className=\"min-h-screen flex flex-col subtle-sand-bg relative overflow-x-clip\">\n      <AmbientWaveBackground />\n      <CursorGlow />\n      <Navbar />\n      <main className=\"flex-1 relative z-10\">\n        <Suspense fallback={<PageFallback />}>\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={location.pathname}\n              initial={reduced ? false : { opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={reduced ? undefined : { opacity: 0, y: -8 }}\n              transition={reduced ? { duration: 0 } : { duration: 0.34, ease: EASE_CALM }}\n            >\n              <Routes location={location}>\n                <Route path=\"/\" element={<LandingPage />} />\n                <Route path=\"/consent\" element={<ConsentPage />} />\n                <Route path=\"/check\" element={<WizardPage />} />\n                <Route path=\"/analysing\" element={<AnalysingPage />} />\n                <Route path=\"/results\" element={<ResultsPage />} />\n                <Route path=\"/care\" element={<CareNavigatorPage />} />\n                <Route path=\"/privacy\" element={<PrivacyDashboardPage />} />\n                <Route path=\"/evidence\" element={<EvidencePage />} />\n                <Route path=\"/how-it-works\" element={<HowItWorksPage />} />\n                <Route path=\"*\" element={<NotFoundPage />} />\n              </Routes>\n            </motion.div>\n          </AnimatePresence>\n        </Suspense>\n      </main>\n      <div className=\"relative z-10\">\n        <SafetyFooter />\n      </div>\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <HashRouter>\n      <AppProvider>\n        <AppLayout />\n      </AppProvider>\n    </HashRouter>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
