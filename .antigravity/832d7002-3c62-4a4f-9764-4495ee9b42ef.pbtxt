              text: "    field: \'Age Bracket\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val: formatLabel(answers.ageRange),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    storage: \'Local browser memory\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    purpose: \'Helps contextualize baseline hormonal patterns for your age group.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Family planning"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  items.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
