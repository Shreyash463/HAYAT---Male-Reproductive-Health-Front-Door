        instruction: "import React from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { DEMO_PERSONAS } from \'../data/personas\';\nimport { assessRisk } from \'../engine/riskEngine\';\nimport { \n  ShieldCheck, \n  ArrowRight, \n  Lock, \n  Sparkles, \n  Clock, \n  HeartHandshake, \n  Activity, \n  FileCheck,\n  ChevronRight,\n  HelpCircle,\n  Stethoscope\n} from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\nexport const LandingPage: React.FC = () => {\n  const { t, setAllAnswers, setResult, updateConsent } = useApp();\n  const navigate = useNavigate();\n\n  const handleLaunchDemo = (personaId: \'low\' | \'moderate\' | \'urgent\') => {\n    const persona = DEMO_PERSONAS.find(p => p.id === personaId);\n    if (!persona) return;\n\n    // Set answers, ensure consent is satisfied for smooth demo review, evaluate, and navigate\n    updateConsent({ processAnswers: true, createClinicianSummary: true });\n    setAllAnswers(persona.answers);\n    const computedResult = assessRisk(persona.answers);\n    setResult(computedResult);\n    navigate(\'/results\');\n  };\n\n  return (\n    <div className=\"space-y-16 pb-16\">\n      {/* Hero Section */}\n      <section className=\"relative pt-12 md:pt-20 px-4 text-center overflow-hidden\">\n        {/* Subtle mesh background is active via global .bg-wave-mesh */}\n        <div className=\"max-w-4xl mx-auto space-y-6\">\n          {/* Trust badges row */}\n          <div className=\"inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/10 text-xs text-[#9FB4BA] shadow-inner\">\n            <span className=\"flex items-center gap-1.5 text-[#2DD4BF]\">\n              <Lock className=\"w-3.5 h-3.5\" />\n              <span>{t.trustNoAccount}</span>\n            </span>\n            <span className=\"text-white/20\">\342\200\242</span>\n            <span className=\"flex items-center gap-1.5 text-[#E8D5B5]\">\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span>{t.trustDataControl}</span>\n            </span>\n            <span className=\"text-white/20\">\342\200\242</span>\n            <span className=\"flex items-center gap-1.5 text-sky-400\">\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>{t.trustExplainable}</span>\n            </span>\n          </div>\n\n          <h1 className=\"text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#EAF4F4] font-heading leading-tight max-w-3xl mx-auto\">\n            {t.heroTitle}\n          </h1>\n\n          <p className=\"text-base sm:text-lg text-[#9FB4BA] max-w-2xl mx-auto leading-relaxed\">\n            {t.heroSub}\n          </p>\n\n          <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-center gap-4\">\n            <Link\n              to=\"/consent\"\n              className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl font-heading font-semibold text-sm \n                         bg-gradient-to-r from-[#2DD4BF] to-[#38BDF8] text-[#07131A] \n                         shadow-lg shadow-[#2DD4BF]/25 hover:shadow-[#2DD4BF]/40 \n                         transform hover:-translate-y-0.5 active:translate-y-0 transition-all \n                         flex items-center justify-center gap-2 group\"\n            >\n              <span>{t.startCheck}</span>\n              <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n            </Link>\n\n            <Link\n              to=\"/how-it-works\"\n              className=\"w-full sm:w-auto px-6 py-3.5 rounded-xl font-heading font-medium text-sm \n                         glass-panel text-[#EAF4F4] hover:bg-white/10 hover:border-white/20 \n                         transition-all flex items-center justify-center gap-2\"\n            >\n              <HelpCircle className=\"w-4 h-4 text-[#9FB4BA]\" />\n              <span>{t.howItWorks}</span>\n            </Link>\n          </div>\n        </div>\n      </section>\n\n      {/* Demo Personas for Judges & Testing */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"p-6 rounded-2xl glass-panel border border-[#2DD4BF]/20 shadow-xl bg-gradient-to-b from-[#0D1F29] to-[#07131A]\">\n          <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pb-4 border-b border-white/5\">\n            <div>\n              <span className=\"text-[10px] uppercase font-mono tracking-widest text-[#2DD4BF] font-semibold\">\n                Instant Verification\n              </span>\n              <h2 className=\"text-sm sm:text-base font-heading font-bold text-[#EAF4F4] mt-0.5\">\n                {t.tryDemoCase}\n              </h2>\n            </div>\n            <p className=\"text-xs text-[#9FB4BA] max-w-md\">\n              Evaluate real algorithm outcomes with zero typing. Instantly populates clinical factors and routes to results.\n            </p>\n          </div>\n\n          <div className=\"grid sm:grid-cols-3 gap-3.5 mt-4\">\n            {DEMO_PERSONAS.map(persona => {\n              const isUrgent = persona.id === \'urgent\';\n              const isMod = persona.id === \'moderate\';\n\n              return (\n                <button\n                  key={persona.id}\n                  onClick={() => handleLaunchDemo(persona.id)}\n                  className={`text-left p-4 rounded-xl border transition-all glass-panel-hover flex flex-col justify-between ${\n                    isUrgent\n                      ? \'border-rose-500/30 hover:border-rose-500/60 bg-rose-500/[0.04]\'\n                      : isMod\n                      ? \'border-amber-500/30 hover:border-amber-500/60 bg-amber-500/[0.04]\'\n                      : \'border-emerald-500/30 hover:border-emerald-500/60 bg-emerald-500/[0.04]\'\n                  }`}\n                >\n                  <div>\n                    <span className={`text-[10px] font-mono font-medium px-2 py-0.5 rounded-full inline-block mb-2 ${\n                      isUrgent\n                        ? \'bg-rose-500/20 text-rose-300\'\n                        : isMod\n                        ? \'bg-amber-500/20 text-amber-300\'\n                        : \'bg-emerald-500/20 text-emerald-300\'\n                    }`}>\n                      {persona.badge}\n                    </span>\n                    <h3 className=\"font-heading font-semibold text-xs text-[#EAF4F4]\">\n                      {persona.name}\n                    </h3>\n                    <p className=\"text-[11px] text-[#9FB4BA] mt-1.5 leading-relaxed\">\n                      {persona.description}\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-2 border-t border-white/5 flex items-center justify-between text-[11px] text-[#2DD4BF] font-medium\">\n                    <span>Inspect Pathway</span>\n                    <ChevronRight className=\"w-3.5 h-3.5\" />\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </section>\n\n      {/* Why Earlier Matters */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\">\n            {t.whyEarlierTitle}\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#9FB4BA] max-w-xl mx-auto\">\n            Addressing male factors early saves months of unnecessary stress and optimizes fertility outcomes.\n          </p>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 gap-4\">\n          <div className=\"p-6 rounded-2xl glass-panel glass-panel-hover space-y-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#2DD4BF]/10 text-[#2DD4BF] flex items-center justify-center border border-[#2DD4BF]/20\">\n              <Activity className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n              {t.whyModifiableTitle}\n            </h3>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              {t.whyModifiableDesc}\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl glass-panel glass-panel-hover space-y-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#E8D5B5]/10 text-[#E8D5B5] flex items-center justify-center border border-[#E8D5B5]/20\">\n              <Clock className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n              {t.whyEarlyBeatsLateTitle}\n            </h3>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              {t.whyEarlyBeatsLateDesc}\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl glass-panel glass-panel-hover space-y-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center border border-sky-500/20\">\n              <Lock className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n              {t.whyFromHomeTitle}\n            </h3>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              {t.whyFromHomeDesc}\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Built Around Trust & Dignity */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\">\n            {t.builtAroundTrustTitle}\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#9FB4BA] max-w-xl mx-auto\">\n            Conceived for the UAE and Middle Eastern cultural context with universal clinical rigour.\n          </p>\n        </div>\n\n        <div className=\"grid sm:grid-cols-2 md:grid-cols-4 gap-4\">\n          <div className=\"p-5 rounded-2xl glass-panel border border-white/5 space-y-2\">\n            <ShieldCheck className=\"w-6 h-6 text-[#2DD4BF]\" />\n            <h3 className=\"font-heading font-semibold text-xs text-[#EAF4F4]\">{t.trustPrivateTitle}</h3>\n            <p className=\"text-[11px] text-[#9FB4BA] leading-relaxed\">{t.trustPrivateDesc}</p>\n          </div>\n\n          <div className=\"p-5 rounded-2xl glass-panel border border-white/5 space-y-2\">\n            <HeartHandshake className=\"w-6 h-6 text-[#E8D5B5]\" />\n            <h3 className=\"font-heading font-semibold text-xs text-[#EAF4F4]\">{t.trustCulturalTitle}</h3>\n            <p className=\"text-[11px] text-[#9FB4BA] leading-relaxed\">{t.trustCulturalDesc}</p>\n          </div>\n\n          <div className=\"p-5 rounded-2xl glass-panel border border-white/5 space-y-2\">\n            <FileCheck className=\"w-6 h-6 text-sky-400\" />\n            <h3 className=\"font-heading font-semibold text-xs text-[#EAF4F4]\">{t.trustClinicalTitle}</h3>\n            <p className=\"text-[11px] text-[#9FB4BA] leading-relaxed\">{t.trustClinicalDesc}</p>\n          </div>\n\n          <div className=\"p-5 rounded-2xl glass-panel border border-white/5 space-y-2\">\n            <Stethoscope className=\"w-6 h-6 text-teal-400\" />\n            <h3 className=\"font-heading font-semibold text-xs text-[#EAF4F4]\">{t.trustHumanTitle}</h3>\n            <p className=\"text-[11px] text-[#9FB4BA] leading-relaxed\">{t.trustHumanDesc}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Bottom CTA */}\n      <section className=\"max-w-3xl mx-auto px-4 text-center\">\n        <div className=\"p-8 rounded-2xl glass-panel border border-[#2DD4BF]/20 space-y-4 bg-gradient-to-b from-[#132B38] to-[#0D1F29]\">\n          <h2 className=\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\">\n            Ready to explore your reproductive health in complete confidence?\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#9FB4BA] max-w-lg mx-auto\">\n            Take 4 minutes to gain clarity. You control what is stored, who sees it, and when to delete it.\n          </p>\n          <div className=\"pt-2\">\n            <Link\n              to=\"/consent\"\n              className=\"inline-flex items-center gap-2 px-8 py-3 rounded-xl font-heading font-semibold text-sm \n                         bg-[#2DD4BF] text-[#07131A] hover:bg-[#2DD4BF]/90 shadow-md transition-all\"\n            >\n              <span>{t.startCheck}</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </Link>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/LandingPage.tsx"
        }
        overwrite: true
      }
