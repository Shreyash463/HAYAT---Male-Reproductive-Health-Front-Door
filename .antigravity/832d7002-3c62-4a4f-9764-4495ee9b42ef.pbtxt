      original_chunk {
        target_content: "        {/* SVG Wave Progress Bar */}\n        <div\n          className=\"relative w-full h-5 flex items-center overflow-hidden\"\n          role=\"progressbar\"\n          aria-valuenow={safeIdx + 1}\n          aria-valuemin={1}\n          aria-valuemax={questions.length}\n          aria-label={`Question ${safeIdx + 1} of ${questions.length}`}\n        >\n          <svg viewBox=\"0 0 600 18\" preserveAspectRatio=\"none\" className=\"w-full h-4 overflow-visible\">\n            <defs>\n              <clipPath id=\"hayat-wave-clip\">\n                <rect\n                  x=\"0\"\n                  y=\"0\"\n                  width={Math.max(12, progressRatio * 600)}\n                  height=\"18\"\n                  style={{ transition: shouldReduceMotion ? \'none\' : \'width 0.35s ease-out\' }}\n                />\n              </clipPath>\n            </defs>\n            {/* Track wave */}\n            <path\n              d=\"M0 9 Q 25 3, 50 9 T 100 9 T 150 9 T 200 9 T 250 9 T 300 9 T 350 9 T 400 9 T 450 9 T 500 9 T 550 9 T 600 9\"\n              fill=\"none\"\n              stroke=\"var(--gauge-track)\"\n              strokeWidth=\"3\"\n              strokeLinecap=\"round\"\n            />\n            {/* Filled wave */}\n            <path\n              d=\"M0 9 Q 25 3, 50 9 T 100 9 T 150 9 T 200 9 T 250 9 T 300 9 T 350 9 T 400 9 T 450 9 T 500 9 T 550 9 T 600 9\"\n              fill=\"none\"\n              stroke=\"var(--accent)\"\n              strokeWidth=\"3.5\"\n              strokeLinecap=\"round\"\n              clipPath=\"url(#hayat-wave-clip)\"\n            />\n          </svg>\n        </div>\n      </div>\n\n      {/* Main Single-Question Paper Card */}\n      <AnimatePresence mode=\"wait\" initial={false}>\n        <motion.div\n          key={currentQ.id}\n          initial={shouldReduceMotion ? false : { opacity: 0, x: direction * 24 }}\n          animate={{ opacity: 1, x: 0 }}\n          exit={shouldReduceMotion ? { opacity: 0 } : { opacity: 0, x: direction * -24 }}\n          transition={shouldReduceMotion ? { duration: 0 } : { duration: 0.22, ease: \'easeOut\' }}\n          className=\"paper-card p-6 sm:p-10 space-y-6\"\n        >"
        replacement_content: "        {/* SVG Wave Progress Bar (mirrored cleanly in RTL) */}\n        <div\n          className=\"relative w-full h-5 flex items-center overflow-hidden\"\n          role=\"progressbar\"\n          aria-valuenow={safeIdx + 1}\n          aria-valuemin={1}\n          aria-valuemax={questions.length}\n          aria-label={`Question ${safeIdx + 1} of ${questions.length}`}\n        >\n          <svg\n            viewBox=\"0 0 600 18\"\n            preserveAspectRatio=\"none\"\n            className={`w-full h-4 overflow-visible ${isRtl ? \'-scale-x-100\' : \'\'}`}\n          >\n            <defs>\n              <clipPath id=\"hayat-wave-clip\">\n                <rect\n                  x=\"0\"\n                  y=\"0\"\n                  width={Math.max(12, progressRatio * 600)}\n                  height=\"18\"\n                  style={{\n                    transition: shouldReduceMotion\n                      ? \'none\'\n                      : \'width 0.38s cubic-bezier(0.22, 1, 0.36, 1)\',\n                  }}\n                />\n              </clipPath>\n            </defs>\n            {/* Track wave */}\n            <path\n              d=\"M0 9 Q 25 3, 50 9 T 100 9 T 150 9 T 200 9 T 250 9 T 300 9 T 350 9 T 400 9 T 450 9 T 500 9 T 550 9 T 600 9\"\n              fill=\"none\"\n              stroke=\"var(--gauge-track)\"\n              strokeWidth=\"3\"\n              strokeLinecap=\"round\"\n            />\n            {/* Filled wave */}\n            <path\n              d=\"M0 9 Q 25 3, 50 9 T 100 9 T 150 9 T 200 9 T 250 9 T 300 9 T 350 9 T 400 9 T 450 9 T 500 9 T 550 9 T 600 9\"\n              fill=\"none\"\n              stroke=\"var(--accent)\"\n              strokeWidth=\"3.5\"\n              strokeLinecap=\"round\"\n              clipPath=\"url(#hayat-wave-clip)\"\n            />\n          </svg>\n        </div>\n      </div>\n\n      {/* Main Single-Question Paper Card (mirrored slide direction in RTL) */}\n      <AnimatePresence mode=\"wait\" initial={false}>\n        <motion.div\n          key={currentQ.id}\n          initial={\n            shouldReduceMotion\n              ? false\n              : { opacity: 0, x: direction * (isRtl ? -26 : 26) }\n          }\n          animate={{ opacity: 1, x: 0 }}\n          exit={\n            shouldReduceMotion\n              ? { opacity: 0 }\n              : { opacity: 0, x: direction * (isRtl ? 26 : -26) }\n          }\n          transition={\n            shouldReduceMotion\n              ? { duration: 0 }\n              : { duration: 0.3, ease: [0.22, 1, 0.36, 1] }\n          }\n          className=\"paper-card p-6 sm:p-10 space-y-6\"\n        >"
