              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    val: `${answers.sleepHours !== undefined ? `${answers.sleepHours} hrs sleep` : \'Sleep not shared\'}, ${answers.stressLevel !== undefined ? `Stress level ${answers.stressLevel}/5` : \'Stress not shared\'}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
