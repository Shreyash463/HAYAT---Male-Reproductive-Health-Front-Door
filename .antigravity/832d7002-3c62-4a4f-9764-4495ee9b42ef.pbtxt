  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useMemo, useRef, useState } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { assess } from \'../services/api\';\nimport { assessRisk } from \'../engine/riskEngine\';\nimport { ShieldCheck, Heart, Sparkles, CheckCircle2, ArrowRight } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { EASE_CALM, usePrefersReducedMotion } from \'../motion\';\n\nexport const AnalysingPage: React.FC = () => {\n  const { answers, setResult, t, theme } = useApp();\n  const navigate = useNavigate();\n  const reduced = usePrefersReducedMotion();\n\n  const [activeMessageIndex, setActiveMessageIndex] = useState(0);\n  const [ringReady, setRingReady] = useState(false);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const cancelledRef = useRef(false);\n\n  const messages = useMemo(\n    () => [\n      { text: t.reassurance1, icon: ShieldCheck, color: \'var(--risk-mod)\' },\n      { text: t.reassurance2, icon: Heart, color: \'var(--accent-text)\' },\n      { text: t.reassurance3, icon: Sparkles, color: \'var(--brand)\' },\n    ],\n    [t]\n  );\n\n  // Total duration <= 2.35s, computing real assess() in parallel\n  useEffect(() => {\n    cancelledRef.current = false;\n\n    const msgTimer1 = window.setTimeout(() => setActiveMessageIndex(1), 720);\n    const msgTimer2 = window.setTimeout(() => setActiveMessageIndex(2), 1440);\n    const ringTimer = window.setTimeout(() => setRingReady(true), 1450);\n\n    const minDisplayMs = reduced ? 550 : 2150;\n    const startTime = performance.now();\n\n    assess(answers).then(computed => {\n      if (cancelledRef.current) return;\n      setResult(computed);\n      const remaining = Math.max(0, minDisplayMs - (performance.now() - startTime));\n      window.setTimeout(() => {\n        if (!cancelledRef.current) {\n          navigate(\'/results\');\n        }\n      }, remaining);\n    });\n\n    return () => {\n      cancelledRef.current = true;\n      window.clearTimeout(msgTimer1);\n      window.clearTimeout(msgTimer2);\n      window.clearTimeout(ringTimer);\n    };\n  }, [answers, navigate, reduced, setResult]);\n\n  // Scattered sand/teal dots converging smoothly into the ring gauge outline\n  useEffect(() => {\n    if (reduced) return;\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    const size = 160;\n    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);\n    canvas.width = size * dpr;\n    canvas.height = size * dpr;\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n    const cx = size / 2;\n    const cy = size / 2;\n    const radius = 56;\n    const dotCount = 48;\n\n    const dots = Array.from({ length: dotCount }, (_, i) => {\n      const targetAngle = (i / dotCount) * Math.PI * 2 - Math.PI / 2;\n      const scatterAngle = targetAngle + Math.sin(i * 3.1) * 1.1;\n      const scatterDist = 24 + ((i * 19) % 44);\n      return {\n        sx: cx + Math.cos(scatterAngle) * scatterDist,\n        sy: cy + Math.sin(scatterAngle) * scatterDist,\n        tx: cx + Math.cos(targetAngle) * radius,\n        ty: cy + Math.sin(targetAngle) * radius,\n        isTeal: i % 3 === 0,\n      };\n    });\n\n    let rafId = 0;\n    const start = performance.now();\n    const duration = 1650;\n\n    const render = (now: number) => {\n      const raw = Math.min(1, (now - start) / duration);\n      // Cubic ease out\n      const eased = 1 - Math.pow(1 - raw, 3);\n      ctx.clearRect(0, 0, size, size);\n\n      // Fading in continuous ring outline at end of convergence\n      if (raw > 0.6) {\n        const ringAlpha = ((raw - 0.6) / 0.4) * 0.75;\n        ctx.beginPath();\n        ctx.arc(cx, cy, radius, 0, Math.PI * 2);\n        ctx.strokeStyle =\n          theme === \'dark\'\n            ? `rgba(58, 180, 165, ${ringAlpha.toFixed(2)})`\n            : `rgba(31, 138, 125, ${ringAlpha.toFixed(2)})`;\n        ctx.lineWidth = 4;\n        ctx.stroke();\n      }\n\n      for (const d of dots) {\n        const x = d.sx + (d.tx - d.sx) * eased;\n        const y = d.sy + (d.ty - d.sy) * eased;\n        ctx.beginPath();\n        ctx.arc(x, y, 2.3 - eased * 0.6, 0, Math.PI * 2);\n        ctx.fillStyle = d.isTeal\n          ? theme === \'dark\'\n            ? \'#3AB4A5\'\n            : \'#1F8A7D\'\n          : theme === \'dark\'\n          ? \'#C4AEA5\'\n          : \'#7A645C\';\n        ctx.fill();\n      }\n\n      if (raw < 1) {\n        rafId = requestAnimationFrame(render);\n      }\n    };\n\n    rafId = requestAnimationFrame(render);\n    return () => cancelAnimationFrame(rafId);\n  }, [reduced, theme]);\n\n  const handleSkip = () => {\n    cancelledRef.current = true;\n    setResult(assessRisk(answers));\n    navigate(\'/results\');\n  };\n\n  const CurrentIcon = messages[activeMessageIndex].icon;\n\n  return (\n    <div className=\"min-h-[70vh] flex flex-col items-center justify-center px-4 text-center\">\n      <div className=\"max-w-md w-full p-8 sm:p-10 paper-card space-y-6 relative overflow-hidden\">\n        {/* Convergence Dot-to-Ring Visual */}\n        <div className=\"relative mx-auto w-40 h-40 flex items-center justify-center\">\n          {!reduced ? (\n            <canvas\n              ref={canvasRef}\n              className=\"w-40 h-40\"\n              style={{ width: 160, height: 160 }}\n              aria-hidden=\"true\"\n            />\n          ) : (\n            <div className=\"w-28 h-28 rounded-full border-4 border-[var(--accent)] opacity-75\" />\n          )}\n\n          <motion.div\n            animate={{ scale: ringReady ? 1 : 0.94 }}\n            transition={reduced ? { duration: 0 } : { duration: 0.4, ease: EASE_CALM }}\n            className=\"absolute w-16 h-16 rounded-full bg-[var(--surface)] border border-[var(--border-strong)] flex items-center justify-center shadow-xs\"\n          >\n            <CurrentIcon\n              className=\"w-7 h-7 transition-colors duration-300\"\n              style={{ color: messages[activeMessageIndex].color }}\n            />\n          </motion.div>\n        </div>\n\n        <div className=\"space-y-1.5\">\n          <h1 className=\"text-xl font-bold font-heading text-[var(--text-main)]\">\n            {t.analysingTitle}\n          </h1>\n          <p className=\"text-sm sm:text-base text-[var(--text-muted)]\">\n            Applying transparent clinical rules locally on your device.\n          </p>\n        </div>\n\n        <div className=\"min-h-[48px] flex items-center justify-center\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeMessageIndex}\n              initial={reduced ? false : { opacity: 0, y: 8 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={reduced ? { opacity: 0 } : { opacity: 0, y: -8 }}\n              transition={reduced ? { duration: 0 } : { duration: 0.25, ease: EASE_CALM }}\n              className=\"flex items-center gap-2 text-sm sm:text-base font-medium text-[var(--text-main)]\"\n            >\n              <CheckCircle2 className=\"w-4 h-4 text-[var(--accent-text)] shrink-0\" />\n              <span>{messages[activeMessageIndex].text}</span>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        <div className=\"flex items-center justify-between pt-2 border-t border-[var(--border-hairline)]\">\n          <div className=\"flex gap-2\">\n            {messages.map((_, i) => (\n              <div\n                key={i}\n                className={`h-2 rounded-full transition-all duration-300 ${\n                  i === activeMessageIndex ? \'w-7 bg-[var(--accent)]\' : \'w-2 bg-[var(--gauge-track)]\'\n                }`}\n              />\n            ))}\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={handleSkip}\n            className=\"min-h-[40px] px-3.5 rounded-xl text-sm font-semibold text-[var(--accent-text)] hover:bg-[var(--accent-soft)] inline-flex items-center gap-1 transition-colors cursor-pointer\"\n          >\n            <span>Skip</span>\n            <ArrowRight className=\"w-3.5 h-3.5 rtl:rotate-180\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
