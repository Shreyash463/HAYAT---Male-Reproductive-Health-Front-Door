  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { DEMO_PERSONAS } from \'../data/personas\';\nimport { assessRisk } from \'../engine/riskEngine\';\nimport { HeroWaveWrapper } from \'../components/HeroWaveWrapper\';\nimport {\n  ShieldCheck,\n  ArrowRight,\n  Lock,\n  Sparkles,\n  Clock,\n  HeartHandshake,\n  Activity,\n  FileCheck,\n  ChevronRight,\n  HelpCircle,\n  Stethoscope,\n  AlertTriangle,\n  Info,\n} from \'lucide-react\';\n\nexport const LandingPage: React.FC = () => {\n  const { t, language, setAllAnswers, setResult, updateConsent } = useApp();\n  const navigate = useNavigate();\n\n  const handleLaunchDemo = (personaId: \'low\' | \'moderate\' | \'urgent\') => {\n    const persona = DEMO_PERSONAS.find(p => p.id === personaId);\n    if (!persona) return;\n\n    updateConsent({ processAnswers: true, createClinicianSummary: true });\n    setAllAnswers(persona.answers);\n    const computedResult = assessRisk(persona.answers);\n    setResult(computedResult);\n    navigate(\'/results\');\n  };\n\n  const renderHeroHeadline = () => {\n    if (language === \'en\') {\n      return (\n        <>\n          A{\' \'}\n          <span className=\"font-serif-accent italic font-normal text-[var(--brand)]\">\n            private first step\n          </span>{\' \'}\n          for men&apos;s reproductive health.\n        </>\n      );\n    }\n    return t.heroTitle;\n  };\n\n  return (\n    <div className=\"space-y-16 sm:space-y-20 pb-20\">\n      {/* Full-Width Hero with WebGL / Static Dotted Wave */}\n      <section className=\"relative w-full min-h-[540px] sm:min-h-[600px] flex items-center justify-center py-16 sm:py-24 px-4 overflow-hidden\">\n        <HeroWaveWrapper />\n\n        <div className=\"relative z-10 max-w-4xl mx-auto text-center space-y-6\">\n          {/* Trust pills */}\n          <div className=\"inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-4 py-2 rounded-full bg-[var(--card)]/90 border border-[var(--border-hairline)] shadow-xs text-xs sm:text-sm text-[var(--text-muted)]\">\n            <span className=\"flex items-center gap-1.5 font-medium text-[var(--accent-text)]\">\n              <Lock className=\"w-3.5 h-3.5 shrink-0\" />\n              <span>{t.trustNoAccount}</span>\n            </span>\n            <span className=\"text-[var(--border-strong)]\" aria-hidden=\"true\">\342\200\242</span>\n            <span className=\"flex items-center gap-1.5 font-medium text-[var(--text-main)]\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-[var(--brand)] shrink-0\" />\n              <span>{t.trustDataControl}</span>\n            </span>\n            <span className=\"text-[var(--border-strong)]\" aria-hidden=\"true\">\342\200\242</span>\n            <span className=\"flex items-center gap-1.5 font-medium text-[var(--accent-text)]\">\n              <Sparkles className=\"w-3.5 h-3.5 shrink-0\" />\n              <span>{t.trustExplainable}</span>\n            </span>\n          </div>\n\n          <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[var(--text-main)] font-heading leading-[1.12] max-w-3xl mx-auto\">\n            {renderHeroHeadline()}\n          </h1>\n\n          <p className=\"text-base sm:text-xl text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed\">\n            {t.heroSub}\n          </p>\n\n          <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5\">\n            <Link\n              to=\"/consent\"\n              className=\"w-full sm:w-auto px-8 min-h-[52px] rounded-2xl font-heading font-semibold text-base\n                         bg-[var(--accent)] text-white shadow-sm hover:opacity-95\n                         transition-all flex items-center justify-center gap-2 group\"\n            >\n              <span>{t.startCheck}</span>\n              <ArrowRight className=\"w-4 h-4 group-hover:translate-x-0.5 rtl:rotate-180 transition-transform\" />\n            </Link>\n\n            <Link\n              to=\"/how-it-works\"\n              className=\"w-full sm:w-auto px-6 min-h-[52px] rounded-2xl font-heading font-medium text-base\n                         bg-[var(--card)] text-[var(--text-main)] border border-[var(--border-strong)]\n                         hover:bg-[var(--surface)] transition-colors flex items-center justify-center gap-2\"\n            >\n              <HelpCircle className=\"w-4 h-4 text-[var(--brand)]\" />\n              <span>{t.howItWorks}</span>\n            </Link>\n          </div>\n        </div>\n      </section>\n\n      {/* Demo Personas Row */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"paper-card p-6 sm:p-8 space-y-5\">\n          <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pb-4 border-b border-[var(--border-hairline)]\">\n            <div>\n              <span className=\"text-xs uppercase font-mono tracking-wider text-[var(--accent-text)] font-semibold\">\n                Instant Walkthrough\n              </span>\n              <h2 className=\"text-lg sm:text-xl font-heading font-bold text-[var(--text-main)] mt-0.5\">\n                {t.tryDemoCase}\n              </h2>\n            </div>\n            <p className=\"text-sm text-[var(--text-muted)] max-w-md\">\n              Explore live rule-based screening outcomes with zero typing. Pre-fills sample inputs and opens the explainable results story.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-4\">\n            {DEMO_PERSONAS.map(persona => {\n              const isUrgent = persona.id === \'urgent\';\n              const isMod = persona.id === \'moderate\';\n              const tone = isUrgent\n                ? { color: \'var(--risk-urg)\', bg: \'var(--risk-urg-bg)\', border: \'var(--risk-urg-border)\', Icon: AlertTriangle }\n                : isMod\n                ? { color: \'var(--risk-mod)\', bg: \'var(--risk-mod-bg)\', border: \'var(--risk-mod-border)\', Icon: Info }\n                : { color: \'var(--risk-low)\', bg: \'var(--risk-low-bg)\', border: \'var(--risk-low-border)\', Icon: ShieldCheck };\n              const ToneIcon = tone.Icon;\n\n              return (\n                <button\n                  key={persona.id}\n                  type=\"button\"\n                  onClick={() => handleLaunchDemo(persona.id)}\n                  className=\"text-start p-5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--surface)] hover:border-[var(--border-strong)] hover:bg-[var(--card-alt)] transition-all flex flex-col justify-between cursor-pointer min-h-[170px]\"\n                >\n                  <div>\n                    <span\n                      className=\"text-xs font-semibold px-2.5 py-1 rounded-full inline-flex items-center gap-1.5 mb-3 border\"\n                      style={{ color: tone.color, backgroundColor: tone.bg, borderColor: tone.border }}\n                    >\n                      <ToneIcon className=\"w-3.5 h-3.5\" />\n                      <span>{persona.badge}</span>\n                    </span>\n                    <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">\n                      {persona.name}\n                    </h3>\n                    <p className=\"text-sm text-[var(--text-muted)] mt-1.5 leading-relaxed\">\n                      {persona.description}\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-[var(--border-hairline)] flex items-center justify-between text-sm text-[var(--accent-text)] font-semibold\">\n                    <span>Inspect Pathway</span>\n                    <ChevronRight className=\"w-4 h-4 rtl:rotate-180\" />\n                  </div>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </section>\n\n      {/* Why Earlier Matters */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            {t.whyEarlierTitle}\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-xl mx-auto\">\n            Checking male factors early helps reduce prolonged uncertainty and supports timely everyday improvements.\n          </p>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 gap-5\">\n          <div className=\"paper-card paper-card-hover p-6 sm:p-7 space-y-3\">\n            <div className=\"w-11 h-11 rounded-2xl bg-[var(--accent-soft)] text-[var(--accent-text)] flex items-center justify-center border border-[var(--border-hairline)]\">\n              <Activity className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-bold text-lg text-[var(--text-main)]\">\n              {t.whyModifiableTitle}\n            </h3>\n            <p className=\"text-base text-[var(--text-muted)] leading-relaxed\">\n              {t.whyModifiableDesc}\n            </p>\n          </div>\n\n          <div className=\"paper-card paper-card-hover p-6 sm:p-7 space-y-3\">\n            <div className=\"w-11 h-11 rounded-2xl bg-[var(--brand-soft)] text-[var(--brand)] flex items-center justify-center border border-[var(--border-hairline)]\">\n              <Clock className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-bold text-lg text-[var(--text-main)]\">\n              {t.whyEarlyBeatsLateTitle}\n            </h3>\n            <p className=\"text-base text-[var(--text-muted)] leading-relaxed\">\n              {t.whyEarlyBeatsLateDesc}\n            </p>\n          </div>\n\n          <div className=\"paper-card paper-card-hover p-6 sm:p-7 space-y-3\">\n            <div className=\"w-11 h-11 rounded-2xl bg-[var(--accent-soft)] text-[var(--accent-text)] flex items-center justify-center border border-[var(--border-hairline)]\">\n              <Lock className=\"w-5 h-5\" />\n            </div>\n            <h3 className=\"font-heading font-bold text-lg text-[var(--text-main)]\">\n              {t.whyFromHomeTitle}\n            </h3>\n            <p className=\"text-base text-[var(--text-muted)] leading-relaxed\">\n              {t.whyFromHomeDesc}\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Built Around Trust & Dignity */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            {t.builtAroundTrustTitle}\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-xl mx-auto\">\n            Conceived for the UAE and Middle Eastern context with calm, respectful design.\n          </p>\n        </div>\n\n        <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          <div className=\"paper-card p-6 space-y-2.5\">\n            <ShieldCheck className=\"w-6 h-6 text-[var(--accent-text)]\" />\n            <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">{t.trustPrivateTitle}</h3>\n            <p className=\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">{t.trustPrivateDesc}</p>\n          </div>\n\n          <div className=\"paper-card p-6 space-y-2.5\">\n            <HeartHandshake className=\"w-6 h-6 text-[var(--brand)]\" />\n            <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">{t.trustCulturalTitle}</h3>\n            <p className=\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">{t.trustCulturalDesc}</p>\n          </div>\n\n          <div className=\"paper-card p-6 space-y-2.5\">\n            <FileCheck className=\"w-6 h-6 text-[var(--accent-text)]\" />\n            <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">{t.trustClinicalTitle}</h3>\n            <p className=\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">{t.trustClinicalDesc}</p>\n          </div>\n\n          <div className=\"paper-card p-6 space-y-2.5\">\n            <Stethoscope className=\"w-6 h-6 text-[var(--brand)]\" />\n            <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">{t.trustHumanTitle}</h3>\n            <p className=\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">{t.trustHumanDesc}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* Bottom CTA */}\n      <section className=\"max-w-3xl mx-auto px-4 text-center\">\n        <div className=\"paper-card p-8 sm:p-10 space-y-4\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            Ready to explore your reproductive health in complete confidence?\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-lg mx-auto leading-relaxed\">\n            Take 4 minutes to gain clarity. You control what is stored, who sees it, and when to delete it.\n          </p>\n          <div className=\"pt-2\">\n            <Link\n              to=\"/consent\"\n              className=\"inline-flex items-center justify-center gap-2 px-8 min-h-[52px] rounded-2xl font-heading font-semibold text-base\n                         bg-[var(--accent)] text-white hover:opacity-95 shadow-sm transition-opacity\"\n            >\n              <span>{t.startCheck}</span>\n              <ArrowRight className=\"w-4 h-4 rtl:rotate-180\" />\n            </Link>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/LandingPage.tsx"
        }
        overwrite: true
      }
    }
