  view_file {
    absolute_path_uri: "file:///src/engine/riskEngine.ts"
    end_line: 641
    content: "import { AssessmentAnswers, AssessmentResult, RiskBand, TriageLevel, RiskFactor } from \'../types\';\n\n/**\n * HAYAT Transparent Risk Screening Engine\n * Rule-based, fully explainable, clinically bounded.\n * Strictly a screening aid; never an automated diagnosis.\n */\n\nexport function calculateBmi(heightCm?: number, weightKg?: number): number | undefined {\n  if (!heightCm || !weightKg || heightCm < 50 || weightKg < 20) return undefined;\n  const heightM = heightCm / 100;\n  return Number((weightKg / (heightM * heightM)).toFixed(1));\n}\n\nexport function assessRisk(answers: AssessmentAnswers): AssessmentResult {\n  const redFlags: string[] = [];\n  const factors: RiskFactor[] = [];\n  const favourableFactors: RiskFactor[] = [];\n  const actions: string[] = [];\n  const doctorQuestions: string[] = [];\n\n  // 1. RED FLAGS: Checked FIRST and override everything\n  const redFlagList = answers.redFlagSymptoms || [];\n  if (redFlagList.includes(\'severe_pain\')) {\n    redFlags.push(\'Sudden severe testicular pain (requires immediate rule-out of testicular torsion)\');\n  }\n  if (redFlagList.includes(\'rapid_swelling\')) {\n    redFlags.push(\'Rapid swelling of the scrotum or testicle\');\n  }\n  if (redFlagList.includes(\'fever_pain\')) {\n    redFlags.push(\'Fever combined with acute scrotal or testicular tenderness\');\n  }\n  if (redFlagList.includes(\'blood_in_semen\')) {\n    redFlags.push(\'Visible blood in semen (hematospermia)\');\n  }\n  if (redFlagList.includes(\'hard_painless_lump\')) {\n    redFlags.push(\'A firm or hard non-tender testicular lump (requires prompt clinical exam & ultrasound)\');\n  }\n\n  let totalRiskScore = 0;\n\n  // 2. Journey & Trying Duration\n  if (answers.familyPlanning === \'trying\') {\n    if (answers.tryingDuration === \'over_12\') {\n      totalRiskScore += 24;\n      factors.push({\n        id: \'trying_12m\',\n        label: \'Trying to conceive for 12+ months\',\n        direction: \'raises\',\n        weight: 24,\n        modifiable: false,\n        userValue: \'Over 12 months\',\n        explanation: \'Clinical guidelines recommend formal concurrent evaluation for both partners when conception has not occurred after 12 months of regular unprotected intercourse.\'\n      });\n      doctorQuestions.push(\'What initial diagnostic timeline do you recommend for both of us?\');\n    } else if (answers.tryingDuration === \'6_12\') {\n      totalRiskScore += 14;\n      factors.push({\n        id: \'trying_6_12m\',\n        label: \'Trying to conceive for 6 to 12 months\',\n        direction: \'raises\',\n        weight: 14,\n        modifiable: false,\n        userValue: \'6 - 12 months\',\n        explanation: \'Approaching the standard 1-year clinical evaluation window; proactive metabolic and lifestyle optimisation is strongly beneficial at this stage.\'\n      });\n    } else if (answers.tryingDuration === \'under_3\' || answers.tryingDuration === \'3_6\') {\n      favourableFactors.push({\n        id: \'trying_early\',\n        label: \'Early in family planning journey\',\n        direction: \'lowers\',\n        weight: -8,\n        modifiable: false,\n        userValue: answers.tryingDuration === \'under_3\' ? \'Under 3 months\' : \'3 - 6 months\',\n        explanation: \'Most healthy couples achieve pregnancy within 12 months. Early awareness gives you ample time for natural optimisation.\'\n      });\n    }\n  }\n\n  // 3. Age Factors\n  if (answers.ageRange === \'45+\') {\n    totalRiskScore += 12;\n    factors.push({\n      id: \'age_45\',\n      label: \'Age 45 or older\',\n      direction: \'raises\',\n      weight: 12,\n      modifiable: false,\n      userValue: \'45+\',\n      explanation: \'Paternal age above 45 can be associated with gradual changes in semen volume, motility, and DNA fragmentation.\'\n    });\n  } else if (answers.ageRange === \'40-44\') {\n    totalRiskScore += 8;\n    factors.push({\n      id: \'age_40_44\',\n      label: \'Age between 40 and 44\',\n      direction: \'raises\',\n      weight: 8,\n      modifiable: false,\n      userValue: \'40-44\',\n      explanation: \'Mild biological shift in metabolic and reproductive markers; general health and micronutrient status are helpful to assess.\'\n    });\n  } else if (answers.ageRange === \'18-24\' || answers.ageRange === \'25-29\' || answers.ageRange === \'30-34\') {\n    favourableFactors.push({\n      id: \'age_protective\',\n      label: \'Younger age bracket\',\n      direction: \'lowers\',\n      weight: -5,\n      modifiable: false,\n      userValue: answers.ageRange,\n      explanation: \'Biological age profile typically shows peak spermatogenesis potential.\'\n    });\n  }\n\n  // 4. Daily Life & Lifestyle\n  // Smoking\n  if (answers.smoking === \'daily\') {\n    totalRiskScore += 16;\n    factors.push({\n      id: \'smoking_daily\',\n      label: \'Daily cigarette / vaping use\',\n      direction: \'raises\',\n      weight: 16,\n      modifiable: true,\n      userValue: \'Daily\',\n      explanation: \'Tobacco and high-dose nicotine generate oxidative stress in seminal plasma and can impair sperm density, motility, and DNA integrity.\'\n    });\n    actions.push(\'Reducing or discontinuing nicotine can noticeably improve sperm quality in the 72-90 day spermatogenesis cycle.\');\n    doctorQuestions.push(\'Could smoking cessation support or antioxidant therapy benefit my reproductive markers?\');\n  } else if (answers.smoking === \'occasional\') {\n    totalRiskScore += 8;\n    factors.push({\n      id: \'smoking_occasional\',\n      label: \'Occasional smoking / vaping\',\n      direction: \'raises\',\n      weight: 8,\n      modifiable: true,\n      userValue: \'Occasional\',\n      explanation: \'Even intermittent exposure increases reactive oxygen species in testicular tissues.\'\n    });\n    actions.push(\'Aim for zero nicotine exposure during active conception cycles.\');\n  } else if (answers.smoking === \'never\') {\n    favourableFactors.push({\n      id: \'non_smoker\',\n      label: \'Non-smoker\',\n      direction: \'lowers\',\n      weight: -8,\n      modifiable: true,\n      userValue: \'Never\',\n      explanation: \'Avoids significant oxidative stress and heavy metal toxicities known to affect semen parameters.\'\n    });\n  }\n\n  // Alcohol\n  if (answers.alcohol === \'heavy\') {\n    totalRiskScore += 15;\n    factors.push({\n      id: \'alcohol_heavy\',\n      label: \'Heavy alcohol consumption\',\n      direction: \'raises\',\n      weight: 15,\n      modifiable: true,\n      userValue: \'Heavy\',\n      explanation: \'Excessive alcohol can suppress gonadotropin secretion (LH/FSH), lower testosterone synthesis, and disrupt liver metabolism of estrogen.\'\n    });\n    actions.push(\'Moderate or pause alcohol intake; studies show substantial rebound in sperm counts within 10 weeks of reduction.\');\n  } else if (answers.alcohol === \'moderate\') {\n    totalRiskScore += 6;\n    factors.push({\n      id: \'alcohol_moderate\',\n      label: \'Moderate alcohol consumption\',\n      direction: \'raises\',\n      weight: 6,\n      modifiable: true,\n      userValue: \'Moderate\',\n      explanation: \'Regular moderate alcohol intake may mildly contribute to inflammatory markers and sleep architecture disruption.\'\n    });\n  } else if (answers.alcohol === \'none\') {\n    favourableFactors.push({\n      id: \'alcohol_none\',\n      label: \'Zero alcohol consumption\',\n      direction: \'lowers\',\n      weight: -5,\n      modifiable: true,\n      userValue: \'None\',\n      explanation: \'Optimal support for liver hormone clearance and Leydig cell testosterone production.\'\n    });\n  }\n\n  // Sleep & Stress\n  if (answers.sleepHours !== undefined) {\n    if (answers.sleepHours < 6) {\n      totalRiskScore += 8;\n      factors.push({\n        id: \'sleep_short\',\n        label: \'Short sleep duration (<6 hours)\',\n        direction: \'raises\',\n        weight: 8,\n        modifiable: true,\n        userValue: `${answers.sleepHours} hours / night`,\n        explanation: \'Peak testosterone synthesis occurs during undisturbed slow-wave and REM sleep. Chronic short sleep suppresses endocrine balance.\'\n      });\n      actions.push(\'Prioritise 7-8 hours of sleep per night to restore nocturnal LH and testosterone peaks.\');\n    } else if (answers.sleepHours >= 7 && answers.sleepHours <= 9) {\n      favourableFactors.push({\n        id: \'sleep_optimal\',\n        label: \'Optimal sleep duration\',\n        direction: \'lowers\',\n        weight: -6,\n        modifiable: true,\n        userValue: `${answers.sleepHours} hours / night`,\n        explanation: \'Consistent 7-9 hours sleep supports physiological endocrine rhythms.\'\n      });\n    }\n  }\n\n  if (answers.stressLevel !== undefined && answers.stressLevel >= 4) {\n    totalRiskScore += 7;\n    factors.push({\n      id: \'stress_high\',\n      label: \'High psychological or work stress\',\n      direction: \'raises\',\n      weight: 7,\n      modifiable: true,\n      userValue: `${answers.stressLevel}/5`,\n      explanation: \'Elevated cortisol and sympathetic drive can down-regulate the hypothalamic-pituitary-gonadal (HPG) axis.\'\n    });\n    actions.push(\'Incorporate daily nervous system down-regulation (e.g. 15 minutes walking, breathwork, or deliberate rest).\');\n  }\n\n  // Exercise\n  if (answers.exerciseDays !== undefined) {\n    if (answers.exerciseDays >= 3) {\n      favourableFactors.push({\n        id: \'exercise_regular\',\n        label: \'Regular physical activity (3+ days/week)\',\n        direction: \'lowers\',\n        weight: -8,\n        modifiable: true,\n        userValue: `${answers.exerciseDays} days/week`,\n        explanation: \'Improves insulin sensitivity, pelvic microcirculation, and systemic antioxidant reserves.\'\n      });\n    } else if (answers.exerciseDays === 0) {\n      totalRiskScore += 6;\n      factors.push({\n        id: \'exercise_sedentary\',\n        label: \'Sedentary routine\',\n        direction: \'raises\',\n        weight: 6,\n        modifiable: true,\n        userValue: \'0 days/week\',\n        explanation: \'Prolonged sitting elevates scrotal temperature and decreases metabolic clearance.\'\n      });\n      actions.push(\'Begin with 20 minutes of brisk walking 3-4 days a week to stimulate blood flow.\');\n    }\n  }\n\n  // Heat Exposure\n  const heatList = answers.heatExposure || [];\n  const activeHeat = heatList.filter(h => h !== \'none\');\n  if (activeHeat.length > 0) {\n    const pts = activeHeat.length * 6;\n    totalRiskScore += pts;\n    factors.push({\n      id: \'heat_exposure\',\n      label: \'Frequent scrotal heat exposure\',\n      direction: \'raises\',\n      weight: pts,\n      modifiable: true,\n      userValue: activeHeat.map(h => h.replace(\'_\', \' \')).join(\', \'),\n      explanation: \'The testicles need to remain 2\302\260C to 4\302\260C cooler than core body temperature for healthy spermatogenesis. Frequent heat suppresses sperm formation.\'\n    });\n    actions.push(\'Avoid prolonged hot tubs/saunas and avoid resting laptops directly on the lap for the next 3 months.\');\n  }\n\n  // Anabolic Steroids / Testosterone\n  if (answers.supplementsSteroids === \'current\') {\n    totalRiskScore += 35;\n    factors.push({\n      id: \'steroids_current\',\n      label: \'Current testosterone or anabolic compound use\',\n      direction: \'raises\',\n      weight: 35,\n      modifiable: true,\n      userValue: \'Current\',\n      explanation: \'Exogenous testosterone and anabolics trigger negative feedback that shuts down pituitary LH and FSH production, frequently leading to severe oligospermia or azoospermia (zero sperm).\'\n    });\n    actions.push(\'Discuss a medically supervised cessation and endocrine recovery protocol with an andrologist or endocrinologist.\');\n    doctorQuestions.push(\'What is the safest protocol to restore my endogenous LH and FSH production?\');\n  } else if (answers.supplementsSteroids === \'past\') {\n    totalRiskScore += 12;\n    factors.push({\n      id: \'steroids_past\',\n      label: \'Past testosterone or anabolic use\',\n      direction: \'raises\',\n      weight: 12,\n      modifiable: false,\n      userValue: \'Past\',\n      explanation: \'HPG axis recovery can take several months or years depending on past cycle length and compounds used.\'\n    });\n    doctorQuestions.push(\'Can we check my LH, FSH, and total testosterone levels to confirm axis recovery?\');\n  }\n\n  // Recreational Substances\n  if (answers.recreationalSubstances === \'regular\') {\n    totalRiskScore += 15;\n    factors.push({\n      id: \'substances_regular\',\n      label: \'Regular substance use\',\n      direction: \'raises\',\n      weight: 15,\n      modifiable: true,\n      userValue: \'Regular\',\n      explanation: \'Certain recreational compounds (including heavy cannabis and stimulants) can interfere with cannabinoid/dopamine receptors in reproductive organs.\'\n    });\n    actions.push(\'Taper and discontinue substance use to protect sperm membrane integrity.\');\n  } else if (answers.recreationalSubstances === \'occasional\') {\n    totalRiskScore += 7;\n    factors.push({\n      id: \'substances_occasional\',\n      label: \'Occasional substance use\',\n      direction: \'raises\',\n      weight: 7,\n      modifiable: true,\n      userValue: \'Occasional\',\n      explanation: \'Mild impact on seminal biochemical environment.\'\n    });\n  }\n\n  // 5. Body & Metabolic\n  const bmi = calculateBmi(answers.heightCm, answers.weightKg);\n  if (bmi !== undefined) {\n    if (bmi >= 30) {\n      totalRiskScore += 16;\n      factors.push({\n        id: \'bmi_obesity\',\n        label: \'Elevated BMI (30+)\',\n        direction: \'raises\',\n        weight: 16,\n        modifiable: true,\n        userValue: `BMI ${bmi}`,\n        explanation: \'Adipose tissue contains the aromatase enzyme, which converts testosterone into estrogen. This can shift hormonal ratios and increase scrotal insulation.\'\n      });\n      actions.push(\'Gradual 5-10% weight loss significantly improves hormonal parameters and sperm concentration.\');\n      doctorQuestions.push(\'Would a metabolic screening (Hba1c, lipid panel) help identify root causes?\');\n    } else if (bmi >= 25 && bmi < 30) {\n      totalRiskScore += 7;\n      factors.push({\n        id: \'bmi_overweight\',\n        label: \'Slightly elevated BMI (25 - 29.9)\',\n        direction: \'raises\',\n        weight: 7,\n        modifiable: true,\n        userValue: `BMI ${bmi}`,\n        explanation: \'Mild metabolic load that can be easily supported with dietary and exercise adjustments.\'\n      });\n    } else if (bmi >= 18.5 && bmi < 25) {\n      favourableFactors.push({\n        id: \'bmi_normal\',\n        label: \'Healthy BMI range (18.5 - 24.9)\',\n        direction: \'lowers\',\n        weight: -7,\n        modifiable: true,\n        userValue: `BMI ${bmi}`,\n        explanation: \'Balances aromatase activity and maintains normal core-to-scrotal temperature gradient.\'\n      });\n    }\n  }\n\n  // Conditions\n  const conditions = answers.conditions || [];\n  if (conditions.includes(\'diabetes\')) {\n    totalRiskScore += 14;\n    factors.push({\n      id: \'condition_diabetes\',\n      label: \'Diabetes or elevated blood glucose\',\n      direction: \'raises\',\n      weight: 14,\n      modifiable: true,\n      userValue: \'Reported\',\n      explanation: \'Hyperglycemia contributes to sperm DNA fragmentation, advanced glycation end-products, and can occasionally cause retrograde ejaculation.\'\n    });\n    actions.push(\'Work closely with your primary doctor on glycemic control (HbA1c target).\');\n  }\n  if (conditions.includes(\'hypertension\')) {\n    totalRiskScore += 8;\n    factors.push({\n      id: \'condition_hypertension\',\n      label: \'High blood pressure\',\n      direction: \'raises\',\n      weight: 8,\n      modifiable: true,\n      userValue: \'Reported\',\n      explanation: \'Certain antihypertensive medications or microvascular stress can impact testicular perfusion.\'\n    });\n  }\n  if (conditions.includes(\'thyroid\')) {\n    totalRiskScore += 9;\n    factors.push({\n      id: \'condition_thyroid\',\n      label: \'Thyroid dysfunction\',\n      direction: \'raises\',\n      weight: 9,\n      modifiable: true,\n      userValue: \'Reported\',\n      explanation: \'Thyroid hormones directly modulate Sertoli and Leydig cell function and sex hormone-binding globulin (SHBG).\'\n    });\n  }\n\n  // 6. Medical History & Current Symptoms\n  if (answers.undescendedTesticle === \'yes\') {\n    totalRiskScore += 16;\n    factors.push({\n      id: \'history_cryptorchidism\',\n      label: \'History of undescended testicle (cryptorchidism)\',\n      direction: \'raises\',\n      weight: 16,\n      modifiable: false,\n      userValue: \'Yes in childhood\',\n      explanation: \'Even when surgically corrected in early childhood, germ cell maturation can be subtly altered, making a semen analysis valuable.\'\n    });\n    doctorQuestions.push(\'Could my childhood history have any ongoing bearing on my semen analysis?\');\n  }\n  if (answers.pastInfection === \'yes\') {\n    totalRiskScore += 12;\n    factors.push({\n      id: \'history_infection\',\n      label: \'History of genital/urinary tract infection or prostatitis\',\n      direction: \'raises\',\n      weight: 12,\n      modifiable: false,\n      userValue: \'Yes\',\n      explanation: \'Past infections can leave subclinical chronic inflammation or partial obstruction in the epididymis or vas deferens.\'\n    });\n    doctorQuestions.push(\'Would you recommend a semen culture or leukocyte assessment to rule out residual inflammation?\');\n  }\n  if (answers.pastMumps === \'yes\') {\n    totalRiskScore += 10;\n    factors.push({\n      id: \'history_mumps\',\n      label: \'History of mumps (especially around or post-puberty)\',\n      direction: \'raises\',\n      weight: 10,\n      modifiable: false,\n      userValue: \'Yes\',\n      explanation: \'Mumps orchitis can sometimes cause testicular atrophy or diminished seminiferous tubule density.\'\n    });\n  }\n  if (answers.pastSurgeryInjury === \'yes\') {\n    totalRiskScore += 8;\n    factors.push({\n      id: \'history_surgery_injury\',\n      label: \'Past hernia/scrotal surgery or trauma\',\n      direction: \'raises\',\n      weight: 8,\n      modifiable: false,\n      userValue: \'Yes\',\n      explanation: \'Inguinal or testicular surgeries can occasionally affect vascular supply or ductal patency.\'\n    });\n  }\n\n  // Symptoms\n  const symptoms = answers.currentSymptoms || [];\n  if (symptoms.includes(\'heaviness_veins\')) {\n    totalRiskScore += 16;\n    factors.push({\n      id: \'symptom_varicocele\',\n      label: \'Feeling of heaviness or swollen veins (possible varicocele sign)\',\n      direction: \'raises\',\n      weight: 16,\n      modifiable: true,\n      userValue: \'Heaviness / vein fullness\',\n      explanation: \'A varicocele (dilated scrotal veins) is found in up to 40% of men with fertility challenges. It is the most common correctable cause of male subfertility.\'\n    });\n    actions.push(\'Schedule a simple physical examination and scrotal Doppler ultrasound with a urologist.\');\n    doctorQuestions.push(\'Could my symptoms indicate a clinical varicocele, and would an ultrasound help confirm?\');\n  }\n  if (symptoms.includes(\'dull_ache\')) {\n    totalRiskScore += 8;\n    factors.push({\n      id: \'symptom_ache\',\n      label: \'Dull ache or discomfort\',\n      direction: \'raises\',\n      weight: 8,\n      modifiable: true,\n      userValue: \'Dull ache\',\n      explanation: \'Mild chronic ache can be linked to congestion, epididymitis, or structural factors.\'\n    });\n  }\n  if (symptoms.includes(\'low_libido\') || symptoms.includes(\'erection_difficulty\')) {\n    totalRiskScore += 10;\n    factors.push({\n      id: \'symptom_sexual\',\n      label: \'Changes in libido or erection firmness\',\n      direction: \'raises\',\n      weight: 10,\n      modifiable: true,\n      userValue: \'Reported\',\n      explanation: \'Often correlates with androgen status, sleep deficits, cardiovascular vascular health, or metabolic stress.\'\n    });\n    actions.push(\'Request morning total testosterone and free androgen index testing from your doctor.\');\n  }\n\n  // 7. Optional Semen Analysis (WHO 2021 Reference Limits)\n  if (answers.hasSemenAnalysis) {\n    if (answers.semenVolume !== undefined && answers.semenVolume < 1.4) {\n      totalRiskScore += 14;\n      factors.push({\n        id: \'semen_volume_low\',\n        label: \'Semen volume below standard reference limit (<1.4 mL)\',\n        direction: \'raises\',\n        weight: 14,\n        modifiable: true,\n        userValue: `${answers.semenVolume} mL`,\n        explanation: \'WHO 2021 lower normal limit is 1.4 mL. Lower volumes can occur from incomplete collection, short abstinence, or accessory gland issues.\'\n      });\n      doctorQuestions.push(\'Should we repeat the semen test after a standardized 3-day abstinence period?\');\n    }\n    if (answers.spermConcentration !== undefined && answers.spermConcentration < 16) {\n      totalRiskScore += 22;\n      factors.push({\n        id: \'semen_concentration_low\',\n        label: \'Sperm concentration below standard reference limit (<16 M/mL)\',\n        direction: \'raises\',\n        weight: 22,\n        modifiable: true,\n        userValue: `${answers.spermConcentration} M/mL`,\n        explanation: \'WHO 2021 lower normal limit is 16 million/mL. A repeat test in 4-6 weeks is standard medical practice before drawing conclusions.\'\n      });\n      doctorQuestions.push(\'What is the recommended interval for a confirmatory repeat semen analysis?\');\n    }\n    if (answers.totalMotility !== undefined && answers.totalMotility < 42) {\n      totalRiskScore += 14;\n      factors.push({\n        id: \'semen_total_motility_low\',\n        label: \'Total motility below reference limit (<42%)\',\n        direction: \'raises\',\n        weight: 14,\n        modifiable: true,\n        userValue: `${answers.totalMotility}%`,\n        explanation: \'WHO 2021 lower reference limit is 42%. Lifestyle changes, antioxidants, and cooling often yield positive improvements.\'\n      });\n    }\n    if (answers.progressiveMotility !== undefined && answers.progressiveMotility < 30) {\n      totalRiskScore += 14;\n      factors.push({\n        id: \'semen_prog_motility_low\',\n        label: \'Progressive motility below reference limit (<30%)\',\n        direction: \'raises\',\n        weight: 14,\n        modifiable: true,\n        userValue: `${answers.progressiveMotility}%`,\n        explanation: \'WHO 2021 lower limit is 30%. Progressive movement is key for sperm traversing cervical mucus.\'\n      });\n    }\n  }\n\n  // Cap score 0 - 100\n  let finalScore = Math.min(100, Math.max(0, totalRiskScore));\n\n  // Determine Risk Band\n  let band: RiskBand;\n  if (redFlags.length > 0) {\n    band = \'Urgent\';\n  } else if (finalScore >= 50) {\n    band = \'Elevated\';\n  } else if (finalScore >= 25) {\n    band = \'Moderate\';\n  } else {\n    band = \'Low\';\n  }\n\n  // Determine Triage Level\n  let triage: TriageLevel;\n  let triageReason: string;\n\n  if (redFlags.length > 0) {\n    triage = \'Urgent assessment\';\n    triageReason = \'One or more symptoms flagged could represent time-critical conditions (e.g. acute torsion or infection) requiring same-day physical assessment.\';\n  } else if (\n    (answers.familyPlanning === \'trying\' && answers.tryingDuration === \'over_12\') ||\n    (answers.hasSemenAnalysis && answers.spermConcentration !== undefined && answers.spermConcentration < 16)\n  ) {\n    triage = \'Fertility service\';\n    triageReason = \'Trying for over 12 months or having semen metrics below reference limits warrants dedicated reproductive medicine and couples evaluation.\';\n  } else if (band === \'Elevated\' || (answers.currentSymptoms && answers.currentSymptoms.includes(\'heaviness_veins\'))) {\n    triage = \'Andrology/Urology\';\n    triageReason = \'Identified anatomical or notable endocrine signals (such as vein swelling or hormonal compound history) are best evaluated by a male reproductive specialist.\';\n  } else if (band === \'Moderate\') {\n    triage = \'Primary care\';\n    triageReason = \'General practitioner / family physician evaluation is ideal to address metabolic, lifestyle, and basic hormone parameters in a supportive setting.\';\n  } else {\n    triage = \'Self-care\';\n    triageReason = \'Low risk profile with strong protective factors. Proactive self-care and ongoing healthy lifestyle habits are recommended.\';\n  }\n\n  // Generate plain-language summary\n  let summary = \'\';\n  if (band === \'Urgent\') {\n    summary = \'Important symptoms were noted that require same-day clinical evaluation by a medical doctor.\';\n  } else if (band === \'Elevated\') {\n    summary = \'Several identifiable factors were found that can influence reproductive health. Many of these are modifiable or treatable under medical guidance.\';\n  } else if (band === \'Moderate\') {\n    summary = \'Your assessment shows a moderate number of areas where lifestyle or general metabolic adjustments can actively support your reproductive vitality.\';\n  } else {\n    summary = \'Your assessment indicates a low risk pattern with reassuring protective habits and no immediate clinical red flags.\';\n  }\n\n  // Default actions if empty\n  if (actions.length === 0) {\n    actions.push(\'Maintain balanced nutrition rich in zinc, selenium, CoQ10, and leafy greens.\');\n    actions.push(\'Keep testicles cool by avoiding prolonged hot baths and tight synthetic clothing.\');\n    actions.push(\'Stay active with 3-4 days of moderate aerobic exercise and adequate sleep.\');\n  }\n\n  // Default doctor questions if empty\n  if (doctorQuestions.length === 0) {\n    doctorQuestions.push(\'Are there any baseline tests or vitamins you would suggest based on our family timeline?\');\n    doctorQuestions.push(\'How frequently should we monitor my overall metabolic and reproductive parameters?\');\n  }\n\n  const missingInfo = !answers.hasSemenAnalysis || answers.sleepHours === undefined || answers.heightCm === undefined;\n  const missingInfoNote = missingInfo\n    ? \'This screening is based on the information you shared. Additional details (such as a laboratory semen analysis or metabolic lab values) can make future guidance even more precise.\'\n    : undefined;\n\n  return {\n    score: finalScore,\n    band,\n    triage,\n    triageReason,\n    summary,\n    factors: factors.sort((a, b) => b.weight - a.weight),\n    favourableFactors,\n    redFlags,\n    missingInfoNote,\n    actions,\n    doctorQuestions,\n    calculatedAt: new Date().toISOString()\n  };\n}\n"
