  view_file {
    absolute_path_uri: "file:///src/components/RiskGauge.tsx"
    end_line: 140
    content: "import React, { useEffect, useState } from \'react\';\nimport { motion, useReducedMotion } from \'motion/react\';\nimport { ShieldCheck, Info, AlertCircle, AlertTriangle } from \'lucide-react\';\nimport { RiskBand } from \'../types\';\n\ninterface RiskGaugeProps {\n  score: number;\n  band: RiskBand;\n  size?: number;\n}\n\nexport const RiskGauge: React.FC<RiskGaugeProps> = ({ score, band, size = 210 }) => {\n  const shouldReduceMotion = useReducedMotion();\n  const [displayScore, setDisplayScore] = useState(shouldReduceMotion ? score : 0);\n\n  useEffect(() => {\n    if (shouldReduceMotion) {\n      setDisplayScore(score);\n      return;\n    }\n\n    let rafId = 0;\n    const duration = 900;\n    const startVal = displayScore;\n    const startTime = performance.now();\n\n    const step = (now: number) => {\n      const elapsed = now - startTime;\n      const progress = Math.min(1, elapsed / duration);\n      // easeOutCubic\n      const eased = 1 - Math.pow(1 - progress, 3);\n      setDisplayScore(Math.round(startVal + (score - startVal) * eased));\n      if (progress < 1) {\n        rafId = requestAnimationFrame(step);\n      }\n    };\n\n    rafId = requestAnimationFrame(step);\n    return () => cancelAnimationFrame(rafId);\n  }, [score, shouldReduceMotion]);\n\n  const strokeWidth = 14;\n  const radius = (size - strokeWidth) / 2;\n  const circumference = 2 * Math.PI * radius;\n  const clampedPct = Math.min(100, Math.max(4, score));\n  const strokeDashoffset = circumference - (clampedPct / 100) * circumference;\n\n  const bandMeta: Record<\n    RiskBand,\n    { stroke: string; bg: string; border: string; Icon: React.ElementType; label: string }\n  > = {\n    Low: {\n      stroke: \'var(--risk-low)\',\n      bg: \'var(--risk-low-bg)\',\n      border: \'var(--risk-low-border)\',\n      Icon: ShieldCheck,\n      label: \'Low Band\',\n    },\n    Moderate: {\n      stroke: \'var(--risk-mod)\',\n      bg: \'var(--risk-mod-bg)\',\n      border: \'var(--risk-mod-border)\',\n      Icon: Info,\n      label: \'Moderate Band\',\n    },\n    Elevated: {\n      stroke: \'var(--risk-elev)\',\n      bg: \'var(--risk-elev-bg)\',\n      border: \'var(--risk-elev-border)\',\n      Icon: AlertCircle,\n      label: \'Elevated Band\',\n    },\n    Urgent: {\n      stroke: \'var(--risk-urg)\',\n      bg: \'var(--risk-urg-bg)\',\n      border: \'var(--risk-urg-border)\',\n      Icon: AlertTriangle,\n      label: \'Urgent Band\',\n    },\n  };\n\n  const meta = bandMeta[band];\n  const BandIcon = meta.Icon;\n\n  return (\n    <div\n      className=\"relative flex flex-col items-center justify-center shrink-0\"\n      style={{ width: size, height: size }}\n      aria-label={`${meta.label}, Signal ${score} out of 100`}\n    >\n      <svg width={size} height={size} className=\"-rotate-90\">\n        {/* Track circle */}\n        <circle\n          cx={size / 2}\n          cy={size / 2}\n          r={radius}\n          stroke=\"var(--gauge-track)\"\n          strokeWidth={strokeWidth}\n          fill=\"transparent\"\n        />\n        {/* Animated fill circle */}\n        <motion.circle\n          cx={size / 2}\n          cy={size / 2}\n          r={radius}\n          stroke={meta.stroke}\n          strokeWidth={strokeWidth}\n          strokeDasharray={circumference}\n          initial={{ strokeDashoffset: shouldReduceMotion ? strokeDashoffset : circumference }}\n          animate={{ strokeDashoffset }}\n          transition={shouldReduceMotion ? { duration: 0 } : { duration: 1.0, ease: [0.16, 1, 0.3, 1] }}\n          strokeLinecap=\"round\"\n          fill=\"transparent\"\n        />\n      </svg>\n\n      {/* Center Label (Icon + Text + Animated Number) */}\n      <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center px-5\">\n        <div\n          className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold mb-1 border\"\n          style={{\n            color: meta.stroke,\n            backgroundColor: meta.bg,\n            borderColor: meta.border,\n          }}\n        >\n          <BandIcon className=\"w-3.5 h-3.5 shrink-0\" />\n          <span>{band}</span>\n        </div>\n        <span className=\"text-3xl font-extrabold font-heading text-[var(--text-main)] tabular-nums leading-none mt-1\">\n          {displayScore}\n          <span className=\"text-sm font-medium text-[var(--text-muted)]\">/100</span>\n        </span>\n        <span className=\"text-xs font-mono text-[var(--text-muted)] mt-1\">\n          Signal Index\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 141
    num_bytes: 4407
    line_range_bytes: 4407
  }
}
