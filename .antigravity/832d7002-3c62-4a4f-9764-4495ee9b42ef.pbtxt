    tool_calls {
      id: "call_6462924081110445330"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { Suspense, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { useIsTouchDevice, usePrefersReducedMotion } from \'../motion\';\\n\\nconst LazyHeroDottedWave = React.lazy(() => import(\'./HeroDottedWave\'));\\n\\nconst StaticWaveFallback: React.FC = () => {\\n  const dots = useMemo(() => {\\n    const pts: { cx: number; cy: number; r: number; o: number }[] = [];\\n    const cols = 42;\\n    const rows = 14;\\n    for (let r = 0; r < rows; r++) {\\n      for (let c = 0; c < cols; c++) {\\n        const nx = c / (cols - 1);\\n        const nz = r / (rows - 1);\\n        const wave =\\n          Math.sin(nx * Math.PI * 3.2) * 18 +\\n          Math.cos(nz * Math.PI * 2.1 + nx * 2.5) * 12;\\n        const cx = nx * 1200;\\n        const cy = 110 + nz * 210 + wave;\\n        const radius = 1.2 + nz * 1.1;\\n        const opacity = 0.14 + (1 - Math.abs(nz - 0.5) * 1.4) * 0.25;\\n        pts.push({ cx, cy, r: radius, o: Math.max(0.08, opacity) });\\n      }\\n    }\\n    return pts;\\n  }, []);\\n\\n  return (\\n    <svg\\n      viewBox=\\\"0 0 1200 380\\\"\\n      preserveAspectRatio=\\\"xMidYMid slice\\\"\\n      className=\\\"w-full h-full pointer-events-none select-none\\\"\\n      aria-hidden=\\\"true\\\"\\n    >\\n      {dots.map((d, i) => (\\n        <circle\\n          key={i}\\n          cx={d.cx}\\n          cy={d.cy}\\n          r={d.r}\\n          fill=\\\"var(--brand)\\\"\\n          fillOpacity={d.o}\\n        />\\n      ))}\\n    </svg>\\n  );\\n};\\n\\nfunction detectWebGLSupport(): boolean {\\n  try {\\n    const canvas = document.createElement(\'canvas\');\\n    return !!(\\n      window.WebGLRenderingContext &&\\n      (canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\') || canvas.getContext(\'experimental-webgl\'))\\n    );\\n  } catch {\\n    return false;\\n  }\\n}\\n\\nexport const HeroWaveWrapper: React.FC = () => {\\n  const { theme } = useApp();\\n  const reduced = usePrefersReducedMotion();\\n  const isTouch = useIsTouchDevice();\\n  const containerRef = useRef<HTMLDivElement>(null);\\n  const pointerRef = useRef({ x: 0, y: 0 });\\n  const [webglSupported, setWebglSupported] = useState(false);\\n  const [isVisible, setIsVisible] = useState(true);\\n\\n  useEffect(() => {\\n    const lowPower =\\n      typeof navigator !== \'undefined\' &&\\n      typeof navigator.hardwareConcurrency === \'number\' &&\\n      navigator.hardwareConcurrency <= 2;\\n\\n    if (!lowPower && detectWebGLSupport()) {\\n      setWebglSupported(true);\\n    }\\n  }, []);\\n\\n  const canUseWebGL = webglSupported && !reduced;\\n\\n  // Pause hero WebGL when scrolled off-screen\\n  useEffect(() => {\\n    const el = containerRef.current;\\n    if (!el || typeof IntersectionObserver === \'undefined\') return;\\n    const observer = new IntersectionObserver(\\n      entries => {\\n        setIsVisible(entries[0]?.isIntersecting ?? true);\\n      },\\n      { threshold: 0.02 }\\n    );\\n    observer.observe(el);\\n    return () => observer.disconnect();\\n  }, []);\\n\\n  useEffect(() => {\\n    if (!canUseWebGL || isTouch) return;\\n    const handleMove = (e: PointerEvent) => {\\n      const nx = (e.clientX / window.innerWidth) * 2 - 1;\\n      const ny = (e.clientY / window.innerHeight) * 2 - 1;\\n      pointerRef.current.x = nx;\\n      pointerRef.current.y = ny;\\n    };\\n    window.addEventListener(\'pointermove\', handleMove, { passive: true });\\n    return () => window.removeEventListener(\'pointermove\', handleMove);\\n  }, [canUseWebGL, isTouch]);\\n\\n  return (\\n    <div\\n      ref={containerRef}\\n      className=\\\"absolute inset-0 overflow-hidden pointer-events-none\\\"\\n      aria-hidden=\\\"true\\\"\\n    >\\n      {canUseWebGL ? (\\n        <Suspense fallback={<StaticWaveFallback />}>\\n          <LazyHeroDottedWave\\n            theme={theme}\\n            pointerRef={pointerRef}\\n            isVisible={isVisible}\\n            isTouch={isTouch}\\n          />\\n        </Suspense>\\n      ) : (\\n        <StaticWaveFallback />\\n      )}\\n      {/* Soft top & bottom fade into page sand background */}\\n      <div\\n        className=\\\"absolute inset-x-0 bottom-0 h-28 pointer-events-none\\\"\\n        style={{\\n          background: \'linear-gradient(to bottom, transparent 0%, var(--bg-deep) 100%)\',\\n        }}\\n      />\\n      <div\\n        className=\\\"absolute inset-x-0 top-0 h-16 pointer-events-none\\\"\\n        style={{\\n          background: \'linear-gradient(to top, transparent 0%, var(--bg-deep) 100%)\',\\n        }}\\n      />\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update HeroWaveWrapper with IntersectionObserver offscreen pausing, reduced motion check, and touch density control\", \"Overwrite\":true, \"TargetFile\":\"/src/components/HeroWaveWrapper.tsx\", \"toolAction\":\"Updating HeroWaveWrapper.tsx\", \"toolSummary\":\"Update HeroWaveWrapper.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_6462924081110443263"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef } from \'react\';\\nimport { useLocation } from \'react-router-dom\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { useIsTouchDevice, usePrefersReducedMotion } from \'../motion\';\\nimport { RiskBand } from \'../types\';\\n\\nfunction getWaveRgb(\\n  pathname: string,\\n  theme: \'light\' | \'dark\',\\n  band?: RiskBand\\n): [number, number, number] {\\n  if (pathname === \'/results\' && band) {\\n    if (band === \'Low\') return theme === \'dark\' ? [74, 222, 128] : [29, 122, 82];\\n    if (band === \'Moderate\') return theme === \'dark\' ? [251, 191, 36] : [154, 91, 6];\\n    if (band === \'Elevated\') return theme === \'dark\' ? [251, 146, 60] : [180, 75, 24];\\n    if (band === \'Urgent\') return theme === \'dark\' ? [248, 113, 113] : [180, 35, 35];\\n  }\\n  if (pathname === \'/consent\' || pathname === \'/privacy\') {\\n    return theme === \'dark\' ? [58, 180, 165] : [31, 138, 125];\\n  }\\n  if (pathname === \'/evidence\' || pathname === \'/how-it-works\') {\\n    return theme === \'dark\' ? [168, 149, 140] : [110, 92, 84];\\n  }\\n  if (pathname === \'/care\') {\\n    return theme === \'dark\' ? [74, 196, 178] : [26, 122, 110];\\n  }\\n  return theme === \'dark\' ? [196, 174, 165] : [122, 100, 92];\\n}\\n\\n/**\\n * Low-contrast site-wide Canvas2D ambient dotted wave background.\\n * Uses zero WebGL contexts (keeping total app WebGL count <= 1).\\n * Gently shifts tint per route and toward RiskBand on /results.\\n */\\nexport const AmbientWaveBackground: React.FC = () => {\\n  const { pathname } = useLocation();\\n  const { theme, result } = useApp();\\n  const reduced = usePrefersReducedMotion();\\n  const isTouch = useIsTouchDevice();\\n\\n  const canvasRef = useRef<HTMLCanvasElement>(null);\\n  const currentColorRef = useRef<[number, number, number]>([122, 100, 92]);\\n  const targetColorRef = useRef<[number, number, number]>([122, 100, 92]);\\n\\n  useEffect(() => {\\n    targetColorRef.current = getWaveRgb(pathname, theme, result?.band);\\n  }, [pathname, theme, result?.band]);\\n\\n  useEffect(() => {\\n    if (reduced) return;\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const ctx = canvas.getContext(\'2d\');\\n    if (!ctx) return;\\n\\n    let rafId = 0;\\n    let time = 0;\\n    let lastTick = performance.now();\\n    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);\\n\\n    const resize = () => {\\n      canvas.width = Math.floor(window.innerWidth * dpr);\\n      canvas.height = Math.floor(window.innerHeight * dpr);\\n      canvas.style.width = `${window.innerWidth}px`;\\n      canvas.style.height = `${window.innerHeight}px`;\\n      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\\n    };\\n\\n    resize();\\n    window.addEventListener(\'resize\', resize, { passive: true });\\n\\n    const cols = isTouch ? 18 : 30;\\n    const rows = isTouch ? 8 : 12;\\n    const INTERVAL_MS = isTouch ? 60 : 40; // ~16-25fps calm ambient motion\\n\\n    const draw = (now: number) => {\\n      rafId = requestAnimationFrame(draw);\\n      if (document.hidden || now - lastTick < INTERVAL_MS) return;\\n      const dt = Math.min((now - lastTick) / 1000, 0.1);\\n      lastTick = now;\\n      time += dt * 0.45;\\n\\n      // Smoothly interpolate tint color\\n      const cur = currentColorRef.current;\\n      const tgt = targetColorRef.current;\\n      cur[0] += (tgt[0] - cur[0]) * 0.04;\\n      cur[1] += (tgt[1] - cur[1]) * 0.04;\\n      cur[2] += (tgt[2] - cur[2]) * 0.04;\\n\\n      const w = window.innerWidth;\\n      const h = window.innerHeight;\\n      ctx.clearRect(0, 0, w, h);\\n\\n      const baseOpacity = theme === \'dark\' ? 0.11 : 0.13;\\n      const r = Math.round(cur[0]);\\n      const g = Math.round(cur[1]);\\n      const b = Math.round(cur[2]);\\n\\n      for (let row = 0; row < rows; row++) {\\n        const ny = row / (rows - 1);\\n        for (let col = 0; col < cols; col++) {\\n          const nx = col / (cols - 1);\\n          const x = nx * (w + 60) - 30;\\n          const wave =\\n            Math.sin(nx * 5.2 + time + ny * 1.4) * 18 +\\n            Math.cos(ny * 4.0 + time * 0.7 - nx * 2.5) * 12;\\n          const y = h * (0.28 + ny * 0.64) + wave;\\n          const alpha = baseOpacity * (0.55 + Math.sin(nx * Math.PI) * 0.45);\\n          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;\\n          ctx.beginPath();\\n          ctx.arc(x, y, isTouch ? 1.4 : 1.6, 0, Math.PI * 2);\\n          ctx.fill();\\n        }\\n      }\\n    };\\n\\n    rafId = requestAnimationFrame(draw);\\n    return () => {\\n      cancelAnimationFrame(rafId);\\n      window.removeEventListener(\'resize\', resize);\\n    };\\n  }, [reduced, isTouch, theme]);\\n\\n  if (reduced) return null;\\n\\n  return (\\n    <canvas\\n      ref={canvasRef}\\n      className=\\\"fixed inset-0 pointer-events-none z-0 no-print\\\"\\n      aria-hidden=\\\"true\\\"\\n    />\\n  );\\n};\\n\", \"Description\":\"Create subtle Canvas2D ambient dotted wave background tinted by route and RiskBand\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AmbientWaveBackground.tsx\", \"toolAction\":\"Creating AmbientWaveBackground.tsx\", \"toolSummary\":\"Create AmbientWaveBackground.tsx\"}"
      original_name: "write_to_file"
    }
