  planner_response {
    tool_calls {
      id: "call_15725213409602682134"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useNavigate } from \'react-router-dom\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { calculateBmi } from \'../engine/riskEngine\';\\nimport { \\n  ChevronRight, \\n  ChevronLeft, \\n  HelpCircle, \\n  Info, \\n  AlertTriangle, \\n  Sparkles,\\n  Heart\\n} from \'lucide-react\';\\n\\nexport const WizardPage: React.FC = () => {\\n  const { t, answers, setAnswer, consent } = useApp();\\n  const navigate = useNavigate();\\n\\n  const [step, setStep] = useState(1);\\n  const [activeTooltip, setActiveTooltip] = useState<string | null>(null);\\n\\n  // If user hasn\'t accepted processAnswers, prompt back to consent\\n  if (!consent.processAnswers) {\\n    return (\\n      <div className=\\\"max-w-md mx-auto my-16 p-6 text-center glass-panel rounded-2xl border border-white/10 space-y-4\\\">\\n        <Info className=\\\"w-8 h-8 text-[#2DD4BF] mx-auto\\\" />\\n        <h2 className=\\\"text-base font-semibold font-heading text-[#EAF4F4]\\\">Consent is Required First</h2>\\n        <p className=\\\"text-sm text-[#9FB4BA]\\\">\\n          Please review and accept processing terms so we can safely compute your screening.\\n        </p>\\n        <button\\n          onClick={() => navigate(\'/consent\')}\\n          className=\\\"px-6 py-2.5 rounded-xl bg-[#2DD4BF] text-[#07131A] text-sm font-semibold hover:bg-[#2DD4BF]/90\\\"\\n        >\\n          Review Consent Terms\\n        </button>\\n      </div>\\n    );\\n  }\\n\\n  const totalSteps = 6;\\n  const progressPercent = Math.round((step / totalSteps) * 100);\\n\\n  const toggleTooltip = (id: string) => {\\n    setActiveTooltip(activeTooltip === id ? null : id);\\n  };\\n\\n  const handleNext = () => {\\n    if (step < totalSteps) {\\n      setStep(step + 1);\\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\\n    } else {\\n      navigate(\'/analysing\');\\n    }\\n  };\\n\\n  const handleBack = () => {\\n    if (step > 1) {\\n      setStep(step - 1);\\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\\n    } else {\\n      navigate(\'/consent\');\\n    }\\n  };\\n\\n  const toggleMultiSelect = (key: \'heatExposure\' | \'conditions\' | \'currentSymptoms\' | \'redFlagSymptoms\', val: string) => {\\n    const current = (answers[key] || []) as string[];\\n    if (val === \'none\') {\\n      setAnswer(key, [\'none\'] as any);\\n      return;\\n    }\\n    const filtered = current.filter(item => item !== \'none\');\\n    if (filtered.includes(val)) {\\n      const next = filtered.filter(item => item !== val);\\n      setAnswer(key, (next.length === 0 ? [\'none\'] : next) as any);\\n    } else {\\n      setAnswer(key, [...filtered, val] as any);\\n    }\\n  };\\n\\n  const bmi = calculateBmi(answers.heightCm, answers.weightKg);\\n\\n  return (\\n    <div className=\\\"max-w-3xl mx-auto px-4 py-8 space-y-6\\\">\\n      {/* Step Header & Progress */}\\n      <div className=\\\"space-y-3\\\">\\n        <div className=\\\"flex items-center justify-between text-xs sm:text-sm\\\">\\n          <span className=\\\"font-mono text-[#2DD4BF] font-semibold uppercase tracking-wider\\\">\\n            Step {step} of {totalSteps}\\n          </span>\\n          <span className=\\\"text-[#9FB4BA] font-medium\\\">\\n            {step === 1 && t.step1Title}\\n            {step === 2 && t.step2Title}\\n            {step === 3 && t.step3Title}\\n            {step === 4 && t.step4Title}\\n            {step === 5 && t.step5Title}\\n            {step === 6 && t.step6Title}\\n          </span>\\n        </div>\\n\\n        {/* Progress Bar */}\\n        <div className=\\\"w-full bg-white/5 h-2 rounded-full overflow-hidden\\\">\\n          <div\\n            className=\\\"h-full bg-gradient-to-r from-[#2DD4BF] to-[#38BDF8] rounded-full transition-all duration-300\\\"\\n            style={{ width: `${progressPercent}%` }}\\n          />\\n        </div>\\n      </div>\\n\\n      {/* Main Form Step Card */}\\n      <div className=\\\"p-6 sm:p-8 rounded-2xl glass-panel border border-white/10 space-y-6\\\">\\n        {/* STEP 1: ABOUT YOU */}\\n        {step === 1 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step1Title}</h2>\\n              <p className=\\\"text-sm text-[#9FB4BA] mt-1\\\">\\n                Baseline biological information helps contextualize hormonal patterns.\\n              </p>\\n            </div>\\n\\n            {/* Age Range */}\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">What is your age range?</label>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => toggleTooltip(\'age\')}\\n                  className=\\\"text-xs text-[#2DD4BF] hover:underline flex items-center gap-1\\\"\\n                >\\n                  <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{t.whyWeAsk}</span>\\n                </button>\\n              </div>\\n              {activeTooltip === \'age\' && (\\n                <div className=\\\"p-3 bg-white/5 rounded-xl text-xs sm:text-sm text-[#9FB4BA] border border-white/10\\\">\\n                  Paternal age can subtly influence semen volume, genetic fidelity, and natural conception timelines.\\n                </div>\\n              )}\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-3 gap-2\\\">\\n                {[\\n                  { id: \'18-24\', label: \'18 to 24\' },\\n                  { id: \'25-29\', label: \'25 to 29\' },\\n                  { id: \'30-34\', label: \'30 to 34\' },\\n                  { id: \'35-39\', label: \'35 to 39\' },\\n                  { id: \'40-44\', label: \'40 to 44\' },\\n                  { id: \'45+\', label: \'45 or older\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'ageRange\', opt.id as any)}\\n                    className={`py-3 px-3 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.ageRange === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Family Planning */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                  Are you planning or trying for a family?\\n                </label>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => toggleTooltip(\'family\')}\\n                  className=\\\"text-xs text-[#2DD4BF] hover:underline flex items-center gap-1\\\"\\n                >\\n                  <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{t.whyWeAsk}</span>\\n                </button>\\n              </div>\\n              {activeTooltip === \'family\' && (\\n                <div className=\\\"p-3 bg-white/5 rounded-xl text-xs sm:text-sm text-[#9FB4BA] border border-white/10\\\">\\n                  This tailors recommendations between general wellness, future preparation, or clinical fertility timing.\\n                </div>\\n              )}\\n              <div className=\\\"grid sm:grid-cols-3 gap-2\\\">\\n                {[\\n                  { id: \'not_now\', label: \'Not right now / General wellness\' },\\n                  { id: \'planning\', label: \'Planning for the future (next 1-2 years)\' },\\n                  { id: \'trying\', label: \'Actively trying currently\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      setAnswer(\'familyPlanning\', opt.id as any);\\n                      // Clear tryingDuration if switching away from trying\\n                      if (opt.id !== \'trying\') {\\n                        setAnswer(\'tryingDuration\', undefined);\\n                      }\\n                    }}\\n                    className={`p-3.5 rounded-xl text-sm font-medium border text-left transition-all ${\\n                      answers.familyPlanning === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* STEP 2: YOUR JOURNEY (CONDITIONAL TIMELINE LOGIC) */}\\n        {step === 2 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step2Title}</h2>\\n              <p className=\\\"text-sm text-[#9FB4BA] mt-1\\\">\\n                Conception timelines guide whether standard watchful waiting or formal specialist triage is indicated.\\n              </p>\\n            </div>\\n\\n            {/* REQUIREMENT A1: Show tryingDuration ONLY if user chose \'trying\' */}\\n            {answers.familyPlanning === \'trying\' ? (\\n              <div className=\\\"space-y-2\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                    How long have you been actively trying to conceive?\\n                  </label>\\n                  <span className=\\\"text-xs font-mono text-[#2DD4BF] bg-[#2DD4BF]/10 px-2 py-0.5 rounded\\\">\\n                    Active Timeline\\n                  </span>\\n                </div>\\n                <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                  {[\\n                    { id: \'under_3\', label: \'Under 3 months\' },\\n                    { id: \'3_6\', label: \'3 to 6 months\' },\\n                    { id: \'6_12\', label: \'6 to 12 months\' },\\n                    { id: \'over_12\', label: \'Over 12 months\' }\\n                  ].map(opt => (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => setAnswer(\'tryingDuration\', opt.id as any)}\\n                      className={`py-3 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                        answers.tryingDuration === opt.id\\n                          ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                          : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n            ) : (\\n              /* Gentle line when planning or not trying right now */\\n              <div className=\\\"p-4 rounded-xl bg-teal-500/10 border border-teal-500/20 text-sm text-[#EAF4F4] flex items-center gap-2.5\\\">\\n                <Heart className=\\\"w-5 h-5 text-[#2DD4BF] shrink-0\\\" />\\n                <span>\\n                  {answers.familyPlanning === \'planning\'\\n                    ? \\\"Planning ahead is a great time to check in and optimize lifestyle factors early.\\\"\\n                    : \\\"Focusing on everyday wellness is ideal for building long-term reproductive vitality.\\\"}\\n                </span>\\n              </div>\\n            )}\\n\\n            {/* Partner assessed */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                  Has a partner undergone medical fertility evaluation?\\n                </label>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => toggleTooltip(\'partner\')}\\n                  className=\\\"text-xs text-[#2DD4BF] hover:underline flex items-center gap-1\\\"\\n                >\\n                  <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{t.whyWeAsk}</span>\\n                </button>\\n              </div>\\n              {activeTooltip === \'partner\' && (\\n                <div className=\\\"p-3 bg-white/5 rounded-xl text-xs sm:text-sm text-[#9FB4BA] border border-white/10\\\">\\n                  Fertility is shared. In approximately 50% of couples facing delay, a male contributory factor is present. Simultaneous assessment prevents one-sided delays.\\n                </div>\\n              )}\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                {[\\n                  { id: \'yes\', label: \'Yes\' },\\n                  { id: \'no\', label: \'No\' },\\n                  { id: \'not_applicable\', label: \'Not applicable\' },\\n                  { id: \'prefer_not_to_say\', label: t.preferNotToSay }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'partnerAssessed\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.partnerAssessed === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Earlier tests */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Have you had any earlier fertility or hormone tests yourself?\\n              </label>\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                {[\\n                  { id: \'none\', label: \'None yet\' },\\n                  { id: \'semen\', label: \'Semen test\' },\\n                  { id: \'hormone\', label: \'Blood hormones\' },\\n                  { id: \'other\', label: \'Other tests\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'earlierTests\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.earlierTests === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* STEP 3: DAILY LIFE (WITH STRESS 1-5 & RECREATIONAL SUBSTANCES) */}\\n        {step === 3 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step3Title}</h2>\\n              <p className=\\\"text-sm text-[#9FB4BA] mt-1\\\">\\n                Spermatogenesis takes approximately 74 days. Everyday habits have a profound, reversible impact.\\n              </p>\\n            </div>\\n\\n            {/* Smoking */}\\n            <div className=\\\"space-y-2\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">Smoking or Vaping (Nicotine / Shisha)</label>\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                {[\\n                  { id: \'never\', label: \'Never\' },\\n                  { id: \'past\', label: \'Past (quit)\' },\\n                  { id: \'occasional\', label: \'Occasional\' },\\n                  { id: \'daily\', label: \'Daily\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'smoking\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.smoking === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Alcohol */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">Alcohol Consumption</label>\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                {[\\n                  { id: \'none\', label: \'None\' },\\n                  { id: \'light\', label: \'Light (rare)\' },\\n                  { id: \'moderate\', label: \'Moderate (weekly)\' },\\n                  { id: \'heavy\', label: \'Heavy\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'alcohol\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.alcohol === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Sleep Slider */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between text-sm\\\">\\n                <span className=\\\"font-semibold text-[#EAF4F4]\\\">Average Sleep Duration</span>\\n                <span className=\\\"font-mono text-[#2DD4BF] font-bold\\\">{answers.sleepHours ?? 7} hours / night</span>\\n              </div>\\n              <input\\n                type=\\\"range\\\"\\n                min=\\\"4\\\"\\n                max=\\\"10\\\"\\n                step=\\\"0.5\\\"\\n                value={answers.sleepHours ?? 7}\\n                onChange={e => setAnswer(\'sleepHours\', parseFloat(e.target.value))}\\n                className=\\\"w-full accent-[#2DD4BF] bg-white/10 rounded-lg cursor-pointer h-2\\\"\\n              />\\n              <div className=\\\"flex justify-between text-xs text-[#9FB4BA]\\\">\\n                <span>4h</span>\\n                <span>Optimal: 7-8h</span>\\n                <span>10h</span>\\n              </div>\\n            </div>\\n\\n            {/* Stress Level 1-5 Selector */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                  Stress Level (1 = Low, 5 = Very High)\\n                </label>\\n                <span className=\\\"text-xs font-mono text-[#2DD4BF]\\\">\\n                  Selected: {answers.stressLevel ? `${answers.stressLevel} of 5` : \'Not set\'}\\n                </span>\\n              </div>\\n              <div className=\\\"grid grid-cols-5 gap-2\\\">\\n                {[1, 2, 3, 4, 5].map(level => (\\n                  <button\\n                    key={level}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'stressLevel\', level)}\\n                    className={`py-2.5 rounded-xl text-sm font-bold font-mono border transition-all ${\\n                      answers.stressLevel === level\\n                        ? \'bg-[#2DD4BF]/25 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {level}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Exercise Slider */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between text-sm\\\">\\n                <span className=\\\"font-semibold text-[#EAF4F4]\\\">Exercise Frequency</span>\\n                <span className=\\\"font-mono text-[#2DD4BF] font-bold\\\">{answers.exerciseDays ?? 3} days / week</span>\\n              </div>\\n              <input\\n                type=\\\"range\\\"\\n                min=\\\"0\\\"\\n                max=\\\"7\\\"\\n                step=\\\"1\\\"\\n                value={answers.exerciseDays ?? 3}\\n                onChange={e => setAnswer(\'exerciseDays\', parseInt(e.target.value))}\\n                className=\\\"w-full accent-[#2DD4BF] bg-white/10 rounded-lg cursor-pointer h-2\\\"\\n              />\\n              <div className=\\\"flex justify-between text-xs text-[#9FB4BA]\\\">\\n                <span>Sedentary (0)</span>\\n                <span>Active (3-4)</span>\\n                <span>Daily (7)</span>\\n              </div>\\n            </div>\\n\\n            {/* Recreational Substances */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Recreational substance use\\n              </label>\\n              <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-2\\\">\\n                {[\\n                  { id: \'none\', label: \'None\' },\\n                  { id: \'occasional\', label: \'Occasional\' },\\n                  { id: \'regular\', label: \'Regular\' },\\n                  { id: \'prefer_not_to_say\', label: t.preferNotToSay }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'recreationalSubstances\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.recreationalSubstances === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Heat Exposure */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                  Frequent scrotal heat exposure (multi-select)\\n                </label>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => toggleTooltip(\'heat\')}\\n                  className=\\\"text-xs text-[#2DD4BF] hover:underline flex items-center gap-1\\\"\\n                >\\n                  <HelpCircle className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{t.whyWeAsk}</span>\\n                </button>\\n              </div>\\n              {activeTooltip === \'heat\' && (\\n                <div className=\\\"p-3 bg-white/5 rounded-xl text-xs sm:text-sm text-[#9FB4BA] border border-white/10\\\">\\n                  Spermatogenesis requires an environment roughly 2\302\260C to 4\302\260C cooler than core body temperature. Frequent saunas or hot laptops elevate temperature and impede sperm production.\\n                </div>\\n              )}\\n              <div className=\\\"grid sm:grid-cols-2 gap-2\\\">\\n                {[\\n                  { id: \'hot_baths\', label: \'Frequent hot baths, jacuzzis, or saunas\' },\\n                  { id: \'laptop_lap\', label: \'Resting laptop directly on lap for hours\' },\\n                  { id: \'hot_work\', label: \'Working in high-heat industrial environment\' },\\n                  { id: \'none\', label: \'None of these apply to me\' }\\n                ].map(opt => {\\n                  const isChecked = (answers.heatExposure || []).includes(opt.id);\\n                  return (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => toggleMultiSelect(\'heatExposure\', opt.id)}\\n                      className={`p-3 rounded-xl text-sm font-medium border text-left transition-all ${\\n                        isChecked\\n                          ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                          : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n\\n            {/* Anabolic Steroids / Testosterone */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Supplements, Testosterone or Anabolic Steroid Use\\n              </label>\\n              <div className=\\\"grid grid-cols-3 gap-2\\\">\\n                {[\\n                  { id: \'none\', label: \'Never used\' },\\n                  { id: \'past\', label: \'Used in the past\' },\\n                  { id: \'current\', label: \'Currently using\' }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'supplementsSteroids\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.supplementsSteroids === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* STEP 4: BODY & METABOLIC (SOFT BMI & OPTIONAL WAIST CONCERN) */}\\n        {step === 4 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step4Title}</h2>\\n              <p className=\\\"text-sm text-[#9FB4BA] mt-1\\\">\\n                Metabolic conditions, blood sugar, and adipose balance modulate reproductive hormone synthesis.\\n              </p>\\n            </div>\\n\\n            {/* Height & Weight */}\\n            <div className=\\\"grid grid-cols-2 gap-4\\\">\\n              <div className=\\\"space-y-1.5\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">Height (cm)</label>\\n                <input\\n                  type=\\\"number\\\"\\n                  placeholder=\\\"e.g. 178\\\"\\n                  value={answers.heightCm || \'\'}\\n                  onChange={e => setAnswer(\'heightCm\', e.target.value ? parseInt(e.target.value) : undefined)}\\n                  className=\\\"w-full px-3.5 py-2.5 rounded-xl bg-white/[0.03] border border-white/10 text-[#EAF4F4] text-sm focus:border-[#2DD4BF] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"space-y-1.5\\\">\\n                <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">Weight (kg)</label>\\n                <input\\n                  type=\\\"number\\\"\\n                  placeholder=\\\"e.g. 78\\\"\\n                  value={answers.weightKg || \'\'}\\n                  onChange={e => setAnswer(\'weightKg\', e.target.value ? parseInt(e.target.value) : undefined)}\\n                  className=\\\"w-full px-3.5 py-2.5 rounded-xl bg-white/[0.03] border border-white/10 text-[#EAF4F4] text-sm focus:border-[#2DD4BF] focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* REQUIREMENT B6: Soft Computed BMI display */}\\n            {bmi !== undefined && (\\n              <div className=\\\"p-3.5 rounded-xl bg-teal-500/[0.06] border border-teal-500/20 flex items-center justify-between text-sm\\\">\\n                <span className=\\\"text-[#9FB4BA]\\\">\\n                  Your calculated BMI is about <strong className=\\\"text-[#EAF4F4]\\\">{bmi}</strong>:\\n                </span>\\n                <span className=\\\"font-medium text-[#2DD4BF]\\\">\\n                  {bmi >= 30 ? \'In the higher range\' : bmi >= 25 ? \'Slightly above typical\' : \'In the typical range\'}\\n                </span>\\n              </div>\\n            )}\\n\\n            {/* REQUIREMENT B6: Optional Waist size concern */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Do you have any concerns regarding waist circumference or central abdominal weight?\\n              </label>\\n              <div className=\\\"grid grid-cols-3 gap-2\\\">\\n                {[\\n                  { id: \'yes\', label: \'Yes\' },\\n                  { id: \'no\', label: \'No\' },\\n                  { id: \'prefer_not_to_say\', label: t.preferNotToSay }\\n                ].map(opt => (\\n                  <button\\n                    key={opt.id}\\n                    type=\\\"button\\\"\\n                    onClick={() => setAnswer(\'waistConcern\', opt.id as any)}\\n                    className={`py-2.5 px-2 rounded-xl text-sm font-medium border text-center transition-all ${\\n                      answers.waistConcern === opt.id\\n                        ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                        : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                    }`}\\n                  >\\n                    {opt.label}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            {/* Known conditions */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Diagnosed conditions (multi-select)\\n              </label>\\n              <div className=\\\"grid sm:grid-cols-2 gap-2\\\">\\n                {[\\n                  { id: \'diabetes\', label: \'Diabetes or high blood sugar\' },\\n                  { id: \'hypertension\', label: \'High blood pressure\' },\\n                  { id: \'thyroid\', label: \'Thyroid disorder\' },\\n                  { id: \'cholesterol\', label: \'Elevated cholesterol / lipids\' },\\n                  { id: \'none\', label: \'None diagnosed\' }\\n                ].map(opt => {\\n                  const isChecked = (answers.conditions || []).includes(opt.id);\\n                  return (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => toggleMultiSelect(\'conditions\', opt.id)}\\n                      className={`p-3 rounded-xl text-sm font-medium border text-left transition-all ${\\n                        isChecked\\n                          ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                          : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* STEP 5: HISTORY & SYMPTOMS */}\\n        {step === 5 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step5Title}</h2>\\n              <p className=\\\"text-sm text-[#9FB4BA] mt-1\\\">\\n                Certain past childhood infections or anatomical signs can indicate common, treatable conditions like varicoceles.\\n              </p>\\n            </div>\\n\\n            {/* Medical History */}\\n            <div className=\\\"space-y-3\\\">\\n              {[\\n                { key: \'pastMumps\', label: \'Did you have mumps in childhood or teenage years?\' },\\n                { key: \'pastInfection\', label: \'History of urinary or genital infection / prostatitis?\' },\\n                { key: \'pastSurgeryInjury\', label: \'Any prior hernia surgery, scrotal surgery, or sports trauma?\' },\\n                { key: \'undescendedTesticle\', label: \'History of undescended testicle in infancy?\' }\\n              ].map(q => (\\n                <div key={q.key} className=\\\"p-3.5 rounded-xl bg-white/[0.02] border border-white/5 space-y-2\\\">\\n                  <span className=\\\"text-sm font-medium text-[#EAF4F4] block\\\">{q.label}</span>\\n                  <div className=\\\"grid grid-cols-4 gap-1.5\\\">\\n                    {[\\n                      { id: \'yes\', label: \'Yes\' },\\n                      { id: \'no\', label: \'No\' },\\n                      { id: \'not_sure\', label: \'Not sure\' },\\n                      { id: \'prefer_not_to_say\', label: \'Skip\' }\\n                    ].map(opt => (\\n                      <button\\n                        key={opt.id}\\n                        type=\\\"button\\\"\\n                        onClick={() => setAnswer(q.key as any, opt.id)}\\n                        className={`py-2 px-2 rounded-lg text-xs sm:text-sm font-medium border text-center transition-all ${\\n                          (answers as any)[q.key] === opt.id\\n                            ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                            : \'bg-white/[0.02] border-white/5 text-[#9FB4BA] hover:bg-white/5\'\\n                        }`}\\n                      >\\n                        {opt.label}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n\\n            {/* Current Symptoms */}\\n            <div className=\\\"space-y-2 pt-2 border-t border-white/5\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">\\n                Current physical symptoms (multi-select)\\n              </label>\\n              <div className=\\\"grid sm:grid-cols-2 gap-2\\\">\\n                {[\\n                  { id: \'heaviness_veins\', label: \'Feeling of heaviness or swollen veins (\\\"bag of worms\\\")\' },\\n                  { id: \'dull_ache\', label: \'Dull ache after standing or physical exertion\' },\\n                  { id: \'low_libido\', label: \'Noticeable drop in sex drive\' },\\n                  { id: \'erection_difficulty\', label: \'Difficulty achieving or maintaining firm erections\' },\\n                  { id: \'none\', label: \'None of these symptoms\' }\\n                ].map(opt => {\\n                  const isChecked = (answers.currentSymptoms || []).includes(opt.id);\\n                  return (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => toggleMultiSelect(\'currentSymptoms\', opt.id)}\\n                      className={`p-3 rounded-xl text-sm font-medium border text-left transition-all ${\\n                        isChecked\\n                          ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\\n                          : \'bg-white/[0.02] border-white/10 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n\\n            {/* Red Flag Symptoms in Calm Amber/Red Style */}\\n            <div className=\\\"p-4 rounded-xl bg-amber-500/[0.04] border border-amber-500/20 space-y-3\\\">\\n              <div className=\\\"flex items-center gap-2 text-amber-400\\\">\\n                <AlertTriangle className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span className=\\\"text-xs font-bold font-heading uppercase tracking-wider\\\">\\n                  Urgent Clinical Red Flags (Time-Sensitive)\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-[#9FB4BA]\\\">\\n                Select any of these if currently present. These warrant immediate same-day medical evaluation.\\n              </p>\\n              <div className=\\\"grid sm:grid-cols-2 gap-2\\\">\\n                {[\\n                  { id: \'severe_pain\', label: \'Sudden severe testicular pain\' },\\n                  { id: \'rapid_swelling\', label: \'Rapid swelling of the scrotum\' },\\n                  { id: \'fever_pain\', label: \'Fever accompanied by testicular ache\' },\\n                  { id: \'blood_in_semen\', label: \'Visible blood in semen\' },\\n                  { id: \'hard_painless_lump\', label: \'A hard, firm painless testicular lump\' },\\n                  { id: \'none\', label: \'None of these red flags apply\' }\\n                ].map(opt => {\\n                  const isChecked = (answers.redFlagSymptoms || []).includes(opt.id);\\n                  return (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => toggleMultiSelect(\'redFlagSymptoms\', opt.id)}\\n                      className={`p-2.5 rounded-lg text-sm font-medium border text-left transition-all ${\\n                        isChecked\\n                          ? \'bg-rose-500/20 border-rose-500 text-rose-300\'\\n                          : \'bg-black/20 border-white/5 text-[#9FB4BA] hover:border-amber-500/30\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* STEP 6: TEST RESULTS (OPTIONAL) */}\\n        {step === 6 && (\\n          <div className=\\\"space-y-6\\\">\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[#EAF4F4]\\\">{t.step6Title}</h2>\\n              <div className=\\\"p-3.5 bg-white/5 rounded-xl border border-white/10 text-sm text-[#9FB4BA] mt-2\\\">\\n                <strong>Completely Optional:</strong> If you do not have semen or hormone laboratory values, you can skip this step directly. HAYAT computes an accurate initial screening based on your lifestyle and medical history.\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-4\\\">\\n              <label className=\\\"text-sm font-semibold text-[#EAF4F4]\\\">Do you have semen analysis numbers to enter?</label>\\n              <div className=\\\"flex gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setAnswer(\'hasSemenAnalysis\', true)}\\n                  className={`px-4 py-2 rounded-lg text-sm font-medium border ${\\n                    answers.hasSemenAnalysis\\n                      ? \'bg-[#2DD4BF] text-[#07131A] border-[#2DD4BF]\'\\n                      : \'bg-white/5 text-[#9FB4BA] border-white/10\'\\n                  }`}\\n                >\\n                  Yes\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setAnswer(\'hasSemenAnalysis\', false)}\\n                  className={`px-4 py-2 rounded-lg text-sm font-medium border ${\\n                    answers.hasSemenAnalysis === false\\n                      ? \'bg-white/20 text-white border-white/30\'\\n                      : \'bg-white/5 text-[#9FB4BA] border-white/10\'\\n                  }`}\\n                >\\n                  No / Skip\\n                </button>\\n              </div>\\n            </div>\\n\\n            {answers.hasSemenAnalysis && (\\n              <div className=\\\"space-y-4 pt-3 border-t border-white/5\\\">\\n                <span className=\\\"text-xs font-mono text-[#2DD4BF]\\\">\\n                  WHO 2021 Reference Standards (Lower Limits)\\n                </span>\\n\\n                <div className=\\\"grid sm:grid-cols-2 gap-4\\\">\\n                  <div className=\\\"space-y-1\\\">\\n                    <label className=\\\"text-xs sm:text-sm text-[#EAF4F4]\\\">Ejaculate Volume (mL) - Ref: \342\211\245 1.4 mL</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      step=\\\"0.1\\\"\\n                      placeholder=\\\"e.g. 2.5\\\"\\n                      value={answers.semenVolume || \'\'}\\n                      onChange={e => setAnswer(\'semenVolume\', e.target.value ? parseFloat(e.target.value) : undefined)}\\n                      className=\\\"w-full px-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-sm text-white\\\"\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"space-y-1\\\">\\n                    <label className=\\\"text-xs sm:text-sm text-[#EAF4F4]\\\">Sperm Concentration (million/mL) - Ref: \342\211\245 16 M/mL</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      step=\\\"1\\\"\\n                      placeholder=\\\"e.g. 35\\\"\\n                      value={answers.spermConcentration || \'\'}\\n                      onChange={e => setAnswer(\'spermConcentration\', e.target.value ? parseFloat(e.target.value) : undefined)}\\n                      className=\\\"w-full px-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-sm text-white\\\"\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"space-y-1\\\">\\n                    <label className=\\\"text-xs sm:text-sm text-[#EAF4F4]\\\">Total Motility (%) - Ref: \342\211\245 42%</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      step=\\\"1\\\"\\n                      placeholder=\\\"e.g. 55\\\"\\n                      value={answers.totalMotility || \'\'}\\n                      onChange={e => setAnswer(\'totalMotility\', e.target.value ? parseFloat(e.target.value) : undefined)}\\n                      className=\\\"w-full px-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-sm text-white\\\"\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"space-y-1\\\">\\n                    <label className=\\\"text-xs sm:text-sm text-[#EAF4F4]\\\">Progressive Motility (%) - Ref: \342\211\245 30%</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      step=\\\"1\\\"\\n                      placeholder=\\\"e.g. 40\\\"\\n                      value={answers.progressiveMotility || \'\'}\\n                      onChange={e => setAnswer(\'progressiveMotility\', e.target.value ? parseFloat(e.target.value) : undefined)}\\n                      className=\\\"w-full px-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-sm text-white\\\"\\n                    />\\n                  </div>\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n\\n        {/* Wizard Navigation Footer */}\\n        <div className=\\\"flex items-center justify-between pt-4 border-t border-white/10\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleBack}\\n            className=\\\"px-4 py-2.5 rounded-xl border border-white/10 text-sm font-medium text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5 flex items-center gap-1.5 transition-colors\\\"\\n          >\\n            <ChevronLeft className=\\\"w-4 h-4\\\" />\\n            <span>{t.back}</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleNext}\\n            className=\\\"px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#2DD4BF] to-[#38BDF8] text-[#07131A] text-sm font-semibold font-heading hover:shadow-lg hover:shadow-[#2DD4BF]/20 flex items-center gap-1.5 transition-all\\\"\\n          >\\n            <span>{step === totalSteps ? t.seeScreening : t.next}</span>\\n            <ChevronRight className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Update WizardPage with conditional timeline logic, stress and substance inputs, waist concern, soft BMI display, and 3xl max-width\",\"Overwrite\":true,\"TargetFile\":\"/src/pages/WizardPage.tsx\",\"toolAction\":\"Updating WizardPage.tsx\",\"toolSummary\":\"Update WizardPage with conditional step logic and fields\"}"
      thinking_signature: "\022i\ng\001i\024}\0232\n\344\246\354\334\351/K\342\205;\245\021\3574t\177\f\352\272\334\237\344\373\032\016\2756\206\213!-<!$S\022?\263\b\370\323\314\245\'\002D\213\322\afa ?;\t\257\264\236\030x\2319l&2\311^\331[\333V?m\2435\000Y\237\237-\377\266\271\367\000\341\033\365\315\222.6S\266-%"
      original_name: "write_to_file"
