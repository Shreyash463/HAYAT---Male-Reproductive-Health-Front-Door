  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { motion } from \'motion/react\';\nimport { useApp } from \'../store/AppContext\';\nimport { Reveal, PathDraw, EASE_CALM, usePrefersReducedMotion } from \'../motion\';\nimport {\n  Lock,\n  CheckCircle2,\n  XCircle,\n  ArrowRight,\n  Info,\n  Smartphone,\n  ShieldCheck,\n  CloudOff,\n} from \'lucide-react\';\n\nexport const ConsentPage: React.FC = () => {\n  const { t, consent, updateConsent } = useApp();\n  const navigate = useNavigate();\n  const reduced = usePrefersReducedMotion();\n\n  const handleContinue = () => {\n    if (!consent.processAnswers) return;\n    navigate(\'/check\');\n  };\n\n  const permissions = [\n    {\n      key: \'processAnswers\' as const,\n      title: t.consentOpt1,\n      sub: \'Required to compute your on-device screening\',\n      required: true,\n    },\n    {\n      key: \'saveOnDevice\' as const,\n      title: t.consentOpt2,\n      sub: \"Stored only inside your browser\'s local cache. Clear anytime with one click.\",\n      required: false,\n    },\n    {\n      key: \'shareAnonymisedResearch\' as const,\n      title: t.consentOpt3,\n      sub: \'Aggregated, non-identifiable metrics to check algorithmic fairness across groups.\',\n      required: false,\n    },\n    {\n      key: \'createClinicianSummary\' as const,\n      title: t.consentOpt4,\n      sub: \'Prepares a printable PDF summary if you choose to bring one to an appointment.\',\n      required: false,\n    },\n  ];\n\n  return (\n    <div className=\"max-w-3xl mx-auto px-4 py-10 space-y-8\">\n      {/* Header */}\n      <Reveal className=\"text-center space-y-2.5\">\n        <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-text)] text-xs font-mono font-semibold border border-[var(--border-hairline)]\">\n          <Lock className=\"w-3.5 h-3.5\" />\n          <span>Privacy By Design</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl font-bold font-heading text-[var(--text-main)]\">\n          {t.consentTitle}\n        </h1>\n        <p className=\"text-base text-[var(--text-muted)] max-w-lg mx-auto leading-relaxed\">\n          {t.consentSub}\n        </p>\n      </Reveal>\n\n      {/* Animated SVG Explainer: Device + Shield showing answers stay on device */}\n      <Reveal delay={0.05} className=\"paper-card p-6 sm:p-7\">\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-6\">\n          <div className=\"space-y-1.5 text-center sm:text-start max-w-md\">\n            <span className=\"text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent-text)]\">\n              On-Device Architecture\n            </span>\n            <h2 className=\"text-lg font-bold font-heading text-[var(--text-main)]\">\n              Your answers stay inside your device\n            </h2>\n            <p className=\"text-sm text-[var(--text-muted)] leading-relaxed\">\n              Scoring runs inside your browser memory. Nothing is uploaded, tracked, or linked to your identity.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-3 shrink-0\" aria-hidden=\"true\">\n            <div className=\"flex flex-col items-center gap-1\">\n              <div className=\"w-14 h-14 rounded-2xl bg-[var(--accent-soft)] border border-[var(--accent)] flex items-center justify-center text-[var(--accent-text)]\">\n                <Smartphone className=\"w-6 h-6\" />\n              </div>\n              <span className=\"text-[11px] font-mono text-[var(--text-muted)]\">Your device</span>\n            </div>\n\n            <svg viewBox=\"0 0 110 48\" className=\"w-24 sm:w-28 h-12 overflow-visible\">\n              {/* Loop-back local processing arc */}\n              <PathDraw\n                d=\"M 10 24 C 24 6, 46 6, 56 24 C 46 42, 24 42, 14 26\"\n                stroke=\"var(--accent)\"\n                strokeWidth={2.5}\n                duration={0.9}\n              />\n              {/* Blocked cloud outbound dashed line */}\n              <PathDraw\n                d=\"M 64 24 L 100 24\"\n                stroke=\"var(--border-strong)\"\n                strokeWidth={2}\n                strokeDasharray=\"4 4\"\n                duration={0.7}\n                delay={0.2}\n              />\n              <line x1=\"78\" y1=\"16\" x2=\"88\" y2=\"32\" stroke=\"var(--risk-urg)\" strokeWidth=\"2.2\" strokeLinecap=\"round\" />\n              <line x1=\"88\" y1=\"16\" x2=\"78\" y2=\"32\" stroke=\"var(--risk-urg)\" strokeWidth=\"2.2\" strokeLinecap=\"round\" />\n            </svg>\n\n            <div className=\"flex flex-col items-center gap-1\">\n              <div className=\"w-12 h-12 rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] flex items-center justify-center text-[var(--text-muted)]\">\n                <CloudOff className=\"w-5 h-5\" />\n              </div>\n              <span className=\"text-[11px] font-mono text-[var(--text-muted)]\">No upload</span>\n            </div>\n\n            <div className=\"hidden sm:flex flex-col items-center gap-1 ms-1\">\n              <div className=\"w-12 h-12 rounded-2xl bg-[var(--risk-low-bg)] border border-[var(--risk-low-border)] flex items-center justify-center text-[var(--risk-low)]\">\n                <ShieldCheck className=\"w-5 h-5\" />\n              </div>\n              <span className=\"text-[11px] font-mono text-[var(--risk-low)]\">Local shield</span>\n            </div>\n          </div>\n        </div>\n      </Reveal>\n\n      {/* Comparison Cards */}\n      <div className=\"grid md:grid-cols-2 gap-4\">\n        <Reveal delay={0.08} className=\"paper-card p-6 space-y-3 border-t-4\" style={{ borderTopColor: \'var(--accent)\' }}>\n          <div className=\"flex items-center gap-2 text-[var(--accent-text)]\">\n            <CheckCircle2 className=\"w-5 h-5 shrink-0\" />\n            <h2 className=\"font-heading font-bold text-sm tracking-wide uppercase\">\n              {t.whatWeDo}\n            </h2>\n          </div>\n          <ul className=\"space-y-2.5 text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[var(--accent-text)] font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo1}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[var(--accent-text)] font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo2}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[var(--accent-text)] font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo3}</span>\n            </li>\n          </ul>\n        </Reveal>\n\n        <Reveal delay={0.14} className=\"paper-card p-6 space-y-3 border-t-4\" style={{ borderTopColor: \'var(--risk-urg)\' }}>\n          <div className=\"flex items-center gap-2\" style={{ color: \'var(--risk-urg)\' }}>\n            <XCircle className=\"w-5 h-5 shrink-0\" />\n            <h2 className=\"font-heading font-bold text-sm tracking-wide uppercase\">\n              {t.whatWeNeverDo}\n            </h2>\n          </div>\n          <ul className=\"space-y-2.5 text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">\n            <li className=\"flex items-start gap-2\">\n              <span style={{ color: \'var(--risk-urg)\' }} className=\"font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever1}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span style={{ color: \'var(--risk-urg)\' }} className=\"font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever2}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span style={{ color: \'var(--risk-urg)\' }} className=\"font-bold mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever3}</span>\n            </li>\n          </ul>\n        </Reveal>\n      </div>\n\n      {/* Animated Toggle Switches */}\n      <Reveal delay={0.18} className=\"paper-card p-6 sm:p-8 space-y-5\">\n        <h3 className=\"font-heading font-bold text-lg text-[var(--text-main)]\">\n          Select your data permissions:\n        </h3>\n\n        <div className=\"space-y-3\">\n          {permissions.map(perm => {\n            const checked = consent[perm.key];\n            return (\n              <button\n                key={perm.key}\n                type=\"button\"\n                role=\"switch\"\n                aria-checked={checked}\n                onClick={() => updateConsent({ [perm.key]: !checked })}\n                className={`w-full text-start flex items-center justify-between gap-4 p-4 min-h-[60px] rounded-2xl border transition-colors cursor-pointer ${\n                  checked\n                    ? \'bg-[var(--accent-soft)] border-[var(--accent)]\'\n                    : \'bg-[var(--surface)] border-[var(--border-hairline)] hover:border-[var(--border-strong)]\'\n                }`}\n              >\n                <div className=\"text-sm sm:text-base pe-2\">\n                  <span className=\"font-semibold text-[var(--text-main)] block\">\n                    {perm.title}\n                  </span>\n                  <span\n                    className={`text-xs sm:text-sm mt-0.5 block ${\n                      perm.required ? \'text-[var(--accent-text)] font-medium\' : \'text-[var(--text-muted)]\'\n                    }`}\n                  >\n                    {perm.sub}\n                  </span>\n                </div>\n\n                {/* Animated Switch + Confirmation Checkmark */}\n                <div className=\"flex items-center gap-2.5 shrink-0\">\n                  {checked && (\n                    <svg viewBox=\"0 0 20 20\" className=\"w-5 h-5 text-[var(--accent-text)]\" aria-hidden=\"true\">\n                      <motion.path\n                        d=\"M 4 10.5 L 8 14.5 L 16 6\"\n                        fill=\"none\"\n                        stroke=\"currentColor\"\n                        strokeWidth={2.3}\n                        strokeLinecap=\"round\"\n                        strokeLinejoin=\"round\"\n                        initial={reduced ? { pathLength: 1 } : { pathLength: 0 }}\n                        animate={{ pathLength: 1 }}\n                        transition={reduced ? { duration: 0 } : { duration: 0.25, ease: EASE_CALM }}\n                      />\n                    </svg>\n                  )}\n                  <div\n                    className={`w-12 h-7 rounded-full p-1 transition-colors flex items-center ${\n                      checked ? \'bg-[var(--accent)]\' : \'bg-[var(--border-strong)]\'\n                    }`}\n                    aria-hidden=\"true\"\n                  >\n                    <motion.div\n                      layout={!reduced}\n                      transition={reduced ? { duration: 0 } : { duration: 0.24, ease: EASE_CALM }}\n                      className={`w-5 h-5 rounded-full bg-white shadow-xs ${\n                        checked ? \'ms-auto\' : \'me-auto\'\n                      }`}\n                    />\n                  </div>\n                </div>\n              </button>\n            );\n          })}\n        </div>\n\n        <div className=\"p-4 rounded-2xl bg-[var(--card-alt)] border border-[var(--border-hairline)] flex items-start gap-2.5 text-sm text-[var(--text-muted)]\">\n          <Info className=\"w-4 h-4 text-[var(--brand)] shrink-0 mt-1\" />\n          <span>{t.dataMinimisationNote}</span>\n        </div>\n      </Reveal>\n\n      {/* Animated Continue Bar */}\n      <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4 pt-1\">\n        <span className=\"text-xs sm:text-sm text-[var(--text-muted)] font-mono\">\n          {consent.timestamp ? `Recorded: ${new Date(consent.timestamp).toLocaleTimeString()}` : \'\'}\n        </span>\n\n        <motion.button\n          type=\"button\"\n          onClick={handleContinue}\n          disabled={!consent.processAnswers}\n          animate={{\n            scale: consent.processAnswers ? 1 : 0.985,\n            opacity: consent.processAnswers ? 1 : 0.65,\n          }}\n          transition={reduced ? { duration: 0 } : { duration: 0.3, ease: EASE_CALM }}\n          className={`w-full sm:w-auto px-8 min-h-[52px] rounded-2xl font-heading font-semibold text-base flex items-center justify-center gap-2 transition-colors ${\n            consent.processAnswers\n              ? \'bg-[var(--accent)] text-white hover:opacity-95 shadow-sm cursor-pointer\'\n              : \'bg-[var(--brand-soft)] text-[var(--text-muted)] cursor-not-allowed\'\n          }`}\n        >\n          <span>{t.btnUnderstandContinue}</span>\n          <ArrowRight className=\"w-4 h-4 rtl:rotate-180\" />\n        </motion.button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/ConsentPage.tsx"
        }
        overwrite: true
      }
    }
