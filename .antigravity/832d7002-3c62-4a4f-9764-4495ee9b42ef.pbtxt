      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { \\n  AssessmentAnswers, \\n  AssessmentResult, \\n  ConsentSettings, \\n  SyntheticCohortMetrics, \\n  Clinic, \\n  AccessLogItem, \\n  Language \\n} from \'../types\';\\nimport { assessRisk } from \'../engine/riskEngine\';\\nimport { generateSyntheticCohort, MOCK_CLINICS } from \'../data/syntheticCohort\';\\n\\n/**\\n * Service Layer for HAYAT\\n * Designed for clean plug-and-play backend migration.\\n * Set VITE_USE_MOCK=false and define VITE_API_BASE to connect a real REST/GraphQL microservice.\\n */\\n\\nconst USE_MOCK = import.meta.env.VITE_USE_MOCK !== \'false\';\\nconst API_BASE = import.meta.env.VITE_API_BASE || \'/api\';\\n\\nconst delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));\\n\\nexport async function assess(answers: AssessmentAnswers): Promise<AssessmentResult> {\\n  if (USE_MOCK) {\\n    // Realistic computation delay\\n    await delay(1200);\\n    return assessRisk(answers);\\n  }\\n\\n  // TODO: Replace with real backend endpoint POST /api/assess\\n  const res = await fetch(`${API_BASE}/assess`, {\\n    method: \'POST\',\\n    headers: { \'Content-Type\': \'application/json\' },\\n    body: JSON.stringify(answers)\\n  });\\n  if (!res.ok) throw new Error(\'Failed to compute screening assessment\');\\n  return res.json();\\n}\\n\\nexport async function explain(\\n  result: AssessmentResult, \\n  mode: \'simple\' | \'detailed\', \\n  language: Language\\n): Promise<string> {\\n  if (USE_MOCK) {\\n    await delay(200);\\n    if (language === \'ar\') {\\n      return mode === \'simple\'\\n        ? `\331\207\330\260\331\207 \330\247\331\204\331\206\330\252\331\212\330\254\330\251 (${result.band}) \330\252\330\263\330\252\331\206\330\257 \330\245\331\204\331\211 ${result.factors.length} \330\271\331\210\330\247\331\205\331\204 \331\205\330\244\330\253\330\261\330\251 \330\252\331\205 \330\252\330\255\330\257\331\212\330\257\331\207\330\247\330\214 \331\205\330\271 ${result.favourableFactors.length} \330\271\331\210\330\247\331\205\331\204 \330\245\331\212\330\254\330\247\330\250\331\212\330\251 \331\205\330\267\331\205\330\246\331\206\330\251.`\\n        : `\330\247\331\204\330\252\330\255\331\204\331\212\331\204 \330\247\331\204\330\252\331\201\330\265\331\212\331\204\331\212 \331\212\330\270\331\207\330\261 \330\243\331\206 \330\247\331\204\330\271\331\210\330\247\331\205\331\204 \330\247\331\204\330\243\331\203\330\253\330\261 \330\252\330\243\330\253\331\212\330\261\330\247\331\213 \331\207\331\212: ${result.factors.slice(0, 3).map(f => f.label).join(\'\330\214 \')}. \331\210\331\206\331\206\330\265\330\255 \330\250\331\205\330\252\330\247\330\250\330\271\330\251 \330\247\331\204\331\205\330\263\330\247\330\261 \330\247\331\204\331\205\331\210\330\265\331\211 \330\250\331\207: ${result.triage}.`;\\n    }\\n    if (language === \'hi\') {\\n      return mode === \'simple\'\\n        ? `\340\244\257\340\244\271 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 (${result.band}) \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276 \340\244\270\340\244\276\340\244\235\340\244\276 \340\244\225\340\244\277\340\244\217 \340\244\227\340\244\217 ${result.factors.length} \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\225\340\244\276\340\244\260\340\244\225\340\245\213\340\244\202 \340\244\252\340\244\260 \340\244\206\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 \340\244\271\340\245\210, \340\244\234\340\244\254\340\244\225\340\244\277 ${result.favourableFactors.length} \340\244\225\340\244\276\340\244\260\340\244\225 \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\252\340\244\225\340\245\215\340\244\267 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\225\340\244\276\340\244\260\340\244\276\340\244\244\340\245\215\340\244\256\340\244\225 \340\244\271\340\245\210\340\244\202\340\245\244`\\n        : `\340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243: \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225 \340\244\225\340\244\276\340\244\260\340\244\225 \340\244\271\340\245\210\340\244\202: ${result.factors.slice(0, 3).map(f => f.label).join(\', \')}. \340\244\205\340\244\250\340\245\201\340\244\266\340\244\202\340\244\270\340\244\277\340\244\244 \340\244\246\340\245\207\340\244\226\340\244\255\340\244\276\340\244\262 \340\244\270\340\245\215\340\244\244\340\244\260: ${result.triage}.`;\\n    }\\n    return mode === \'simple\'\\n      ? `This screening result (${result.band}) is derived from ${result.factors.length} identified factors, balanced by ${result.favourableFactors.length} reassuring favourable habits.`\\n      : `Detailed breakdown: Primary contributing factors include ${result.factors.slice(0, 3).map(f => f.label).join(\', \')}. Triage guidance directs to: ${result.triage}.`;\\n  }\\n\\n  // TODO: Replace with real backend endpoint POST /api/explain\\n  const res = await fetch(`${API_BASE}/explain`, {\\n    method: \'POST\',\\n    headers: { \'Content-Type\': \'application/json\' },\\n    body: JSON.stringify({ result, mode, language })\\n  });\\n  return (await res.json()).explanation;\\n}\\n\\nexport async function saveConsent(consent: ConsentSettings): Promise<{ success: boolean; timestamp: string }> {\\n  const timestamp = new Date().toISOString();\\n  if (USE_MOCK) {\\n    await delay(150);\\n    return { success: true, timestamp };\\n  }\\n\\n  // TODO: Replace with real backend endpoint POST /api/consent\\n  const res = await fetch(`${API_BASE}/consent`, {\\n    method: \'POST\',\\n    headers: { \'Content-Type\': \'application/json\' },\\n    body: JSON.stringify({ ...consent, timestamp })\\n  });\\n  return res.json();\\n}\\n\\nexport async function getConsentLog(): Promise<AccessLogItem[]> {\\n  if (USE_MOCK) {\\n    await delay(100);\\n    return [\\n      { id: \'1\', timestamp: new Date(Date.now() - 3600000).toISOString(), action: \'Session Initialized\', detail: \'Local ephemeral token created\' },\\n      { id: \'2\', timestamp: new Date(Date.now() - 1800000).toISOString(), action: \'Consent Registered\', detail: \'User enabled processing consent\' }\\n    ];\\n  }\\n\\n  // TODO: Replace with real backend endpoint GET /api/consent-log\\n  const res = await fetch(`${API_BASE}/consent-log`);\\n  return res.json();\\n}\\n\\nexport async function deleteAllData(): Promise<{ success: boolean }> {\\n  if (USE_MOCK) {\\n    await delay(200);\\n    return { success: true };\\n  }\\n\\n  // TODO: Replace with real backend endpoint DELETE /api/data\\n  const res = await fetch(`${API_BASE}/data`, { method: \'DELETE\' });\\n  return res.json();\\n}\\n\\nexport async function exportData(answers: AssessmentAnswers | null, result: AssessmentResult | null, consent: ConsentSettings): Promise<string> {\\n  const payload = {\\n    exportedAt: new Date().toISOString(),\\n    protocol: \'HAYAT-V1-STANDARDS\',\\n    consent,\\n    answers: answers || {},\\n    screeningResult: result || null,\\n    complianceNote: \'Exported under explicit user unilateral control.\'\\n  };\\n  return JSON.stringify(payload, null, 2);\\n}\\n\\nexport async function getEvidence(): Promise<SyntheticCohortMetrics> {\\n  if (USE_MOCK) {\\n    await delay(300);\\n    return generateSyntheticCohort();\\n  }\\n\\n  // TODO: Replace with real backend endpoint GET /api/evidence\\n  const res = await fetch(`${API_BASE}/evidence`);\\n  return res.json();\\n}\\n\\nexport async function getClinics(filters?: { maleFriendly?: boolean; privateEntrance?: boolean }): Promise<Clinic[]> {\\n  if (USE_MOCK) {\\n    await delay(250);\\n    let list = [...MOCK_CLINICS];\\n    if (filters?.maleFriendly) {\\n      list = list.filter(c => c.features.maleFriendly);\\n    }\\n    if (filters?.privateEntrance) {\\n      list = list.filter(c => c.features.privateEntrance);\\n    }\\n    return list;\\n  }\\n\\n  // TODO: Replace with real backend endpoint GET /api/clinics\\n  const query = new URLSearchParams(filters as any).toString();\\n  const res = await fetch(`${API_BASE}/clinics?${query}`);\\n  return res.json();\\n}\\n\\nexport async function bookTeleconsult(slot: { clinicId: string; date: string; time: string; discreetLabel: boolean }): Promise<{ bookingId: string; status: string }> {\\n  if (USE_MOCK) {\\n    await delay(400);\\n    return {\\n      bookingId: `TC-${Math.floor(100000 + Math.random() * 900000)}`,\\n      status: \'confirmed_discreet\'\\n    };\\n  }\\n\\n  // TODO: Replace with real backend endpoint POST /api/teleconsult\\n  const res = await fetch(`${API_BASE}/teleconsult`, {\\n    method: \'POST\',\\n    headers: { \'Content-Type\': \'application/json\' },\\n    body: JSON.stringify(slot)\\n  });\\n  return res.json();\\n}\\n\",\"Description\":\"Create clean service layer with mock implementations and API contracts\",\"Overwrite\":true,\"TargetFile\":\"/src/services/api.ts\",\"toolAction\":\"Creating api.ts\",\"toolSummary\":\"Create service layer\"}"
