            }
            lines {
              text: "    val: formatLabel(answers.familyPlanning),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    storage: \'Local browser memory\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    purpose: \'Guides whether the review focuses on long-term wellness or active conception timelines.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Trying duration (ONLY if trying)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (answers.familyPlanning === \'trying\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
