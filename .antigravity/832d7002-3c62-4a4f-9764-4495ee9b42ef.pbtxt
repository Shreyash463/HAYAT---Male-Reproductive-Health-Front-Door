  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { EASE_CALM, DURATIONS } from \'./config\';\nimport { usePrefersReducedMotion } from \'./usePrefersReducedMotion\';\n\ninterface SplitTextProps {\n  text: string;\n  className?: string;\n  delay?: number;\n  stagger?: number;\n  accentPhrase?: string;\n  accentClassName?: string;\n}\n\n/**\n * Accessible word/line reveal:\n * Keeps full unbroken text in an sr-only span for screen readers,\n * and animates visual tokens with aria-hidden=\"true\".\n */\nexport const SplitText: React.FC<SplitTextProps> = ({\n  text,\n  className = \'\',\n  delay = 0.05,\n  stagger = 0.045,\n  accentPhrase,\n  accentClassName = \'font-serif-accent italic font-normal text-[var(--brand)]\',\n}) => {\n  const reduced = usePrefersReducedMotion();\n\n  const words = text.split(\' \');\n  const accentWords = accentPhrase ? accentPhrase.toLowerCase().split(\' \') : [];\n\n  const isWordInAccent = (index: number) => {\n    if (accentWords.length === 0) return false;\n    for (let start = Math.max(0, index - accentWords.length + 1); start <= index; start++) {\n      if (start + accentWords.length > words.length) continue;\n      let match = true;\n      for (let j = 0; j < accentWords.length; j++) {\n        const cleanWord = words[start + j].toLowerCase().replace(/[.,!?]/g, \'\');\n        if (cleanWord !== accentWords[j]) {\n          match = false;\n          break;\n        }\n      }\n      if (match) return true;\n    }\n    return false;\n  };\n\n  if (reduced) {\n    return (\n      <span className={className}>\n        <span className=\"sr-only\">{text}</span>\n        <span aria-hidden=\"true\">\n          {words.map((word, i) => (\n            <span\n              key={i}\n              className={`inline-block me-[0.26em] ${isWordInAccent(i) ? accentClassName : \'\'}`}\n            >\n              {word}\n            </span>\n          ))}\n        </span>\n      </span>\n    );\n  }\n\n  return (\n    <span className={className}>\n      <span className=\"sr-only\">{text}</span>\n      <span aria-hidden=\"true\">\n        {words.map((word, i) => {\n          const isAccent = isWordInAccent(i);\n          return (\n            <span key={i} className=\"inline-block overflow-hidden align-bottom me-[0.26em] py-[0.06em]\">\n              <motion.span\n                className={`inline-block ${isAccent ? accentClassName : \'\'}`}\n                initial={{ opacity: 0, y: \'100%\' }}\n                animate={{ opacity: 1, y: \'0%\' }}\n                transition={{\n                  duration: DURATIONS.base,\n                  delay: delay + i * stagger,\n                  ease: EASE_CALM,\n                }}\n              >\n                {word}\n              </motion.span>\n            </span>\n          );\n        })}\n      </span>\n    </span>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/motion/SplitText.tsx"
        }
        overwrite: true
      }
    }
