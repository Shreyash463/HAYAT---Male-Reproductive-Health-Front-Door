    end_line: 100
    content: "import React from \'react\';\nimport { useApp } from \'../store/AppContext\';\nimport { Droplet, Moon, Activity, ArrowRight, ShieldCheck, Heart } from \'lucide-react\';\n\nexport const QuickHideScreen: React.FC = () => {\n  const { exitQuickHide, t } = useApp();\n\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] text-[#1E293B] p-6 flex flex-col justify-between selection:bg-blue-100 font-sans\">\n      <div className=\"max-w-3xl mx-auto w-full pt-8\">\n        {/* Disguised Header */}\n        <div className=\"flex items-center justify-between pb-6 border-b border-slate-200\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-teal-600 flex items-center justify-center text-white\">\n              <Activity className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h1 className=\"text-lg font-bold text-slate-800\">Everyday Wellness Journal</h1>\n              <p className=\"text-xs text-slate-500\">Daily balance, water intake & vitality tracking</p>\n            </div>\n          </div>\n\n          {/* Discreet return button */}\n          <button\n            onClick={exitQuickHide}\n            className=\"text-xs text-slate-400 hover:text-slate-600 px-3 py-1.5 rounded border border-slate-200 hover:border-slate-300 transition-colors flex items-center gap-1\"\n          >\n            <span>{t.returnToHayat}</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Harmless Wellness Cards */}\n        <div className=\"mt-8 grid md:grid-cols-3 gap-6\">\n          <div className=\"bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center\">\n              <Droplet className=\"w-5 h-5\" />\n            </div>\n            <h2 className=\"font-semibold text-slate-800 text-sm\">Optimal Hydration</h2>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Drinking 2.5L of mineral water throughout the morning helps maintain cognitive speed and regulates cellular exchange.\n            </p>\n            <div className=\"mt-auto pt-2\">\n              <div className=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\">\n                <div className=\"h-full bg-blue-500 w-3/4 rounded-full\" />\n              </div>\n              <span className=\"text-[11px] text-slate-400 mt-1 inline-block\">1.9L of 2.5L target</span>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center\">\n              <Moon className=\"w-5 h-5\" />\n            </div>\n            <h2 className=\"font-semibold text-slate-800 text-sm\">Circadian Rhythm</h2>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Dimming screen lights 45 minutes before sleep stimulates melatonin synthesis, ensuring deep slow-wave restorative sleep.\n            </p>\n            <span className=\"mt-auto text-[11px] font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded w-fit\">\n              Healthy rhythm\n            </span>\n          </div>\n\n          <div className=\"bg-white p-5 rounded-2xl shadow-sm border border-slate-100 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n              <Heart className=\"w-5 h-5\" />\n            </div>\n            <h2 className=\"font-semibold text-slate-800 text-sm\">Active Movement</h2>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              A 20-minute brisk walk after lunch reduces glucose spikes by up to 22% and lowers resting vascular tension.\n            </p>\n            <span className=\"mt-auto text-[11px] font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded w-fit\">\n              6,420 steps today\n            </span>\n          </div>\n        </div>\n\n        {/* Generic Article snippet */}\n        <div className=\"mt-8 bg-white p-6 rounded-2xl border border-slate-100 shadow-sm\">\n          <h3 className=\"font-semibold text-sm text-slate-800 mb-2\">Three daily micro-habits for sustained clarity</h3>\n          <ul className=\"text-xs text-slate-600 space-y-2 list-disc list-inside\">\n            <li>Step outside into natural daylight within 30 minutes of waking.</li>\n            <li>Take a 90-second posture reset after every 50 minutes of desk work.</li>\n            <li>Replace the afternoon third coffee with chamomile or cooled peppermint tea.</li>\n          </ul>\n        </div>\n      </div>\n\n      <div className=\"max-w-3xl mx-auto w-full pt-8 pb-4 border-t border-slate-200 flex items-center justify-between text-xs text-slate-400\">\n        <span>Daily Health Magazine \342\200\242 Universal Reader</span>\n        <button\n          onClick={exitQuickHide}\n          className=\"text-slate-500 hover:text-slate-800 underline font-medium\"\n        >\n          {t.returnToHayat}\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 101
    num_bytes: 5130
    line_range_bytes: 5130
  }
}
