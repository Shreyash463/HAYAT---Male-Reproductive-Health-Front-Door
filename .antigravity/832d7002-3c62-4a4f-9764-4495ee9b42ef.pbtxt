        instruction: "import React from \'react\';\nimport { AssessmentResult, AssessmentAnswers } from \'../types\';\nimport { Printer, Download, X, Shield, Calendar, UserCheck, Stethoscope } from \'lucide-react\';\n\ninterface ClinicianSummaryModalProps {\n  result: AssessmentResult;\n  answers: AssessmentAnswers;\n  onClose: () => void;\n}\n\nexport const ClinicianSummaryModal: React.FC<ClinicianSummaryModalProps> = ({\n  result,\n  answers,\n  onClose\n}) => {\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md overflow-y-auto\">\n      <div className=\"relative w-full max-w-3xl my-8 bg-[#0D1F29] border border-white/10 rounded-2xl shadow-2xl text-[#EAF4F4] overflow-hidden\">\n        {/* Modal Controls (Not printed) */}\n        <div className=\"no-print p-4 bg-[#132B38] border-b border-white/10 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Stethoscope className=\"w-5 h-5 text-[#2DD4BF]\" />\n            <span className=\"font-heading font-semibold text-sm\">Clinician-Ready Assessment Summary</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handlePrint}\n              className=\"px-3 py-1.5 rounded-lg bg-[#2DD4BF] text-[#07131A] text-xs font-semibold hover:bg-[#2DD4BF]/90 flex items-center gap-1.5 transition-colors\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Print / Save as PDF</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-lg text-[#9FB4BA] hover:text-white hover:bg-white/10 transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Printable Document Body */}\n        <div className=\"p-8 space-y-6 bg-white text-slate-900 rounded-b-2xl\">\n          {/* Header */}\n          <div className=\"border-b border-slate-200 pb-4 flex items-start justify-between\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xl font-bold font-heading tracking-wide text-teal-800\">\n                  HAYAT CLINICAL SUMMARY\n                </span>\n                <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 bg-slate-100 rounded text-slate-600 border border-slate-200\">\n                  Patient-Initiated Front Door\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 mt-1\">\n                Generated at patient request to facilitate clinician dialogue during initial consultation.\n              </p>\n            </div>\n            <div className=\"text-right text-xs text-slate-500 font-mono\">\n              <div className=\"flex items-center justify-end gap-1\">\n                <Calendar className=\"w-3.5 h-3.5 text-slate-400\" />\n                <span>{new Date(result.calculatedAt).toLocaleDateString()}</span>\n              </div>\n              <span className=\"text-[11px] text-teal-700 font-medium\">De-identified Patient Record</span>\n            </div>\n          </div>\n\n          {/* Screening vs Diagnosis Disclaimer for Clinicians */}\n          <div className=\"p-3 bg-teal-50 border border-teal-200 rounded-lg text-xs text-teal-900 leading-relaxed\">\n            <strong>Clinical Notice:</strong> This summary represents self-reported signals and algorithm-assisted triage based on international andrology guidelines. It does not constitute a clinical diagnosis or treatment order.\n          </div>\n\n          {/* Primary Signals Summary */}\n          <div className=\"grid grid-cols-3 gap-4\">\n            <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">\n              <div className=\"text-[11px] text-slate-500 uppercase font-semibold\">Triage Stratum</div>\n              <div className=\"text-sm font-bold text-slate-900 mt-0.5\">{result.triage}</div>\n              <div className=\"text-[11px] text-slate-600 mt-1\">{result.triageReason}</div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">\n              <div className=\"text-[11px] text-slate-500 uppercase font-semibold\">Risk Stratum</div>\n              <div className=\"text-sm font-bold text-teal-700 mt-0.5\">{result.band} Risk Band</div>\n              <div className=\"text-[11px] text-slate-600 mt-1\">Score: {result.score}/100</div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">\n              <div className=\"text-[11px] text-slate-500 uppercase font-semibold\">Reported Family Goal</div>\n              <div className=\"text-sm font-bold text-slate-900 mt-0.5 capitalize\">\n                {answers.familyPlanning ? answers.familyPlanning.replace(\'_\', \' \') : \'Not stated\'}\n              </div>\n              {answers.tryingDuration && (\n                <div className=\"text-[11px] text-slate-600 mt-1\">Duration: {answers.tryingDuration.replace(\'_\', \' \')}</div>\n              )}\n            </div>\n          </div>\n\n          {/* Red Flag Alerts */}\n          {result.redFlags.length > 0 && (\n            <div className=\"p-3 bg-rose-50 border border-rose-300 rounded-lg text-xs text-rose-900\">\n              <strong className=\"block font-semibold mb-1 text-rose-800\">Reported Acute / Red-Flag Symptoms:</strong>\n              <ul className=\"list-disc list-inside space-y-0.5\">\n                {result.redFlags.map((rf, i) => (\n                  <li key={i}>{rf}</li>\n                ))}\n              </ul>\n            </div>\n          )}\n\n          {/* Primary Clinical Drivers */}\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\n              Primary Contributing Factors\n            </h3>\n            <div className=\"border border-slate-200 rounded-lg overflow-hidden text-xs\">\n              <table className=\"w-full text-left\">\n                <thead className=\"bg-slate-100 text-slate-600 border-b border-slate-200\">\n                  <tr>\n                    <th className=\"p-2 font-semibold\">Factor / Area</th>\n                    <th className=\"p-2 font-semibold\">Reported Detail</th>\n                    <th className=\"p-2 font-semibold\">Reversibility</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-100\">\n                  {result.factors.map(f => (\n                    <tr key={f.id}>\n                      <td className=\"p-2 font-medium text-slate-800\">{f.label}</td>\n                      <td className=\"p-2 text-slate-600 font-mono text-[11px]\">{f.userValue}</td>\n                      <td className=\"p-2\">\n                        <span className={`px-2 py-0.5 rounded text-[10px] font-medium ${\n                          f.modifiable ? \'bg-teal-100 text-teal-800\' : \'bg-slate-100 text-slate-600\'\n                        }`}>\n                          {f.modifiable ? \'Modifiable\' : \'Non-modifiable\'}\n                        </span>\n                      </td>\n                    </tr>\n                  ))}\n                  {result.factors.length === 0 && (\n                    <tr>\n                      <td colSpan={3} className=\"p-3 text-center text-slate-500 italic\">\n                        No significant negative risk factors reported.\n                      </td>\n                    </tr>\n                  )}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          {/* Questions Prepared for Consultation */}\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-700 mb-2\">\n              Patient Questions Prepared For Discussion\n            </h3>\n            <ul className=\"list-disc list-inside text-xs text-slate-700 space-y-1\">\n              {result.doctorQuestions.map((q, i) => (\n                <li key={i}>{q}</li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Footer of Printable Summary */}\n          <div className=\"pt-4 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-400\">\n            <span>HAYAT Clinical Bridge \342\200\242 Microsoft / Inception / MBZUAI Challenge</span>\n            <span>Page 1 of 1</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
