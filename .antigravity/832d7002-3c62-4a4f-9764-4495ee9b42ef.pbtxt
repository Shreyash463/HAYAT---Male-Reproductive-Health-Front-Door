    content: "import React from \'react\';\nimport { ShieldCheck, Info } from \'lucide-react\';\nimport { useApp } from \'../store/AppContext\';\n\nexport const SafetyFooter: React.FC = () => {\n  const { t } = useApp();\n\n  return (\n    <footer className=\"mt-auto border-t border-white/5 bg-[#07131A]/90 py-6 px-4 transition-colors\">\n      <div className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#9FB4BA]\">\n        <div className=\"flex items-center gap-2\">\n          <ShieldCheck className=\"w-4 h-4 text-[#2DD4BF] shrink-0\" />\n          <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-[11px] font-medium border border-[#2DD4BF]/20\">\n            {t.safetyBadge}\n          </span>\n        </div>\n\n        <p className=\"text-center md:text-left max-w-2xl leading-relaxed text-[11px] text-[#9FB4BA]/90\">\n          <Info className=\"inline w-3 h-3 mr-1 text-[#E8D5B5]\" />\n          {t.safetyDisclaimer}\n        </p>\n\n        <div className=\"text-[11px] text-white/40 font-mono\">\n          Abu Dhabi Innovation Challenge 2026\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    num_lines: 30
    num_bytes: 1162
    line_range_bytes: 1162
  }
}
