  view_file {
    absolute_path_uri: "file:///src/pages/CareNavigatorPage.tsx"
    end_line: 336
    content: "import React, { useState } from \'react\';\nimport { useApp } from \'../store/AppContext\';\nimport { MOCK_CLINICS } from \'../data/syntheticCohort\';\nimport { Clinic } from \'../types\';\nimport { bookTeleconsult } from \'../services/api\';\nimport { \n  Stethoscope, \n  MapPin, \n  Video, \n  Calendar, \n  CheckCircle2, \n  CheckCircle, \n  Phone\n} from \'lucide-react\';\n\nexport const CareNavigatorPage: React.FC = () => {\n  const { t, result, referralStep, setReferralStep, addLog } = useApp();\n\n  const [maleFriendlyOnly, setMaleFriendlyOnly] = useState(false);\n  const [privateEntranceOnly, setPrivateEntranceOnly] = useState(false);\n\n  // Teleconsultation state\n  const [selectedDate, setSelectedDate] = useState(\'2026-11-09\');\n  const [selectedTime, setSelectedTime] = useState(\'18:30 (Evening)\');\n  const [discreetLabel, setDiscreetLabel] = useState(true);\n  const [bookingConfirmed, setBookingConfirmed] = useState<{ id: string } | null>(null);\n\n  // Filter clinics\n  const filteredClinics = MOCK_CLINICS.filter(clinic => {\n    if (maleFriendlyOnly && !clinic.features.maleFriendly) return false;\n    if (privateEntranceOnly && !clinic.features.privateEntrance) return false;\n    return true;\n  });\n\n  const handleBookTeleconsult = async (clinicId: string) => {\n    const res = await bookTeleconsult({\n      clinicId,\n      date: selectedDate,\n      time: selectedTime,\n      discreetLabel\n    });\n    setBookingConfirmed({ id: res.bookingId });\n    setReferralStep(1); // Set tracker to \"Booked\"\n    addLog(\'Teleconsultation Requested\', `Booking ref: ${res.bookingId} (Discreet billing: ${discreetLabel})`);\n  };\n\n  const currentTriage = result?.triage || \'Primary care\';\n\n  const pathwaySteps = [\n    { title: \'Screened\', desc: \'Completed online assessment\' },\n    { title: \'Booked\', desc: \'Consultation appointment scheduled\' },\n    { title: \'Assessed\', desc: \'Clinical evaluation with medical doctor\' },\n    { title: \'Follow-up\', desc: \'Review of lab tests or treatment response\' }\n  ];\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-10\">\n      {/* Header */}\n      <div className=\"space-y-2\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-xs font-mono font-medium border border-[#2DD4BF]/20\">\n          <Stethoscope className=\"w-3.5 h-3.5\" />\n          <span>Care Navigation Service</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#EAF4F4]\">\n          {t.careNavTitle}\n        </h1>\n        <p className=\"text-sm text-[#9FB4BA]\">\n          {t.careNavSub}\n        </p>\n      </div>\n\n      {/* Pathway Cards tailored to user\'s triage level */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n            Your Recommended Pathway: <span className=\"text-[#2DD4BF]\">{currentTriage}</span>\n          </h2>\n          <span className=\"text-xs font-mono px-2 py-0.5 rounded bg-white/5 text-[#9FB4BA]\">\n            Standardized Guidelines\n          </span>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 gap-3\">\n          <div className=\"p-4 rounded-xl bg-white/[0.02] border border-white/5 space-y-1.5\">\n            <span className=\"text-sm font-semibold text-white block\">{t.whatToExpect}</span>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              A private, non-judgemental conversation focusing on your health history, timeline, and routine blood or semen diagnostics.\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-white/[0.02] border border-white/5 space-y-1.5\">\n            <span className=\"text-sm font-semibold text-white block\">{t.typicalVisit}</span>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              Initial 30-minute consultation. If a physical exam is appropriate, your comfort and privacy are strictly respected.\n            </p>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-white/[0.02] border border-white/5 space-y-1.5\">\n            <span className=\"text-sm font-semibold text-white block\">{t.howToPrepare}</span>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n              Bring your HAYAT Clinician Summary, note any questions, and ensure 2-5 days abstinence if a semen test is scheduled.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* REFERRAL TRACKER */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n            {t.referralTracker}\n          </h2>\n          <span className=\"text-xs font-mono text-[#2DD4BF]\">\n            Step {referralStep + 1} of 4\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n          {pathwaySteps.map((step, idx) => {\n            const isCompleted = referralStep >= idx;\n\n            return (\n              <div\n                key={step.title}\n                className={`p-3.5 rounded-xl border transition-all ${\n                  isCompleted\n                    ? \'bg-[#2DD4BF]/10 border-[#2DD4BF]/40 text-[#EAF4F4]\'\n                    : \'bg-white/[0.02] border-white/5 text-[#9FB4BA] opacity-60\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between mb-1\">\n                  <span className=\"text-sm font-semibold\">{step.title}</span>\n                  {isCompleted ? (\n                    <CheckCircle className=\"w-4 h-4 text-[#2DD4BF]\" />\n                  ) : (\n                    <span className=\"w-3.5 h-3.5 rounded-full border border-white/20 inline-block\" />\n                  )}\n                </div>\n                <p className=\"text-xs text-[#9FB4BA] leading-snug\">{step.desc}</p>\n                <button\n                  onClick={() => setReferralStep(idx)}\n                  className=\"mt-2 text-xs text-[#2DD4BF] hover:underline block\"\n                >\n                  {isCompleted ? \'Update status\' : \'Mark as reached\'}\n                </button>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* OPTION 1: DISCREET TELECONSULTATION WIDGET */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-[#2DD4BF]/20 space-y-5 bg-gradient-to-b from-[#132B38] to-[#0D1F29]\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#2DD4BF]/20 text-[#2DD4BF] flex items-center justify-center\">\n              <Video className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n                {t.privateTeleconsult}\n              </h2>\n              <p className=\"text-xs sm:text-sm text-[#9FB4BA]\">\n                Speak to a verified male reproductive clinician securely from your smartphone.\n              </p>\n            </div>\n          </div>\n          <span className=\"text-xs font-mono px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n            Available This Week\n          </span>\n        </div>\n\n        {bookingConfirmed ? (\n          <div className=\"p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-xs sm:text-sm space-y-2\">\n            <div className=\"flex items-center gap-2 font-bold text-sm sm:text-base\">\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n              <span>Teleconsultation Booking Reserved</span>\n            </div>\n            <p>\n              Reference ID: <strong className=\"font-mono text-white\">{bookingConfirmed.id}</strong>. A secure calendar invite with an encrypted video room link has been staged for your session on {selectedDate} at {selectedTime}.\n            </p>\n            <p className=\"text-xs text-emerald-300/80\">\n              Discreet billing tag enabled: appears as \"Health Wellness App Consultation\" on payment statements.\n            </p>\n          </div>\n        ) : (\n          <div className=\"grid sm:grid-cols-3 gap-3\">\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-[#9FB4BA]\">Select Date</label>\n              <select\n                value={selectedDate}\n                onChange={e => setSelectedDate(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-xl bg-black/20 border border-white/10 text-xs sm:text-sm text-white\"\n              >\n                <option value=\"2026-11-09\">Mon, Nov 9</option>\n                <option value=\"2026-11-10\">Tue, Nov 10</option>\n                <option value=\"2026-11-12\">Thu, Nov 12</option>\n                <option value=\"2026-11-14\">Sat, Nov 14 (Weekend)</option>\n              </select>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-[#9FB4BA]\">Select Time Slot</label>\n              <select\n                value={selectedTime}\n                onChange={e => setSelectedTime(e.target.value)}\n                className=\"w-full px-3 py-2 rounded-xl bg-black/20 border border-white/10 text-xs sm:text-sm text-white\"\n              >\n                <option value=\"18:30 (Evening)\">18:30 (Discreet Evening)</option>\n                <option value=\"19:15 (Evening)\">19:15 (Discreet Evening)</option>\n                <option value=\"20:00 (Late)\">20:00 (Discreet Late)</option>\n                <option value=\"12:30 (Lunch)\">12:30 (Midday Break)</option>\n              </select>\n            </div>\n\n            <div className=\"flex flex-col justify-end\">\n              <button\n                onClick={() => handleBookTeleconsult(\'clinic-1\')}\n                className=\"w-full py-2.5 rounded-xl bg-[#2DD4BF] text-[#07131A] text-sm font-semibold hover:bg-[#2DD4BF]/90 transition-all flex items-center justify-center gap-1.5\"\n              >\n                <Calendar className=\"w-4 h-4\" />\n                <span>{t.bookSlot}</span>\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* OPTION 2: SAMPLE CLINICS (DEMO DATA) */}\n      <div className=\"space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n                Sample clinics (demo data)\n              </h2>\n              <span className=\"text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20\">\n                Sample data\n              </span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#9FB4BA]\">\n              Fictional healthcare providers illustrating sensitive intake options and privacy amenities.\n            </p>\n          </div>\n\n          {/* Privacy Filters */}\n          <div className=\"flex flex-wrap items-center gap-2 text-xs\">\n            <button\n              onClick={() => setMaleFriendlyOnly(!maleFriendlyOnly)}\n              className={`px-3 py-1.5 rounded-xl border transition-all ${\n                maleFriendlyOnly\n                  ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\n                  : \'bg-white/5 border-white/10 text-[#9FB4BA] hover:text-white\'\n              }`}\n            >\n              {t.filterMaleFriendly}\n            </button>\n            <button\n              onClick={() => setPrivateEntranceOnly(!privateEntranceOnly)}\n              className={`px-3 py-1.5 rounded-xl border transition-all ${\n                privateEntranceOnly\n                  ? \'bg-[#2DD4BF]/20 border-[#2DD4BF] text-[#2DD4BF]\'\n                  : \'bg-white/5 border-white/10 text-[#9FB4BA] hover:text-white\'\n              }`}\n            >\n              {t.filterPrivateEntrance}\n            </button>\n          </div>\n        </div>\n\n        {/* Clinic Cards List */}\n        <div className=\"grid md:grid-cols-2 gap-4\">\n          {filteredClinics.map(clinic => (\n            <div\n              key={clinic.id}\n              className=\"p-5 rounded-2xl glass-panel border border-white/10 space-y-3 flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-start justify-between gap-2\">\n                  <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n                    {clinic.name}\n                  </h3>\n                  <span className=\"text-xs font-mono text-[#9FB4BA] shrink-0 bg-white/5 px-2 py-0.5 rounded\">\n                    {clinic.distance}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-1.5 text-xs text-[#9FB4BA] mt-1\">\n                  <MapPin className=\"w-3.5 h-3.5 text-[#2DD4BF] shrink-0\" />\n                  <span>{clinic.location}</span>\n                </div>\n\n                {/* Features badges */}\n                <div className=\"flex flex-wrap gap-1.5 mt-3\">\n                  {clinic.features.privateEntrance && (\n                    <span className=\"text-xs px-2 py-0.5 rounded bg-white/5 text-[#E8D5B5] border border-white/10\">\n                      Private Discreet Entrance\n                    </span>\n                  )}\n                  {clinic.features.maleClinicianAvailable && (\n                    <span className=\"text-xs px-2 py-0.5 rounded bg-white/5 text-[#2DD4BF] border border-white/10\">\n                      Male Consultant\n                    </span>\n                  )}\n                  {clinic.features.telehealthAvailable && (\n                    <span className=\"text-xs px-2 py-0.5 rounded bg-white/5 text-sky-400 border border-white/10\">\n                      Telehealth Option\n                    </span>\n                  )}\n                </div>\n\n                {/* Services */}\n                <div className=\"mt-3 text-xs text-[#9FB4BA]\">\n                  <strong className=\"text-white/80\">Services:</strong> {clinic.services.join(\' \342\200\242 \')}\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-white/5 flex items-center justify-between text-xs\">\n                <span className=\"text-xs text-white/50 font-mono\">\n                  Illustrative wait: ~{clinic.waitDays} days\n                </span>\n                <a\n                  href={`tel:${clinic.phone}`}\n                  className=\"px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-[#EAF4F4] text-xs font-medium flex items-center gap-1.5 transition-colors\"\n                >\n                  <Phone className=\"w-3 h-3 text-[#2DD4BF]\" />\n                  <span>Call Discreetly</span>\n                </a>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 337
    num_bytes: 15001
    line_range_bytes: 15001
  }
}
