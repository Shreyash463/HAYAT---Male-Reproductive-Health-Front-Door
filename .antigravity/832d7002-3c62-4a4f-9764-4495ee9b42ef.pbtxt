            }
            lines {
              text: "export function formatLabel(keyOrVal?: string | null): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!keyOrVal) return \'Not provided\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (LABEL_MAP[keyOrVal]) return LABEL_MAP[keyOrVal];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // If array formatted string"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (keyOrVal.includes(\',\')) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return keyOrVal"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .split(\',\')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .map(s => formatLabel(s.trim()))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      .join(\', \');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Replace underscores and capitalise"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return keyOrVal"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    .replace(/_/g, \' \')"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    .replace(/\\b\\w/g, c => c.toUpperCase());"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Formats user answers into human-friendly representation for Data Inventory"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function getHumanReadableInventory(answers: AssessmentAnswers) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const items: { field: string; val: string; storage: string; purpose: string }[] = [];"
