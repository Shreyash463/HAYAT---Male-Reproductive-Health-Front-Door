  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useState } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { assess } from \'../services/api\';\nimport { ShieldCheck, Heart, Sparkles, CheckCircle2 } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\nexport const AnalysingPage: React.FC = () => {\n  const { answers, setResult, t } = useApp();\n  const navigate = useNavigate();\n\n  const [activeMessageIndex, setActiveMessageIndex] = useState(0);\n\n  const messages = [\n    { text: t.reassurance1, icon: ShieldCheck, color: \'text-amber-400\' },\n    { text: t.reassurance2, icon: Heart, color: \'text-[#2DD4BF]\' },\n    { text: t.reassurance3, icon: Sparkles, color: \'text-sky-400\' }\n  ];\n\n  useEffect(() => {\n    // Message rotator\n    const interval = setInterval(() => {\n      setActiveMessageIndex(prev => (prev < messages.length - 1 ? prev + 1 : prev));\n    }, 850);\n\n    // Compute assessment through service layer\n    assess(answers).then(computed => {\n      setResult(computed);\n      // Give enough time to experience the safety-first checking animation (~2.6s)\n      setTimeout(() => {\n        navigate(\'/results\');\n      }, 2600);\n    });\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const CurrentIcon = messages[activeMessageIndex].icon;\n\n  return (\n    <div className=\"min-h-[70vh] flex flex-col items-center justify-center px-4 text-center\">\n      <div className=\"max-w-md w-full p-8 rounded-2xl glass-panel border border-white/10 space-y-8 relative overflow-hidden\">\n        {/* Shimmer pulse effect */}\n        <div className=\"absolute inset-0 bg-gradient-to-r from-transparent via-[#2DD4BF]/5 to-transparent animate-pulse\" />\n\n        {/* Central Animated Pulse Symbol */}\n        <div className=\"relative mx-auto w-20 h-20 rounded-full flex items-center justify-center\">\n          <motion.div\n            className=\"absolute inset-0 rounded-full bg-[#2DD4BF]/20\"\n            animate={{ scale: [1, 1.3, 1], opacity: [0.5, 0.1, 0.5] }}\n            transition={{ repeat: Infinity, duration: 2, ease: \"easeInOut\" }}\n          />\n          <div className=\"relative w-14 h-14 rounded-full bg-[#132B38] border border-[#2DD4BF]/40 flex items-center justify-center shadow-lg shadow-[#2DD4BF]/20\">\n            <CurrentIcon className={`w-7 h-7 ${messages[activeMessageIndex].color} transition-colors duration-300`} />\n          </div>\n        </div>\n\n        {/* Title */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-lg font-bold font-heading text-[#EAF4F4]\">\n            {t.analysingTitle}\n          </h2>\n          <p className=\"text-xs text-[#9FB4BA]\">\n            Applying evidence-based andrology guidelines in a private session.\n          </p>\n        </div>\n\n        {/* Dynamic Reassurance Pipeline */}\n        <div className=\"h-12 flex items-center justify-center\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeMessageIndex}\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.3 }}\n              className=\"flex items-center gap-2 text-xs font-medium text-[#EAF4F4]\"\n            >\n              <CheckCircle2 className=\"w-4 h-4 text-[#2DD4BF]\" />\n              <span>{messages[activeMessageIndex].text}</span>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        {/* Progress Dots */}\n        <div className=\"flex justify-center gap-1.5 pt-2\">\n          {messages.map((_, i) => (\n            <div\n              key={i}\n              className={`h-1.5 rounded-full transition-all duration-300 ${\n                i === activeMessageIndex ? \'w-6 bg-[#2DD4BF]\' : \'w-1.5 bg-white/20\'\n              }`}\n            />\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/AnalysingPage.tsx"
        }
        overwrite: true
      }
    }
