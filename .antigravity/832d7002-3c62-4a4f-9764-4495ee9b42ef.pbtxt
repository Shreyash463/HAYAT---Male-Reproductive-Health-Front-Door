    end_line: 96
    content: "import React from \'react\';\nimport { TriageLevel } from \'../types\';\nimport { CheckCircle2, ChevronRight, UserCheck, AlertTriangle } from \'lucide-react\';\n\ninterface TriageLadderProps {\n  currentLevel: TriageLevel;\n  reason: string;\n}\n\nconst levels: { level: TriageLevel; title: string; subtitle: string }[] = [\n  { level: \'Self-care\', title: \'Level 1: Self-Care & Lifestyle\', subtitle: \'Targeted nutrition, sleep, cooling, and routine monitoring\' },\n  { level: \'Primary care\', title: \'Level 2: Primary Care Physician\', subtitle: \'General GP assessment, metabolic baseline, routine lab tests\' },\n  { level: \'Andrology/Urology\', title: \'Level 3: Andrology / Specialist Urology\', subtitle: \'Physical exam, scrotal ultrasound Doppler, endocrine workup\' },\n  { level: \'Fertility service\', title: \'Level 4: Reproductive Fertility Medicine\', subtitle: \'Comprehensive couples evaluation and advanced andrology\' },\n  { level: \'Urgent assessment\', title: \'Level 5: Urgent Medical Assessment\', subtitle: \'Same-day evaluation for acute pain, infection, or swelling\' }\n];\n\nexport const TriageLadder: React.FC<TriageLadderProps> = ({ currentLevel, reason }) => {\n  return (\n    <div className=\"glass-panel p-6 rounded-2xl border border-white/5 space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n          Clinical Triage Pathway\n        </h3>\n        <span className=\"text-[11px] font-mono text-[#2DD4BF] bg-[#2DD4BF]/10 px-2 py-0.5 rounded border border-[#2DD4BF]/20\">\n          Recommended: {currentLevel}\n        </span>\n      </div>\n\n      <div className=\"space-y-2.5\">\n        {levels.map((item, idx) => {\n          const isSelected = item.level === currentLevel;\n          const isUrgentLevel = item.level === \'Urgent assessment\';\n\n          return (\n            <div\n              key={item.level}\n              className={`p-3.5 rounded-xl border transition-all ${\n                isSelected\n                  ? isUrgentLevel\n                    ? \'bg-rose-500/15 border-rose-500/50 shadow-lg shadow-rose-500/10\'\n                    : \'bg-[#2DD4BF]/10 border-[#2DD4BF]/50 shadow-lg shadow-[#2DD4BF]/10\'\n                  : \'bg-white/[0.02] border-white/5 opacity-60\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div\n                    className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold font-mono ${\n                      isSelected\n                        ? isUrgentLevel\n                          ? \'bg-rose-500 text-white\'\n                          : \'bg-[#2DD4BF] text-[#07131A]\'\n                        : \'bg-white/10 text-white/50\'\n                    }`}\n                  >\n                    {idx + 1}\n                  </div>\n                  <div>\n                    <h4 className={`text-xs font-semibold ${isSelected ? (isUrgentLevel ? \'text-rose-300\' : \'text-[#2DD4BF]\') : \'text-[#EAF4F4]\'}`}>\n                      {item.title}\n                    </h4>\n                    <p className=\"text-[11px] text-[#9FB4BA] mt-0.5\">{item.subtitle}</p>\n                  </div>\n                </div>\n\n                {isSelected && (\n                  <span className=\"shrink-0 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-white/10 text-[#EAF4F4]\">\n                    Your Match\n                  </span>\n                )}\n              </div>\n\n              {isSelected && (\n                <div className=\"mt-3 pt-2.5 border-t border-white/10 text-xs text-[#EAF4F4] flex items-start gap-2\">\n                  <ChevronRight className=\"w-3.5 h-3.5 text-[#2DD4BF] shrink-0 mt-0.5\" />\n                  <p className=\"leading-relaxed\">\n                    <strong className=\"text-white\">Why this level:</strong> {reason}\n                  </p>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Clinical boundaries notice */}\n      <div className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 text-[11px] text-[#9FB4BA] flex items-start gap-2\">\n        <UserCheck className=\"w-4 h-4 text-[#E8D5B5] shrink-0 mt-0.5\" />\n        <p className=\"leading-relaxed\">\n          <strong className=\"text-[#E8D5B5]\">Clinical boundaries & Human Oversight:</strong> All decisions regarding physical examinations, prescription therapies, or diagnostic procedures are made exclusively by licensed human healthcare professionals. HAYAT provides decision-support routing only.\n        </p>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 97
    num_bytes: 4655
    line_range_bytes: 4655
  }
}
