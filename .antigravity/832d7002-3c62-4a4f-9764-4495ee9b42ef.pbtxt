        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../store/AppContext\';\nimport { \n  HelpCircle, \n  ShieldCheck, \n  Scale, \n  Stethoscope, \n  ChevronDown, \n  ChevronUp, \n  AlertTriangle,\n  Heart,\n  CheckCircle2,\n  Lock,\n  Layers\n} from \'lucide-react\';\n\nexport const HowItWorksPage: React.FC = () => {\n  const { t } = useApp();\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const steps = [\n    { num: \'01\', title: \'Private Intake\', desc: \'Answer questions on lifestyle, journey, and symptoms anonymously without login.\' },\n    { num: \'02\', title: \'Rule-Based Engine\', desc: \'Transparent calculation weighted by clinical guidelines, identifying modifiable risks.\' },\n    { num: \'03\', title: \'Explainable Guidance\', desc: \'Clear plain-language explanations of exactly why each factor influences reproductive health.\' },\n    { num: \'04\', title: \'Targeted Triage\', desc: \'Direct pathway to self-care, teleconsultation, or verified andrology specialists.\' }\n  ];\n\n  const ruleCategories = [\n    { title: \'Conception Timeline\', weight: \'High\', desc: \'\342\211\24512 months without conception triggers formal concurrent evaluation recommendations.\' },\n    { title: \'Lifestyle & Oxidative Stress\', weight: \'High (Modifiable)\', desc: \'Nicotine, alcohol, sleep disruption, and scrotal heat raise reactive oxygen species (ROS).\' },\n    { title: \'Metabolic & Endocrine Balance\', weight: \'Moderate\', desc: \'BMI, blood glucose, and thyroid balance modulate aromatase activity and Leydig cell testosterone production.\' },\n    { title: \'Anatomical & Physical Signals\', weight: \'High\', desc: \'Varicocele indications (vein swelling) or childhood cryptorchidism are routed to specialist exam.\' },\n    { title: \'Semen Analysis (WHO 2021)\', weight: \'Direct Reference\', desc: \'Compares volume, concentration, and motility against 2021 WHO 6th edition lower thresholds.\' }\n  ];\n\n  const faqs = [\n    {\n      q: \'Is HAYAT a medical diagnosis?\',\n      a: \'No. HAYAT is strictly a risk-screening and triage decision support tool. It does not replace a clinician, nor can it provide a conclusive diagnosis. Only a qualified doctor with physical exam and laboratory tests can establish clinical diagnosis.\'\n    },\n    {\n      q: \'Who can see my data?\',\n      a: \'Only you. HAYAT does not ask for your name, phone number, or identity. Answers stay in your device browser cache and can be purged immediately with the \"Delete everything now\" button.\'\n    },\n    {\n      q: \'Why do you ask about lifestyle and sleep?\',\n      a: \'Sperm development (spermatogenesis) takes 72 to 90 days. Factors like sleep, high heat, oxidative stress, and metabolic balance have a direct, scientifically proven, and reversible effect on sperm quality.\'\n    },\n    {\n      q: \'What if I do not have semen test results?\',\n      a: \'You can skip that step completely. HAYAT is designed to provide comprehensive risk screening based solely on your lifestyle, physical symptoms, and medical history.\'\n    },\n    {\n      q: \'How does the Quick Hide feature work?\',\n      a: \'Clicking the Quick Hide button or tapping the \"Esc\" key immediately switches your entire screen to an innocent \"Daily Wellness Tips\" journal. None of your answers are lost, and you can return when in private.\'\n    },\n    {\n      q: \'What are clinical red flags?\',\n      a: \'Red flags include sudden severe testicular pain, rapid swelling, fever with testicular ache, or visible blood in semen. These can indicate acute emergencies such as testicular torsion and require immediate same-day emergency evaluation.\'\n    },\n    {\n      q: \'Can women or partners use this on behalf of their spouse?\',\n      a: \'Yes. HAYAT uses completely neutral language and can be filled out together to prepare constructive questions for an upcoming doctor consultation.\'\n    },\n    {\n      q: \'How does HAYAT protect cultural sensitivities?\',\n      a: \'Language is neutral, non-stigmatising, and respectful. Marital status or family structures are never assumed, and full RTL Arabic support ensures an intuitive experience for Middle Eastern users.\'\n    }\n  ];\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-12\">\n      {/* Header */}\n      <div className=\"space-y-2 text-center max-w-2xl mx-auto\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-xs font-mono font-medium border border-[#2DD4BF]/20\">\n          <HelpCircle className=\"w-3.5 h-3.5\" />\n          <span>Operational Transparency</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-4xl font-extrabold font-heading text-[#EAF4F4]\">\n          How HAYAT Works & Safety Boundaries\n        </h1>\n        <p className=\"text-xs sm:text-sm text-[#9FB4BA]\">\n          A transparent, evidence-based system engineered to empower men without stigma.\n        </p>\n      </div>\n\n      {/* Animated 4-step explainer */}\n      <div className=\"grid sm:grid-cols-2 md:grid-cols-4 gap-4\">\n        {steps.map(step => (\n          <div key={step.num} className=\"p-5 rounded-2xl glass-panel border border-white/10 space-y-2\">\n            <span className=\"text-xs font-mono font-bold text-[#2DD4BF] block\">{step.num}</span>\n            <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">{step.title}</h3>\n            <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">{step.desc}</p>\n          </div>\n        ))}\n      </div>\n\n      {/* How the Risk Screening Works: Rule-based transparency */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-5\">\n        <div>\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n            Transparent Risk Rule Categories\n          </h2>\n          <p className=\"text-xs text-[#9FB4BA]\">\n            HAYAT uses deterministic, explainable rule weights rather than unpredictable black-box neural networks.\n          </p>\n        </div>\n\n        <div className=\"space-y-3\">\n          {ruleCategories.map((cat, idx) => (\n            <div key={idx} className=\"p-4 rounded-xl bg-white/[0.02] border border-white/5 space-y-1\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-semibold text-[#EAF4F4]\">{cat.title}</span>\n                <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-[#2DD4BF]\">\n                  {cat.weight}\n                </span>\n              </div>\n              <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">{cat.desc}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Safety & Clinical Limits */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-rose-500/20 bg-rose-500/[0.02] space-y-4\">\n        <div className=\"flex items-center gap-2 text-rose-400\">\n          <AlertTriangle className=\"w-5 h-5 shrink-0\" />\n          <h2 className=\"text-base font-bold font-heading\">\n            Safety Limits & When to Call a Doctor Immediately\n          </h2>\n        </div>\n\n        <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n          HAYAT enforces strict safety limits. If you ever experience sudden severe testicular pain, acute swelling, high fever with groin ache, or visible blood in semen, do not wait for routine appointments. These are time-critical medical issues requiring emergency urological assessment.\n        </p>\n\n        <div className=\"p-3.5 rounded-xl bg-black/20 border border-white/5 text-xs text-[#EAF4F4]\">\n          <strong className=\"text-[#E8D5B5] block mb-1\">Human-in-the-Loop Oversight Policy:</strong>\n          Our clinical protocols require that any formal prescription, imaging order, surgical consultation, or diagnostic conclusion is made by a licensed healthcare professional.\n        </div>\n      </div>\n\n      {/* Fairness & Cultural Respect */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-3\">\n        <div className=\"flex items-center gap-2 text-[#E8D5B5]\">\n          <Heart className=\"w-5 h-5\" />\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n            Cultural Respect & Non-Stigmatising Design\n          </h2>\n        </div>\n        <p className=\"text-xs text-[#9FB4BA] leading-relaxed\">\n          We recognize that fertility is a sensitive, deeply personal subject often clouded by societal taboos and shame. HAYAT was intentionally architected to be non-accusatory, neutral regarding family planning choices, and accessible in Arabic with full right-to-left layout fidelity.\n        </p>\n      </div>\n\n      {/* 8-Question FAQ Accordion */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n          Frequently Asked Questions (FAQ)\n        </h2>\n\n        <div className=\"space-y-2\">\n          {faqs.map((faq, idx) => (\n            <div key={idx} className=\"border border-white/5 rounded-xl overflow-hidden\">\n              <button\n                onClick={() => setOpenFaq(openFaq === idx ? null : idx)}\n                className=\"w-full text-left p-3.5 bg-white/[0.02] hover:bg-white/[0.05] flex items-center justify-between text-xs font-medium text-[#EAF4F4] transition-colors\"\n              >\n                <span>{faq.q}</span>\n                {openFaq === idx ? <ChevronUp className=\"w-4 h-4 text-[#2DD4BF]\" /> : <ChevronDown className=\"w-4 h-4 text-[#9FB4BA]\" />}\n              </button>\n              {openFaq === idx && (\n                <div className=\"p-3.5 text-xs text-[#9FB4BA] bg-black/10 leading-relaxed border-t border-white/5\">\n                  {faq.a}\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/HowItWorksPage.tsx"
        }
        overwrite: true
      }
    }
