    tool_calls {
      id: "call_11269310997699787162"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { TriageLevel } from \'../types\';\\nimport { PathDraw, usePrefersReducedMotion } from \'../motion\';\\nimport { ChevronRight, UserCheck, MapPin, ShieldCheck, Info, Stethoscope, Building2, AlertTriangle } from \'lucide-react\';\\n\\ninterface TriageLadderProps {\\n  currentLevel: TriageLevel;\\n  reason: string;\\n}\\n\\nconst levels: { level: TriageLevel; title: string; subtitle: string; Icon: React.ElementType }[] = [\\n  {\\n    level: \'Self-care\',\\n    title: \'Level 1: Self-Care & Lifestyle\',\\n    subtitle: \'Targeted nutrition, sleep, cooling, and routine monitoring\',\\n    Icon: ShieldCheck,\\n  },\\n  {\\n    level: \'Primary care\',\\n    title: \'Level 2: Primary Care Physician\',\\n    subtitle: \'General GP assessment, metabolic baseline, routine lab tests\',\\n    Icon: Info,\\n  },\\n  {\\n    level: \'Andrology/Urology\',\\n    title: \'Level 3: Andrology / Specialist Urology\',\\n    subtitle: \'Physical exam, scrotal ultrasound Doppler, endocrine workup\',\\n    Icon: Stethoscope,\\n  },\\n  {\\n    level: \'Fertility service\',\\n    title: \'Level 4: Reproductive Fertility Medicine\',\\n    subtitle: \'Comprehensive couples evaluation and advanced andrology\',\\n    Icon: Building2,\\n  },\\n  {\\n    level: \'Urgent assessment\',\\n    title: \'Level 5: Urgent Medical Assessment\',\\n    subtitle: \'Same-day evaluation for acute pain, infection, or swelling\',\\n    Icon: AlertTriangle,\\n  },\\n];\\n\\nexport const TriageLadder: React.FC<TriageLadderProps> = ({ currentLevel, reason }) => {\\n  const reduced = usePrefersReducedMotion();\\n  const activeIdx = Math.max(0, levels.findIndex(l => l.level === currentLevel));\\n  const fillPercent = Math.round(((activeIdx + 0.5) / levels.length) * 100);\\n\\n  return (\\n    <div className=\\\"paper-card p-6 sm:p-8 space-y-6\\\">\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n        <div>\\n          <h3 className=\\\"font-heading font-bold text-lg sm:text-xl text-[var(--text-main)]\\\">\\n            Clinical Triage Pathway\\n          </h3>\\n          <p className=\\\"text-sm text-[var(--text-muted)] mt-0.5\\\">\\n            Five structured levels showing where your screening points today.\\n          </p>\\n        </div>\\n        <span\\n          className=\\\"text-xs sm:text-sm font-semibold px-3 py-1 rounded-full border\\\"\\n          style={{\\n            color: currentLevel === \'Urgent assessment\' ? \'var(--risk-urg)\' : \'var(--accent-text)\',\\n            backgroundColor: currentLevel === \'Urgent assessment\' ? \'var(--risk-urg-bg)\' : \'var(--accent-soft)\',\\n            borderColor: currentLevel === \'Urgent assessment\' ? \'var(--risk-urg-border)\' : \'var(--border-hairline)\',\\n          }}\\n        >\\n          Recommended: {currentLevel}\\n        </span>\\n      </div>\\n\\n      {/* Vertical Connected Ladder with SVG PathDraw Spine */}\\n      <div className=\\\"relative space-y-3\\\">\\n        {/* Continuous Vertical SVG Connector Spine */}\\n        <svg\\n          viewBox=\\\"0 0 8 400\\\"\\n          preserveAspectRatio=\\\"none\\\"\\n          className=\\\"absolute top-6 bottom-6 start-[12px] w-2 pointer-events-none\\\"\\n          aria-hidden=\\\"true\\\"\\n        >\\n          <line\\n            x1=\\\"4\\\"\\n            y1=\\\"0\\\"\\n            x2=\\\"4\\\"\\n            y2=\\\"400\\\"\\n            stroke=\\\"var(--border-hairline)\\\"\\n            strokeWidth=\\\"2.5\\\"\\n            strokeLinecap=\\\"round\\\"\\n          />\\n          <PathDraw\\n            d={`M 4 0 L 4 ${Math.max(24, fillPercent * 4)}`}\\n            stroke={currentLevel === \'Urgent assessment\' ? \'var(--risk-urg)\' : \'var(--accent)\'}\\n            strokeWidth={3}\\n            duration={0.95}\\n          />\\n        </svg>\\n\\n        {levels.map((item, idx) => {\\n          const isSelected = item.level === currentLevel;\\n          const isUrgentLevel = item.level === \'Urgent assessment\';\\n          const StepIcon = item.Icon;\\n\\n          return (\\n            <div key={item.level} className=\\\"relative flex gap-3 sm:gap-4 items-stretch\\\">\\n              {/* Step Node */}\\n              <div className=\\\"relative z-10 flex flex-col items-center shrink-0 pt-3\\\">\\n                <div className=\\\"relative flex items-center justify-center\\\">\\n                  {isSelected && !reduced && (\\n                    <span\\n                      className=\\\"calm-pulse-ring absolute -inset-1.5 rounded-full pointer-events-none\\\"\\n                      style={{\\n                        backgroundColor: isUrgentLevel ? \'var(--risk-urg-bg)\' : \'var(--accent-soft)\',\\n                        border: `1px solid ${isUrgentLevel ? \'var(--risk-urg-border)\' : \'var(--accent)\'}`,\\n                      }}\\n                      aria-hidden=\\\"true\\\"\\n                    />\\n                  )}\\n                  <div\\n                    className=\\\"relative w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border transition-colors\\\"\\n                    style={\\n                      isSelected\\n                        ? {\\n                            backgroundColor: isUrgentLevel ? \'var(--risk-urg)\' : \'var(--accent)\',\\n                            borderColor: isUrgentLevel ? \'var(--risk-urg)\' : \'var(--accent)\',\\n                            color: \'#FFFFFF\',\\n                          }\\n                        : {\\n                            backgroundColor: \'var(--surface)\',\\n                            borderColor: \'var(--border-strong)\',\\n                            color: \'var(--text-muted)\',\\n                          }\\n                    }\\n                  >\\n                    {idx + 1}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Step Card */}\\n              <div\\n                className={`flex-1 p-4 sm:p-5 rounded-2xl border transition-all ${\\n                  isSelected ? \'shadow-sm\' : \'opacity-75\'\\n                }`}\\n                style={\\n                  isSelected\\n                    ? {\\n                        backgroundColor: isUrgentLevel ? \'var(--risk-urg-bg)\' : \'var(--accent-soft)\',\\n                        borderColor: isUrgentLevel ? \'var(--risk-urg-border)\' : \'var(--accent)\',\\n                      }\\n                    : {\\n                        backgroundColor: \'var(--surface)\',\\n                        borderColor: \'var(--border-hairline)\',\\n                      }\\n                }\\n              >\\n                <div className=\\\"flex flex-wrap items-start justify-between gap-2\\\">\\n                  <div className=\\\"flex items-start gap-2.5\\\">\\n                    <StepIcon\\n                      className=\\\"w-4 h-4 mt-1 shrink-0\\\"\\n                      style={{\\n                        color: isSelected\\n                          ? isUrgentLevel\\n                            ? \'var(--risk-urg)\'\\n                            : \'var(--accent-text)\'\\n                          : \'var(--text-muted)\',\\n                      }}\\n                    />\\n                    <div>\\n                      <h4 className=\\\"text-base font-bold text-[var(--text-main)] leading-snug\\\">\\n                        {item.title}\\n                      </h4>\\n                      <p className=\\\"text-sm text-[var(--text-muted)] mt-0.5\\\">{item.subtitle}</p>\\n                    </div>\\n                  </div>\\n\\n                  {isSelected && (\\n                    <span\\n                      className=\\\"inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full text-white shrink-0\\\"\\n                      style={{ backgroundColor: isUrgentLevel ? \'var(--risk-urg)\' : \'var(--accent-text)\' }}\\n                    >\\n                      <MapPin className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>You are here</span>\\n                    </span>\\n                  )}\\n                </div>\\n\\n                {isSelected && (\\n                  <div className=\\\"mt-3 pt-3 border-t border-[var(--border-hairline)] text-sm sm:text-base text-[var(--text-main)] flex items-start gap-2\\\">\\n                    <ChevronRight\\n                      className=\\\"w-4 h-4 shrink-0 mt-1\\\"\\n                      style={{ color: isUrgentLevel ? \'var(--risk-urg)\' : \'var(--accent-text)\' }}\\n                    />\\n                    <p className=\\\"leading-relaxed\\\">\\n                      <strong>Why this level:</strong> {reason}\\n                    </p>\\n                  </div>\\n                )}\\n              </div>\\n            </div>\\n          );\\n        })}\\n      </div>\\n\\n      {/* Clinical boundaries notice */}\\n      <div className=\\\"p-4 rounded-2xl surface-panel text-sm text-[var(--text-muted)] flex items-start gap-3\\\">\\n        <UserCheck className=\\\"w-5 h-5 text-[var(--brand)] shrink-0 mt-0.5\\\" />\\n        <p className=\\\"leading-relaxed\\\">\\n          <strong className=\\\"text-[var(--text-main)]\\\">Clinical boundaries & Human Oversight:</strong> All decisions regarding physical examinations, prescription therapies, or diagnostic procedures are made exclusively by licensed human healthcare professionals. HAYAT provides decision-support routing only.\\n        </p>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Add PathDraw SVG vertical connector and calm pulsing marker to TriageLadder\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TriageLadder.tsx\", \"toolAction\":\"Updating TriageLadder.tsx\", \"toolSummary\":\"Update TriageLadder.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_11269310997699785675"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { useNavigate, Link } from \'react-router-dom\';\\nimport { motion } from \'motion/react\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { RiskGauge } from \'../components/RiskGauge\';\\nimport { FactorBar } from \'../components/FactorBar\';\\nimport { TriageLadder } from \'../components/TriageLadder\';\\nimport { ClinicianSummaryModal } from \'../components/ClinicianSummaryModal\';\\nimport { WhatIfPanel } from \'../components/WhatIfPanel\';\\nimport { EASE_CALM, usePrefersReducedMotion } from \'../motion\';\\nimport {\\n  AlertTriangle,\\n  CheckCircle2,\\n  HelpCircle,\\n  Sparkles,\\n  FileText,\\n  Trash2,\\n  ArrowRight,\\n  ChevronRight,\\n  Info,\\n  Heart,\\n  ShieldCheck,\\n  AlertCircle,\\n} from \'lucide-react\';\\n\\nexport const ResultsPage: React.FC = () => {\\n  const { result, answers, t, consent, updateConsent, clearAllData } = useApp();\\n  const navigate = useNavigate();\\n  const shouldReduceMotion = usePrefersReducedMotion();\\n\\n  const [detailedView, setDetailedView] = useState(false);\\n  const [showClinicianModal, setShowClinicianModal] = useState(false);\\n  const [showConsentPromptModal, setShowConsentPromptModal] = useState(false);\\n  const [showDeleteConfirmModal, setShowDeleteConfirmModal] = useState(false);\\n\\n  if (!result) {\\n    return (\\n      <div className=\\\"max-w-md mx-auto my-16 p-8 text-center paper-card space-y-4\\\">\\n        <Sparkles className=\\\"w-9 h-9 text-[var(--accent-text)] mx-auto\\\" />\\n        <h1 className=\\\"text-xl font-bold font-heading text-[var(--text-main)]\\\">No Active Screening Found</h1>\\n        <p className=\\\"text-base text-[var(--text-muted)]\\\">\\n          Complete the short private questionnaire or launch a demo scenario to view an explainable screening.\\n        </p>\\n        <div className=\\\"flex flex-wrap justify-center gap-3 pt-2\\\">\\n          <Link\\n            to=\\\"/consent\\\"\\n            className=\\\"px-6 min-h-[48px] rounded-2xl bg-[var(--accent)] text-white text-base font-semibold inline-flex items-center justify-center\\\"\\n          >\\n            Start Check\\n          </Link>\\n          <Link\\n            to=\\\"/\\\"\\n            className=\\\"px-6 min-h-[48px] rounded-2xl border border-[var(--border-hairline)] text-base font-medium text-[var(--text-main)] inline-flex items-center justify-center\\\"\\n          >\\n            Back to Home\\n          </Link>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  const isUrgent = result.band === \'Urgent\';\\n\\n  const bandIcons = {\\n    Low: ShieldCheck,\\n    Moderate: Info,\\n    Elevated: AlertCircle,\\n    Urgent: AlertTriangle,\\n  };\\n  const bandColors = {\\n    Low: { color: \'var(--risk-low)\', bg: \'var(--risk-low-bg)\', border: \'var(--risk-low-border)\' },\\n    Moderate: { color: \'var(--risk-mod)\', bg: \'var(--risk-mod-bg)\', border: \'var(--risk-mod-border)\' },\\n    Elevated: { color: \'var(--risk-elev)\', bg: \'var(--risk-elev-bg)\', border: \'var(--risk-elev-border)\' },\\n    Urgent: { color: \'var(--risk-urg)\', bg: \'var(--risk-urg-bg)\', border: \'var(--risk-urg-border)\' },\\n  };\\n  const BandIcon = bandIcons[result.band];\\n  const currentBandStyle = bandColors[result.band];\\n\\n  const handleOpenSummary = () => {\\n    if (consent.createClinicianSummary) {\\n      setShowClinicianModal(true);\\n    } else {\\n      setShowConsentPromptModal(true);\\n    }\\n  };\\n\\n  const handleEnableSummaryConsent = () => {\\n    updateConsent({ createClinicianSummary: true });\\n    setShowConsentPromptModal(false);\\n    setShowClinicianModal(true);\\n  };\\n\\n  const handleConfirmDelete = () => {\\n    clearAllData();\\n    setShowDeleteConfirmModal(false);\\n    navigate(\'/\');\\n  };\\n\\n  const revealProps = (delay = 0) =>\\n    shouldReduceMotion\\n      ? {}\\n      : {\\n          initial: { opacity: 0, y: 18 },\\n          whileInView: { opacity: 1, y: 0 },\\n          viewport: { once: true, amount: 0.1 },\\n          transition: { duration: 0.44, delay, ease: EASE_CALM },\\n        };\\n\\n  return (\\n    <div className=\\\"max-w-4xl mx-auto px-4 py-8 sm:py-10 space-y-8\\\">\\n      {/* 1. SAFETY EXCEPTION: Red-flag card appears INSTANTLY with zero reveal delay or scroll-gating */}\\n      {isUrgent && (\\n        <section\\n          className=\\\"paper-card p-6 sm:p-8 border-2 space-y-4\\\"\\n          style={{\\n            backgroundColor: \'var(--risk-urg-bg)\',\\n            borderColor: \'var(--risk-urg)\',\\n          }}\\n        >\\n          <div className=\\\"flex items-start gap-3.5\\\">\\n            <div\\n              className=\\\"w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 text-white\\\"\\n              style={{ backgroundColor: \'var(--risk-urg)\' }}\\n            >\\n              <AlertTriangle className=\\\"w-6 h-6\\\" />\\n            </div>\\n            <div>\\n              <h2 className=\\\"text-xl sm:text-2xl font-bold font-heading text-[var(--text-main)]\\\">\\n                {t.urgentCardTitle}\\n              </h2>\\n              <p className=\\\"text-base text-[var(--text-main)] mt-1.5 leading-relaxed\\\">\\n                {t.urgentCardBody}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"p-4 rounded-2xl bg-[var(--card)] border border-[var(--risk-urg-border)] text-sm sm:text-base text-[var(--text-main)] space-y-2\\\">\\n            <span className=\\\"font-bold block text-xs uppercase tracking-wider\\\" style={{ color: \'var(--risk-urg)\' }}>\\n              Flagged Symptoms Requiring Medical Assessment Today:\\n            </span>\\n            <ul className=\\\"list-disc list-inside space-y-1\\\">\\n              {result.redFlags.map((rf, i) => (\\n                <li key={i}>{rf}</li>\\n              ))}\\n            </ul>\\n          </div>\\n\\n          <div className=\\\"pt-1\\\">\\n            <Link\\n              to=\\\"/care\\\"\\n              className=\\\"inline-flex items-center justify-center gap-2 px-6 min-h-[48px] rounded-2xl text-white text-base font-semibold hover:opacity-95 transition-opacity\\\"\\n              style={{ backgroundColor: \'var(--risk-urg)\' }}\\n            >\\n              <span>{t.openCareNav} (Urgent Care Options)</span>\\n              <ArrowRight className=\\\"w-4 h-4 rtl:rotate-180\\\" />\\n            </Link>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* 2. Screening, Not Diagnosis Banner */}\\n      <motion.div\\n        {...revealProps(0)}\\n        className=\\\"p-4 rounded-2xl border flex flex-wrap items-center justify-between gap-3 text-sm sm:text-base\\\"\\n        style={{\\n          backgroundColor: \'var(--risk-mod-bg)\',\\n          borderColor: \'var(--risk-mod-border)\',\\n          color: \'var(--text-main)\',\\n        }}\\n      >\\n        <div className=\\\"flex items-center gap-2.5\\\">\\n          <Info className=\\\"w-5 h-5 shrink-0\\\" style={{ color: \'var(--risk-mod)\' }} />\\n          <span className=\\\"font-semibold\\\">{t.screeningNotDiagnosis}</span>\\n        </div>\\n        <span\\n          className=\\\"text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-[var(--card)] border border-[var(--border-hairline)] uppercase whitespace-nowrap\\\"\\n          style={{ color: \'var(--risk-mod)\' }}\\n        >\\n          Rule-Based Screening\\n        </span>\\n      </motion.div>\\n\\n      {/* 3. Risk Band Gauge (0 -> score) & 1-Sentence Summary with subtle band tint */}\\n      <motion.section\\n        {...revealProps(0.05)}\\n        className=\\\"paper-card p-6 sm:p-8 relative overflow-hidden\\\"\\n        style={{\\n          backgroundImage: `radial-gradient(circle at 88% 22%, ${currentBandStyle.bg} 0%, transparent 58%)`,\\n        }}\\n      >\\n        <div className=\\\"flex flex-col md:flex-row items-center justify-between gap-8\\\">\\n          <div className=\\\"space-y-4 text-center md:text-start max-w-xl\\\">\\n            <div\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full border text-sm font-semibold\\\"\\n              style={{\\n                color: currentBandStyle.color,\\n                backgroundColor: currentBandStyle.bg,\\n                borderColor: currentBandStyle.border,\\n              }}\\n            >\\n              <BandIcon className=\\\"w-4 h-4\\\" />\\n              <span>{result.band} Risk Band</span>\\n            </div>\\n\\n            <h1 className=\\\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)] leading-snug\\\">\\n              {result.summary}\\n            </h1>\\n\\n            <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              Computed transparently from international clinical guidance. Scroll through your story below to inspect every signal, view triage placement, and explore What-If changes.\\n            </p>\\n\\n            {result.missingInfoNote && (\\n              <div className=\\\"p-4 rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] text-sm text-[var(--text-muted)] flex items-start gap-2.5 text-start\\\">\\n                <Info className=\\\"w-4 h-4 text-[var(--brand)] shrink-0 mt-1\\\" />\\n                <span>{result.missingInfoNote}</span>\\n              </div>\\n            )}\\n          </div>\\n\\n          <RiskGauge score={result.score} band={result.band} size={210} />\\n        </div>\\n      </motion.section>\\n\\n      {/* 4. Explainability Panel (\\\"Why this result?\\\") */}\\n      <motion.section {...revealProps(0.06)} className=\\\"paper-card p-6 sm:p-8 space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[var(--border-hairline)]\\\">\\n          <div>\\n            <h2 className=\\\"text-lg sm:text-xl font-bold font-heading text-[var(--text-main)]\\\">\\n              {t.whyThisResult}\\n            </h2>\\n            <p className=\\\"text-sm sm:text-base text-[var(--text-muted)] mt-0.5\\\">\\n              Zero black-box guessing. Review each factor that contributed to your screening.\\n            </p>\\n          </div>\\n\\n          {/* Simple vs Detailed Toggle */}\\n          <div className=\\\"inline-flex items-center gap-1 p-1 rounded-2xl bg-[var(--surface)] border border-[var(--border-hairline)] self-start sm:self-auto\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setDetailedView(false)}\\n              className={`px-4 min-h-[40px] text-sm font-semibold rounded-xl transition-colors cursor-pointer ${\\n                !detailedView\\n                  ? \'bg-[var(--accent)] text-white shadow-xs\'\\n                  : \'text-[var(--text-muted)] hover:text-[var(--text-main)]\'\\n              }`}\\n            >\\n              {t.simpleView}\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setDetailedView(true)}\\n              className={`px-4 min-h-[40px] text-sm font-semibold rounded-xl transition-colors cursor-pointer ${\\n                detailedView\\n                  ? \'bg-[var(--accent)] text-white shadow-xs\'\\n                  : \'text-[var(--text-muted)] hover:text-[var(--text-main)]\'\\n              }`}\\n            >\\n              {t.detailedView}\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Contributing Risk Factors */}\\n        <div className=\\\"space-y-3\\\">\\n          <h3 className=\\\"text-base font-bold text-[var(--text-main)]\\\">\\n            Identified Factors ({result.factors.length})\\n          </h3>\\n          {result.factors.length > 0 ? (\\n            result.factors.map((factor, idx) => (\\n              <FactorBar key={factor.id} factor={factor} detailed={detailedView} index={idx} />\\n            ))\\n          ) : (\\n            <div\\n              className=\\\"p-4 rounded-2xl border text-base flex items-center gap-2.5\\\"\\n              style={{\\n                backgroundColor: \'var(--risk-low-bg)\',\\n                borderColor: \'var(--risk-low-border)\',\\n                color: \'var(--risk-low)\',\\n              }}\\n            >\\n              <CheckCircle2 className=\\\"w-5 h-5 shrink-0\\\" />\\n              <span className=\\\"font-medium\\\">No elevated risk factors were identified in your profile.</span>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Favourable Factors */}\\n        {result.favourableFactors.length > 0 && (\\n          <div className=\\\"space-y-3 pt-4 border-t border-[var(--border-hairline)]\\\">\\n            <h3 className=\\\"text-base font-bold flex items-center gap-2\\\" style={{ color: \'var(--risk-low)\' }}>\\n              <CheckCircle2 className=\\\"w-5 h-5\\\" />\\n              <span>\\n                {t.favourableTitle} ({result.favourableFactors.length})\\n              </span>\\n            </h3>\\n            <div className=\\\"grid sm:grid-cols-2 gap-3\\\">\\n              {result.favourableFactors.map(factor => (\\n                <div\\n                  key={factor.id}\\n                  className=\\\"p-4 rounded-2xl border text-sm sm:text-base space-y-1.5\\\"\\n                  style={{\\n                    backgroundColor: \'var(--risk-low-bg)\',\\n                    borderColor: \'var(--risk-low-border)\',\\n                  }}\\n                >\\n                  <div className=\\\"flex items-center gap-2 font-semibold\\\" style={{ color: \'var(--risk-low)\' }}>\\n                    <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n                    <span>{factor.label}</span>\\n                  </div>\\n                  <p className=\\\"text-sm text-[var(--text-main)] leading-relaxed\\\">{factor.explanation}</p>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* What we did NOT use */}\\n        <div className=\\\"p-4 rounded-2xl surface-panel text-sm text-[var(--text-muted)] space-y-1\\\">\\n          <strong className=\\\"text-[var(--text-main)] block\\\">{t.notUsedTitle}</strong>\\n          <p>{t.notUsedList}</p>\\n        </div>\\n      </motion.section>\\n\\n      {/* 5. Vertical Triage Ladder */}\\n      <motion.section {...revealProps(0.06)}>\\n        <TriageLadder currentLevel={result.triage} reason={result.triageReason} />\\n      </motion.section>\\n\\n      {/* 6. Action Plan & Questions to Ask Doctor */}\\n      <motion.section {...revealProps(0.06)} className=\\\"grid md:grid-cols-2 gap-5\\\">\\n        <div className=\\\"paper-card p-6 sm:p-7 space-y-4\\\">\\n          <div className=\\\"flex items-center gap-2 text-[var(--accent-text)]\\\">\\n            <Heart className=\\\"w-5 h-5\\\" />\\n            <h3 className=\\\"font-heading font-bold text-base tracking-wide uppercase\\\">\\n              {t.actionPlanTitle}\\n            </h3>\\n          </div>\\n          <ul className=\\\"space-y-3 text-base text-[var(--text-main)]\\\">\\n            {result.actions.map((act, i) => (\\n              <li key={i} className=\\\"flex items-start gap-2.5\\\">\\n                <CheckCircle2 className=\\\"w-5 h-5 text-[var(--accent-text)] shrink-0 mt-0.5\\\" />\\n                <span className=\\\"leading-relaxed\\\">{act}</span>\\n              </li>\\n            ))}\\n          </ul>\\n        </div>\\n\\n        <div className=\\\"paper-card p-6 sm:p-7 space-y-4\\\">\\n          <div className=\\\"flex items-center gap-2 text-[var(--brand)]\\\">\\n            <HelpCircle className=\\\"w-5 h-5\\\" />\\n            <h3 className=\\\"font-heading font-bold text-base tracking-wide uppercase\\\">\\n              {t.questionsToAskDoctor}\\n            </h3>\\n          </div>\\n          <ul className=\\\"space-y-3 text-base text-[var(--text-main)]\\\">\\n            {result.doctorQuestions.map((q, i) => (\\n              <li key={i} className=\\\"flex items-start gap-2.5\\\">\\n                <ChevronRight className=\\\"w-5 h-5 text-[var(--brand)] shrink-0 mt-0.5 rtl:rotate-180\\\" />\\n                <span className=\\\"leading-relaxed\\\">&ldquo;{q}&rdquo;</span>\\n              </li>\\n            ))}\\n          </ul>\\n        </div>\\n      </motion.section>\\n\\n      {/* Screening vs Medical Diagnosis Context */}\\n      <motion.section {...revealProps(0.06)} className=\\\"paper-card p-6 sm:p-8 space-y-4\\\">\\n        <h3 className=\\\"text-xs font-bold uppercase tracking-wider text-[var(--brand)] font-mono\\\">\\n          {t.screeningVsDiagnosis}\\n        </h3>\\n        <div className=\\\"grid sm:grid-cols-3 gap-4 text-sm sm:text-base text-[var(--text-muted)]\\\">\\n          <div className=\\\"p-4 rounded-2xl surface-panel\\\">\\n            <span className=\\\"font-bold text-[var(--text-main)] block mb-1\\\">Signal, Not Disease</span>\\n            <span>{t.screeningVs1}</span>\\n          </div>\\n          <div className=\\\"p-4 rounded-2xl surface-panel\\\">\\n            <span className=\\\"font-bold text-[var(--text-main)] block mb-1\\\">Doctor-Confirmed</span>\\n            <span>{t.screeningVs2}</span>\\n          </div>\\n          <div className=\\\"p-4 rounded-2xl surface-panel\\\">\\n            <span className=\\\"font-bold text-[var(--text-main)] block mb-1\\\">Often Reversible</span>\\n            <span>{t.screeningVs3}</span>\\n          </div>\\n        </div>\\n      </motion.section>\\n\\n      {/* 7. Action Buttons & Interactive What-If Panel */}\\n      <motion.section\\n        {...revealProps(0.06)}\\n        className=\\\"paper-card p-6 flex flex-col sm:flex-row items-center justify-between gap-4\\\"\\n      >\\n        <div className=\\\"flex flex-wrap items-center gap-3 w-full sm:w-auto\\\">\\n          <Link\\n            to=\\\"/care\\\"\\n            className=\\\"w-full sm:w-auto px-6 min-h-[48px] rounded-2xl bg-[var(--accent)] text-white text-base font-heading font-semibold hover:opacity-95 flex items-center justify-center gap-2 transition-opacity\\\"\\n          >\\n            <span>{t.openCareNav}</span>\\n            <ArrowRight className=\\\"w-4 h-4 rtl:rotate-180\\\" />\\n          </Link>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleOpenSummary}\\n            className=\\\"w-full sm:w-auto px-5 min-h-[48px] rounded-2xl border border-[var(--border-strong)] bg-[var(--surface)] text-base font-medium text-[var(--text-main)] hover:bg-[var(--card-alt)] flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n          >\\n            <FileText className=\\\"w-4 h-4 text-[var(--brand)]\\\" />\\n            <span>{t.createClinicianSummary}</span>\\n          </button>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setShowDeleteConfirmModal(true)}\\n          className=\\\"text-sm sm:text-base font-medium flex items-center gap-2 min-h-[44px] px-3 rounded-xl hover:bg-[var(--risk-urg-bg)] transition-colors cursor-pointer\\\"\\n          style={{ color: \'var(--risk-urg)\' }}\\n        >\\n          <Trash2 className=\\\"w-4 h-4\\\" />\\n          <span>{t.deleteMyDataNow}</span>\\n        </button>\\n      </motion.section>\\n\\n      <motion.section {...revealProps(0.06)}>\\n        <WhatIfPanel baseAnswers={answers} baseResult={result} />\\n      </motion.section>\\n\\n      {/* Modals */}\\n      {showClinicianModal && (\\n        <ClinicianSummaryModal\\n          result={result}\\n          answers={answers}\\n          onClose={() => setShowClinicianModal(false)}\\n        />\\n      )}\\n\\n      {showConsentPromptModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\\\">\\n          <div className=\\\"max-w-md w-full p-6 sm:p-7 paper-card space-y-4\\\">\\n            <h3 className=\\\"text-lg font-bold font-heading text-[var(--text-main)]\\\">Enable Clinician Summary</h3>\\n            <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              To format your inputs into a printable summary for your clinician, confirm that you permit HAYAT to prepare this document on your device. You control who receives it.\\n            </p>\\n            <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowConsentPromptModal(false)}\\n                className=\\\"px-4 min-h-[44px] rounded-xl text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleEnableSummaryConsent}\\n                className=\\\"px-5 min-h-[44px] rounded-xl bg-[var(--accent)] text-white text-sm font-semibold hover:opacity-95 cursor-pointer\\\"\\n              >\\n                Allow & Open Summary\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {showDeleteConfirmModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm\\\">\\n          <div className=\\\"max-w-md w-full p-6 sm:p-7 paper-card border-2 space-y-4\\\" style={{ borderColor: \'var(--risk-urg-border)\' }}>\\n            <div className=\\\"flex items-center gap-2\\\" style={{ color: \'var(--risk-urg)\' }}>\\n              <Trash2 className=\\\"w-5 h-5\\\" />\\n              <h3 className=\\\"text-lg font-bold font-heading\\\">Delete All Data Immediately?</h3>\\n            </div>\\n            <p className=\\\"text-base text-[var(--text-muted)] leading-relaxed\\\">\\n              This will immediately wipe your answers, screening score, and any device storage. No copies will remain anywhere.\\n            </p>\\n            <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowDeleteConfirmModal(false)}\\n                className=\\\"px-4 min-h-[44px] rounded-xl text-sm font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer\\\"\\n              >\\n                Keep my data\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleConfirmDelete}\\n                className=\\\"px-5 min-h-[44px] rounded-xl text-white text-sm font-semibold hover:opacity-95 cursor-pointer\\\"\\n                style={{ backgroundColor: \'var(--risk-urg)\' }}\\n              >\\n                Yes, Purge Everything\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade ResultsPage so urgent red-flag card renders instantaneously with zero animation delay, apply subtle RiskBand tint, and follow requested 7-part scroll story order\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ResultsPage.tsx\", \"toolAction\":\"Updating ResultsPage.tsx\", \"toolSummary\":\"Update ResultsPage.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 42
      nanos: 816246443
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "6pP6auPgIs-sz7IP4pC_kQw"
  }
