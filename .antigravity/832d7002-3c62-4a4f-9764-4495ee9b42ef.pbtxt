            lines {
              text: "    items.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      field: \'Time Trying\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      val: formatLabel(answers.tryingDuration),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      storage: \'Local browser memory\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      purpose: \'Helps determine if clinical evaluation guidelines recommend a doctor check-in.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
