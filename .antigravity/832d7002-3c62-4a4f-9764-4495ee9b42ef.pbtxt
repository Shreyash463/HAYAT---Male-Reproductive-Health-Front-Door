      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { NavLink, Link } from \'react-router-dom\';\\nimport { useApp } from \'../store/AppContext\';\\nimport { QuickHideButton } from \'./QuickHideButton\';\\nimport { LangSwitcher } from \'./LangSwitcher\';\\nimport { Sun, Moon, Menu, X, Sparkles } from \'lucide-react\';\\n\\nexport const Navbar: React.FC = () => {\\n  const { t, theme, toggleTheme, result } = useApp();\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n\\n  const navLinks = [\\n    { to: \'/\', label: t.navHome },\\n    { to: \'/check\', label: t.navCheck },\\n    { to: \'/care\', label: t.navCare },\\n    { to: \'/privacy\', label: t.navPrivacy },\\n    { to: \'/evidence\', label: t.navEvidence },\\n    { to: \'/how-it-works\', label: t.navHowItWorks },\\n  ];\\n\\n  return (\\n    <header className=\\\"sticky top-0 z-40 w-full backdrop-blur-xl bg-[#07131A]/85 border-b border-white/10 transition-colors\\\">\\n      <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2\\\">\\n        {/* Logo - cleanly designed, never crowds nav */}\\n        <Link to=\\\"/\\\" className=\\\"flex items-center gap-2.5 group shrink-0\\\">\\n          <div className=\\\"relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#2DD4BF] to-[#38BDF8] p-[1.5px] shadow-sm shadow-[#2DD4BF]/20 shrink-0\\\">\\n            <div className=\\\"w-full h-full rounded-full bg-[#07131A] flex items-center justify-center overflow-hidden\\\">\\n              <svg viewBox=\\\"0 0 24 24\\\" className=\\\"w-4 h-4 text-[#2DD4BF] transform group-hover:scale-110 transition-transform\\\">\\n                <circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"1.5\\\" fill=\\\"none\\\" opacity=\\\"0.4\\\" />\\n                <path d=\\\"M7 12C9 10 11 14 13 12C15 10 16 13 17 12\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"2\\\" strokeLinecap=\\\"round\\\" />\\n              </svg>\\n            </div>\\n          </div>\\n          <div className=\\\"flex items-center gap-1.5\\\">\\n            <span className=\\\"font-extrabold text-lg tracking-wider text-[#EAF4F4] font-heading whitespace-nowrap\\\">\\n              {t.appName}\\n            </span>\\n            <span className=\\\"hidden xl:inline-block text-[9px] uppercase tracking-widest text-[#2DD4BF] font-mono px-1.5 py-0.2 rounded bg-[#2DD4BF]/10 whitespace-nowrap\\\">\\n              Front Door\\n            </span>\\n          </div>\\n        </Link>\\n\\n        {/* Desktop Nav Links - Only visible at xl (1280px and above) to prevent any wrapping */}\\n        <nav className=\\\"hidden xl:flex items-center gap-1 whitespace-nowrap\\\">\\n          {navLinks.map(link => (\\n            <NavLink\\n              key={link.to}\\n              to={link.to}\\n              className={({ isActive }) =>\\n                `px-2.5 py-1.5 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\\n                  isActive\\n                    ? \'text-[#2DD4BF] bg-[#2DD4BF]/10 font-semibold\'\\n                    : \'text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5\'\\n                }`\\n              }\\n            >\\n              {link.label}\\n            </NavLink>\\n          ))}\\n          {result && (\\n            <NavLink\\n              to=\\\"/results\\\"\\n              className={({ isActive }) =>\\n                `flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\\n                  isActive\\n                    ? \'text-[#E8D5B5] bg-[#E8D5B5]/15 font-semibold\'\\n                    : \'text-[#E8D5B5]/90 hover:text-[#E8D5B5] hover:bg-white/5\'\\n                }`\\n              }\\n            >\\n              <Sparkles className=\\\"w-3.5 h-3.5 text-[#E8D5B5]\\\" />\\n              <span>Results</span>\\n            </NavLink>\\n          )}\\n        </nav>\\n\\n        {/* Right utility items */}\\n        <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n          {/* Theme Toggle */}\\n          <button\\n            onClick={toggleTheme}\\n            aria-label=\\\"Toggle light or dark theme\\\"\\n            className=\\\"p-1.5 rounded-lg text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-white/5 transition-colors\\\"\\n          >\\n            {theme === \'dark\' ? <Sun className=\\\"w-4 h-4 text-[#E8D5B5]\\\" /> : <Moon className=\\\"w-4 h-4 text-[#0F766E]\\\" />}\\n          </button>\\n\\n          {/* Language Switcher */}\\n          <LangSwitcher />\\n\\n          {/* Quick Hide */}\\n          <QuickHideButton />\\n\\n          {/* Hamburger menu below 1280px (xl) */}\\n          <button\\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\\n            className=\\\"xl:hidden p-2 rounded-lg text-[#9FB4BA] hover:text-white hover:bg-white/5 transition-colors\\\"\\n            aria-label=\\\"Toggle navigation menu\\\"\\n          >\\n            {mobileMenuOpen ? <X className=\\\"w-5 h-5 text-[#2DD4BF]\\\" /> : <Menu className=\\\"w-5 h-5\\\" />}\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Drawer for screens below 1280px */}\\n      {mobileMenuOpen && (\\n        <div className=\\\"xl:hidden border-b border-white/10 bg-[#0D1F29] px-4 py-3 space-y-1 shadow-2xl\\\">\\n          {navLinks.map(link => (\\n            <NavLink\\n              key={link.to}\\n              to={link.to}\\n              onClick={() => setMobileMenuOpen(false)}\\n              className={({ isActive }) =>\\n                `block px-3 py-2.5 rounded-lg text-sm font-medium ${\\n                  isActive\\n                    ? \'text-[#2DD4BF] bg-[#2DD4BF]/10 font-semibold\'\\n                    : \'text-[#9FB4BA] hover:text-white hover:bg-white/5\'\\n                }`\\n              }\\n            >\\n              {link.label}\\n            </NavLink>\\n          ))}\\n          {result && (\\n            <NavLink\\n              to=\\\"/results\\\"\\n              onClick={() => setMobileMenuOpen(false)}\\n              className=\\\"flex items-center gap-1.5 px-3 py-2.5 rounded-lg text-sm font-semibold text-[#E8D5B5] bg-[#E8D5B5]/10 mt-1\\\"\\n            >\\n              <Sparkles className=\\\"w-4 h-4 text-[#E8D5B5]\\\" />\\n              <span>View Screening Results</span>\\n            </NavLink>\\n          )}\\n        </div>\\n      )}\\n    </header>\\n  );\\n};\\n\",\"Description\":\"Update Navbar to never wrap, use whitespace-nowrap, move front door tag, and switch to hamburger below 1280px\",\"Overwrite\":true,\"TargetFile\":\"/src/components/Navbar.tsx\",\"toolAction\":\"Updating Navbar.tsx\",\"toolSummary\":\"Refactor Navbar responsiveness & wrapping\"}"
      thinking_signature: "\022i\ng\001i\024}\023\300\263\275j\323n),\261\343{\r\227?\233.&\267\354=\317\364!E\vTk\354\376f\365\305\334X\t\367\002\2122r\020\273>\315\376\210\225\235\001\353\241\371\000G\322\201<\r\312\340S\341&E\233\360l\032\352V\201\372G\003\252\377\210\343\201\255y*B\v\306\220=\213\206\340p\210\275\202Z\0164X"
