    end_line: 89
    content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { RiskBand } from \'../types\';\n\ninterface RiskGaugeProps {\n  score: number;\n  band: RiskBand;\n  size?: number;\n}\n\nexport const RiskGauge: React.FC<RiskGaugeProps> = ({ score, band, size = 200 }) => {\n  const strokeWidth = 14;\n  const radius = (size - strokeWidth) / 2;\n  const circumference = 2 * Math.PI * radius;\n  // Score percentage fill\n  const strokeDashoffset = circumference - (Math.min(100, Math.max(5, score)) / 100) * circumference;\n\n  const bandColors: Record<RiskBand, { stroke: string; glow: string; text: string; bg: string }> = {\n    Low: {\n      stroke: \'#34D399\',\n      glow: \'rgba(52, 211, 153, 0.3)\',\n      text: \'text-emerald-400\',\n      bg: \'bg-emerald-500/10\'\n    },\n    Moderate: {\n      stroke: \'#FBBF24\',\n      glow: \'rgba(251, 191, 36, 0.3)\',\n      text: \'text-amber-400\',\n      bg: \'bg-amber-500/10\'\n    },\n    Elevated: {\n      stroke: \'#FB923C\',\n      glow: \'rgba(251, 146, 60, 0.3)\',\n      text: \'text-orange-400\',\n      bg: \'bg-orange-500/10\'\n    },\n    Urgent: {\n      stroke: \'#F87171\',\n      glow: \'rgba(248, 113, 113, 0.4)\',\n      text: \'text-rose-400\',\n      bg: \'bg-rose-500/10\'\n    }\n  };\n\n  const currentTheme = bandColors[band];\n\n  return (\n    <div className=\"relative flex flex-col items-center justify-center\" style={{ width: size, height: size }}>\n      <svg width={size} height={size} className=\"transform -rotate-90\">\n        {/* Track circle */}\n        <circle\n          cx={size / 2}\n          cy={size / 2}\n          r={radius}\n          stroke=\"rgba(255, 255, 255, 0.08)\"\n          strokeWidth={strokeWidth}\n          fill=\"transparent\"\n        />\n        {/* Animated fill circle */}\n        <motion.circle\n          cx={size / 2}\n          cy={size / 2}\n          r={radius}\n          stroke={currentTheme.stroke}\n          strokeWidth={strokeWidth}\n          strokeDasharray={circumference}\n          initial={{ strokeDashoffset: circumference }}\n          animate={{ strokeDashoffset }}\n          transition={{ duration: 1.4, ease: [0.16, 1, 0.3, 1] }}\n          strokeLinecap=\"round\"\n          fill=\"transparent\"\n          style={{\n            filter: `drop-shadow(0 0 10px ${currentTheme.glow})`\n          }}\n        />\n      </svg>\n\n      {/* Center Label */}\n      <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center px-4\">\n        <span className={`text-xl font-bold tracking-tight font-heading ${currentTheme.text}`}>\n          {band}\n        </span>\n        <span className=\"text-[11px] font-mono text-[#9FB4BA] mt-0.5\">\n          Signal {score}/100\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 90
    num_bytes: 2668
    line_range_bytes: 2668
  }
}
