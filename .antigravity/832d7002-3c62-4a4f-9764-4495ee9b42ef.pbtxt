        instruction: "Add skeleton-shimmer, btn-tactile, and calm-pulse styles to src/index.css"
        is_edit: true
        file {
          absolute_uri: "file:///src/index.css"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: ".subtle-sand-bg {\n  background-color: var(--bg-deep);\n  background-image: radial-gradient(circle at 18% 12%, var(--brand-soft) 0%, transparent 48%),\n                    radial-gradient(circle at 82% 88%, var(--accent-soft) 0%, transparent 44%);\n}\n\n/* Reduced motion safety */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Print Styles for Clinician Summary */\n@media print {\n  body {\n    background-color: #fff !important;\n    color: #000 !important;\n    font-size: 13px !important;\n  }\n  .no-print {\n    display: none !important;\n  }\n  .paper-card, .surface-panel {\n    border: 1px solid #ccc !important;\n    background: #fff !important;\n    box-shadow: none !important;\n  }\n}"
          replacement_content: ".subtle-sand-bg {\n  background-color: var(--bg-deep);\n  background-image: radial-gradient(circle at 18% 12%, var(--brand-soft) 0%, transparent 48%),\n                    radial-gradient(circle at 82% 88%, var(--accent-soft) 0%, transparent 44%);\n}\n\n/* Tactile calm button physics */\nbutton,\na[role=\"button\"],\n.btn-calm {\n  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\nbutton:active:not(:disabled),\n.btn-calm:active {\n  transform: scale(0.985);\n}\n\n/* Calm skeleton shimmer (< 1Hz) */\n@keyframes hayat-shimmer {\n  0% { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n\n.skeleton-shimmer {\n  background: linear-gradient(\n    90deg,\n    var(--surface) 25%,\n    var(--card-alt) 50%,\n    var(--surface) 75%\n  );\n  background-size: 200% 100%;\n  animation: hayat-shimmer 2.2s ease-in-out infinite;\n}\n\n/* Gentle calm pulse (< 1Hz, well below 3Hz threshold) */\n@keyframes hayat-calm-pulse {\n  0%, 100% { transform: scale(1); opacity: 0.75; }\n  50% { transform: scale(1.22); opacity: 0.2; }\n}\n\n.calm-pulse-ring {\n  animation: hayat-calm-pulse 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;\n}\n\n/* Reduced motion safety */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n  .skeleton-shimmer {\n    animation: none !important;\n    background: var(--surface) !important;\n  }\n  .calm-pulse-ring {\n    animation: none !important;\n  }\n}\n\n/* Print Styles for Clinician Summary */\n@media print {\n  body {\n    background-color: #fff !important;\n    color: #000 !important;\n    font-size: 13px !important;\n  }\n  .no-print {\n    display: none !important;\n  }\n  .paper-card, .surface-panel {\n    border: 1px solid #ccc !important;\n    background: #fff !important;\n    box-shadow: none !important;\n  }\n}"
