  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { motion } from \'motion/react\';\nimport gsap from \'gsap\';\nimport { ScrollTrigger } from \'gsap/ScrollTrigger\';\nimport { useApp } from \'../store/AppContext\';\nimport { DEMO_PERSONAS } from \'../data/personas\';\nimport { assessRisk } from \'../engine/riskEngine\';\nimport { HeroWaveWrapper } from \'../components/HeroWaveWrapper\';\nimport {\n  Reveal,\n  SplitText,\n  Magnetic,\n  TiltCard,\n  EASE_CALM,\n  usePrefersReducedMotion,\n} from \'../motion\';\nimport {\n  ShieldCheck,\n  ArrowRight,\n  Lock,\n  Sparkles,\n  Clock,\n  HeartHandshake,\n  Activity,\n  FileCheck,\n  ChevronRight,\n  HelpCircle,\n  Stethoscope,\n  AlertTriangle,\n  Info,\n} from \'lucide-react\';\n\ngsap.registerPlugin(ScrollTrigger);\n\nexport const LandingPage: React.FC = () => {\n  const { t, language, setAllAnswers, setResult, updateConsent } = useApp();\n  const navigate = useNavigate();\n  const reduced = usePrefersReducedMotion();\n\n  // Pinned 4-beat GSAP scroll story state\n  const storyWrapRef = useRef<HTMLDivElement>(null);\n  const [storyProgress, setStoryProgress] = useState(0);\n  const activeBeat =\n    storyProgress < 0.25 ? 0 : storyProgress < 0.52 ? 1 : storyProgress < 0.78 ? 2 : 3;\n\n  useEffect(() => {\n    if (reduced) {\n      setStoryProgress(1);\n      return;\n    }\n    const el = storyWrapRef.current;\n    if (!el) return;\n\n    const ctx = gsap.context(() => {\n      ScrollTrigger.create({\n        trigger: el,\n        start: \'top 13%\',\n        end: \'+=1350\',\n        pin: true,\n        pinSpacing: true,\n        scrub: 0.45,\n        invalidateOnRefresh: true,\n        onUpdate: self => {\n          setStoryProgress(self.progress);\n        },\n      });\n    }, storyWrapRef);\n\n    return () => ctx.revert();\n  }, [reduced]);\n\n  const handleLaunchDemo = (personaId: \'low\' | \'moderate\' | \'urgent\') => {\n    const persona = DEMO_PERSONAS.find(p => p.id === personaId);\n    if (!persona) return;\n\n    updateConsent({ processAnswers: true, createClinicianSummary: true });\n    setAllAnswers(persona.answers);\n    const computedResult = assessRisk(persona.answers);\n    setResult(computedResult);\n    navigate(\'/results\');\n  };\n\n  const beats = [\n    {\n      num: \'01\',\n      title: \'Today: men often enter the fertility pathway late\',\n      body: \'Many couples spend months evaluating one partner first while modifiable male metabolic, heat, or lifestyle factors go unchecked.\',\n    },\n    {\n      num: \'02\',\n      title: \'Delayed start stretches uncertainty (~7.5 mo illustrative / simulated)\',\n      body: \'Waiting for passive referrals or fragmented appointments delays simple preventive action and clear baseline answers.\',\n    },\n    {\n      num: \'03\',\n      title: \'With a private first step, timeline compresses (~2.4 mo illustrative / simulated)\',\n      body: \'Private on-device screening surfaces modifiable habits early and prepares structured questions for the right specialist.\',\n    },\n    {\n      num: \'04\',\n      title: \'Your private first step takes 4 minutes\',\n      body: \'Zero account required. Transparent rule-based guidance stays strictly under your control.\',\n    },\n  ];\n\n  // Progress bar fill widths inside the pinned timeline visual\n  const delayFillPct = reduced\n    ? 100\n    : Math.min(100, Math.max(12, ((storyProgress - 0.12) / 0.36) * 100));\n  const compressedFillPct = reduced\n    ? 32\n    : storyProgress < 0.48\n    ? 0\n    : Math.min(32, ((storyProgress - 0.48) / 0.25) * 32);\n\n  return (\n    <div className=\"space-y-16 sm:space-y-24 pb-20\">\n      {/* 1. Full-Width Hero with WebGL / Static Dotted Wave */}\n      <section className=\"relative w-full min-h-[560px] sm:min-h-[620px] flex items-center justify-center py-16 sm:py-24 px-4 overflow-hidden\">\n        <HeroWaveWrapper />\n\n        <div className=\"relative z-10 max-w-4xl mx-auto text-center space-y-6\">\n          {/* Staggered Trust Pills */}\n          <motion.div\n            initial={reduced ? false : { opacity: 0, y: 12 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={reduced ? { duration: 0 } : { duration: 0.5, ease: EASE_CALM }}\n            className=\"inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-4 py-2 rounded-full bg-[var(--card)]/90 border border-[var(--border-hairline)] shadow-xs text-xs sm:text-sm text-[var(--text-muted)]\"\n          >\n            {[\n              { Icon: Lock, label: t.trustNoAccount, accent: true },\n              { Icon: ShieldCheck, label: t.trustDataControl, accent: false },\n              { Icon: Sparkles, label: t.trustExplainable, accent: true },\n            ].map((pill, i) => {\n              const PIcon = pill.Icon;\n              return (\n                <React.Fragment key={pill.label}>\n                  {i > 0 && (\n                    <span className=\"text-[var(--border-strong)]\" aria-hidden=\"true\">\n                      \342\200\242\n                    </span>\n                  )}\n                  <motion.span\n                    initial={reduced ? false : { opacity: 0, y: 6 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    transition={\n                      reduced\n                        ? { duration: 0 }\n                        : { duration: 0.4, delay: 0.08 + i * 0.09, ease: EASE_CALM }\n                    }\n                    className={`flex items-center gap-1.5 font-medium ${\n                      pill.accent ? \'text-[var(--accent-text)]\' : \'text-[var(--text-main)]\'\n                    }`}\n                  >\n                    <PIcon\n                      className={`w-3.5 h-3.5 shrink-0 ${\n                        pill.accent ? \'\' : \'text-[var(--brand)]\'\n                      }`}\n                    />\n                    <span>{pill.label}</span>\n                  </motion.span>\n                </React.Fragment>\n              );\n            })}\n          </motion.div>\n\n          {/* Accessible SplitText Hero Headline */}\n          <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[var(--text-main)] font-heading leading-[1.12] max-w-3xl mx-auto\">\n            {language === \'en\' ? (\n              <SplitText\n                text=\"A private first step for men\'s reproductive health.\"\n                highlightWord=\"private first step\"\n                highlightClassName=\"font-serif-accent italic font-normal text-[var(--brand)]\"\n                immediate\n              />\n            ) : (\n              <SplitText text={t.heroTitle} immediate />\n            )}\n          </h1>\n\n          <motion.p\n            initial={reduced ? false : { opacity: 0, y: 12 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={reduced ? { duration: 0 } : { duration: 0.52, delay: 0.22, ease: EASE_CALM }}\n            className=\"text-base sm:text-xl text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed\"\n          >\n            {t.heroSub}\n          </motion.p>\n\n          <motion.div\n            initial={reduced ? false : { opacity: 0, y: 14 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={reduced ? { duration: 0 } : { duration: 0.52, delay: 0.32, ease: EASE_CALM }}\n            className=\"pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5\"\n          >\n            <Magnetic className=\"w-full sm:w-auto\">\n              <Link\n                to=\"/consent\"\n                className=\"w-full sm:w-auto px-8 min-h-[52px] rounded-2xl font-heading font-semibold text-base\n                           bg-[var(--accent)] text-white shadow-sm hover:opacity-95\n                           transition-all flex items-center justify-center gap-2 group btn-calm\"\n              >\n                <span>{t.startCheck}</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-0.5 rtl:rotate-180 transition-transform\" />\n              </Link>\n            </Magnetic>\n\n            <Magnetic strength={0.14} className=\"w-full sm:w-auto\">\n              <Link\n                to=\"/how-it-works\"\n                className=\"w-full sm:w-auto px-6 min-h-[52px] rounded-2xl font-heading font-medium text-base\n                           bg-[var(--card)] text-[var(--text-main)] border border-[var(--border-strong)]\n                           hover:bg-[var(--surface)] transition-colors flex items-center justify-center gap-2 btn-calm\"\n              >\n                <HelpCircle className=\"w-4 h-4 text-[var(--brand)]\" />\n                <span>{t.howItWorks}</span>\n              </Link>\n            </Magnetic>\n          </motion.div>\n        </div>\n      </section>\n\n      {/* 2. GSAP Pinned 4-Beat Pathway Story */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <div\n          ref={storyWrapRef}\n          className=\"paper-card p-6 sm:p-10 space-y-6 overflow-hidden\"\n        >\n          <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-hairline)]\">\n            <div>\n              <span className=\"text-xs font-mono uppercase tracking-wider font-semibold text-[var(--accent-text)]\">\n                Pathway Contrast \302\267 Scroll Story\n              </span>\n              <h2 className=\"text-xl sm:text-2xl font-bold font-heading text-[var(--text-main)] mt-0.5\">\n                Why the first step changes the timeline\n              </h2>\n            </div>\n\n            {/* Beat Stepper Indicators */}\n            <div className=\"flex items-center gap-2\">\n              {beats.map((b, idx) => {\n                const isActive = reduced ? true : activeBeat === idx;\n                return (\n                  <button\n                    key={b.num}\n                    type=\"button\"\n                    onClick={() => setStoryProgress((idx + 0.5) / 4)}\n                    className={`px-2.5 min-h-[34px] rounded-full text-xs font-mono font-bold border transition-colors cursor-pointer ${\n                      isActive\n                        ? \'bg-[var(--accent)] text-white border-[var(--accent)]\'\n                        : \'bg-[var(--surface)] text-[var(--text-muted)] border-[var(--border-hairline)] hover:border-[var(--border-strong)]\'\n                    }`}\n                  >\n                    {b.num}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          <div className=\"grid lg:grid-cols-12 gap-6 items-center\">\n            {/* Active Narrative Beat Cards */}\n            <div className=\"lg:col-span-6 space-y-3\">\n              {beats.map((b, idx) => {\n                const highlighted = reduced ? idx === 3 : activeBeat === idx;\n                return (\n                  <div\n                    key={b.num}\n                    className={`p-4 rounded-2xl border transition-all duration-300 ${\n                      highlighted\n                        ? \'bg-[var(--accent-soft)] border-[var(--accent)] shadow-xs\'\n                        : \'bg-[var(--surface)] border-[var(--border-hairline)] opacity-65\'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <span\n                        className={`text-xs font-mono font-bold px-2 py-0.5 rounded-md mt-0.5 shrink-0 ${\n                          highlighted\n                            ? \'bg-[var(--accent)] text-white\'\n                            : \'bg-[var(--card)] text-[var(--text-muted)] border border-[var(--border-hairline)]\'\n                        }`}\n                      >\n                        {b.num}\n                      </span>\n                      <div>\n                        <h3 className=\"text-sm sm:text-base font-bold font-heading text-[var(--text-main)]\">\n                          {b.title}\n                        </h3>\n                        <p className=\"text-xs sm:text-sm text-[var(--text-muted)] mt-1 leading-relaxed\">\n                          {b.body}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Visual Timeline Compression + CTA Beat */}\n            <div className=\"lg:col-span-6 surface-panel p-6 sm:p-7 space-y-6\">\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between text-xs sm:text-sm\">\n                  <span className=\"font-semibold text-[var(--text-main)]\">\n                    Late entry pathway\n                  </span>\n                  <span className=\"font-mono font-semibold text-[var(--brand)]\">\n                    ~7.5 mo (illustrative / simulated)\n                  </span>\n                </div>\n                <div className=\"w-full h-3.5 rounded-full overflow-hidden bg-[var(--gauge-track)]\">\n                  <div\n                    className=\"h-full rounded-full transition-all duration-200\"\n                    style={{\n                      width: `${delayFillPct}%`,\n                      backgroundColor: \'var(--brand)\',\n                    }}\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between text-xs sm:text-sm\">\n                  <span className=\"font-semibold text-[var(--accent-text)]\">\n                    With a private first step\n                  </span>\n                  <span className=\"font-mono font-semibold text-[var(--accent-text)]\">\n                    ~2.4 mo (illustrative / simulated)\n                  </span>\n                </div>\n                <div className=\"w-full h-3.5 rounded-full overflow-hidden bg-[var(--gauge-track)]\">\n                  <div\n                    className=\"h-full rounded-full transition-all duration-200\"\n                    style={{\n                      width: `${compressedFillPct}%`,\n                      backgroundColor: \'var(--accent)\',\n                    }}\n                  />\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-[var(--border-hairline)] flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <p className=\"text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed\">\n                  Illustrative pathway modeling from synthetic cases. Ready to begin?\n                </p>\n                <Magnetic>\n                  <Link\n                    to=\"/consent\"\n                    className=\"px-6 min-h-[48px] rounded-2xl bg-[var(--accent)] text-white text-sm sm:text-base font-heading font-semibold hover:opacity-95 inline-flex items-center justify-center gap-2 shrink-0 btn-calm\"\n                  >\n                    <span>Start my private check</span>\n                    <ArrowRight className=\"w-4 h-4 rtl:rotate-180\" />\n                  </Link>\n                </Magnetic>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. Demo Personas Row */}\n      <Reveal className=\"max-w-5xl mx-auto px-4\">\n        <div className=\"paper-card p-6 sm:p-8 space-y-5\">\n          <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pb-4 border-b border-[var(--border-hairline)]\">\n            <div>\n              <span className=\"text-xs uppercase font-mono tracking-wider text-[var(--accent-text)] font-semibold\">\n                Instant Walkthrough\n              </span>\n              <h2 className=\"text-lg sm:text-xl font-heading font-bold text-[var(--text-main)] mt-0.5\">\n                {t.tryDemoCase}\n              </h2>\n            </div>\n            <p className=\"text-sm text-[var(--text-muted)] max-w-md\">\n              Explore live rule-based screening outcomes with zero typing. Pre-fills sample inputs and opens the explainable results story.\n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 gap-4\">\n            {DEMO_PERSONAS.map((persona, idx) => {\n              const isUrgent = persona.id === \'urgent\';\n              const isMod = persona.id === \'moderate\';\n              const tone = isUrgent\n                ? { color: \'var(--risk-urg)\', bg: \'var(--risk-urg-bg)\', border: \'var(--risk-urg-border)\', Icon: AlertTriangle }\n                : isMod\n                ? { color: \'var(--risk-mod)\', bg: \'var(--risk-mod-bg)\', border: \'var(--risk-mod-border)\', Icon: Info }\n                : { color: \'var(--risk-low)\', bg: \'var(--risk-low-bg)\', border: \'var(--risk-low-border)\', Icon: ShieldCheck };\n              const ToneIcon = tone.Icon;\n\n              return (\n                <motion.button\n                  key={persona.id}\n                  type=\"button\"\n                  onClick={() => handleLaunchDemo(persona.id)}\n                  initial={reduced ? false : { opacity: 0, y: 14 }}\n                  whileInView={{ opacity: 1, y: 0 }}\n                  viewport={{ once: true, amount: 0.15 }}\n                  transition={\n                    reduced ? { duration: 0 } : { duration: 0.42, delay: idx * 0.08, ease: EASE_CALM }\n                  }\n                  whileHover={reduced ? undefined : { y: -4 }}\n                  whileTap={reduced ? undefined : { scale: 0.985 }}\n                  className=\"text-start p-5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--surface)] hover:border-[var(--border-strong)] hover:bg-[var(--card-alt)] transition-colors flex flex-col justify-between cursor-pointer min-h-[170px] shadow-xs\"\n                >\n                  <div>\n                    <span\n                      className=\"text-xs font-semibold px-2.5 py-1 rounded-full inline-flex items-center gap-1.5 mb-3 border\"\n                      style={{ color: tone.color, backgroundColor: tone.bg, borderColor: tone.border }}\n                    >\n                      <ToneIcon className=\"w-3.5 h-3.5\" />\n                      <span>{persona.badge}</span>\n                    </span>\n                    <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">\n                      {persona.name}\n                    </h3>\n                    <p className=\"text-sm text-[var(--text-muted)] mt-1.5 leading-relaxed\">\n                      {persona.description}\n                    </p>\n                  </div>\n\n                  <div className=\"mt-4 pt-3 border-t border-[var(--border-hairline)] flex items-center justify-between text-sm text-[var(--accent-text)] font-semibold\">\n                    <span>Inspect Pathway</span>\n                    <ChevronRight className=\"w-4 h-4 rtl:rotate-180\" />\n                  </div>\n                </motion.button>\n              );\n            })}\n          </div>\n        </div>\n      </Reveal>\n\n      {/* 4. Why Earlier Matters */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <Reveal className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            {t.whyEarlierTitle}\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-xl mx-auto\">\n            Checking male factors early helps reduce prolonged uncertainty and supports timely everyday improvements.\n          </p>\n        </Reveal>\n\n        <div className=\"grid md:grid-cols-3 gap-5\">\n          {[\n            {\n              Icon: Activity,\n              title: t.whyModifiableTitle,\n              desc: t.whyModifiableDesc,\n              accent: true,\n            },\n            {\n              Icon: Clock,\n              title: t.whyEarlyBeatsLateTitle,\n              desc: t.whyEarlyBeatsLateDesc,\n              accent: false,\n            },\n            {\n              Icon: Lock,\n              title: t.whyFromHomeTitle,\n              desc: t.whyFromHomeDesc,\n              accent: true,\n            },\n          ].map((item, idx) => {\n            const CardIcon = item.Icon;\n            return (\n              <Reveal key={item.title} delay={idx * 0.08} className=\"h-full\">\n                <TiltCard className=\"h-full\">\n                  <div className=\"paper-card paper-card-hover p-6 sm:p-7 space-y-3 h-full\">\n                    <div\n                      className={`w-11 h-11 rounded-2xl flex items-center justify-center border border-[var(--border-hairline)] ${\n                        item.accent\n                          ? \'bg-[var(--accent-soft)] text-[var(--accent-text)]\'\n                          : \'bg-[var(--brand-soft)] text-[var(--brand)]\'\n                      }`}\n                    >\n                      <CardIcon className=\"w-5 h-5\" />\n                    </div>\n                    <h3 className=\"font-heading font-bold text-lg text-[var(--text-main)]\">\n                      {item.title}\n                    </h3>\n                    <p className=\"text-base text-[var(--text-muted)] leading-relaxed\">\n                      {item.desc}\n                    </p>\n                  </div>\n                </TiltCard>\n              </Reveal>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* 5. Built Around Trust & Dignity */}\n      <section className=\"max-w-5xl mx-auto px-4\">\n        <Reveal className=\"text-center space-y-2 mb-8\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            {t.builtAroundTrustTitle}\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-xl mx-auto\">\n            Conceived for the UAE and Middle Eastern context with calm, respectful design.\n          </p>\n        </Reveal>\n\n        <div className=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {[\n            { Icon: ShieldCheck, title: t.trustPrivateTitle, desc: t.trustPrivateDesc, accent: true },\n            { Icon: HeartHandshake, title: t.trustCulturalTitle, desc: t.trustCulturalDesc, accent: false },\n            { Icon: FileCheck, title: t.trustClinicalTitle, desc: t.trustClinicalDesc, accent: true },\n            { Icon: Stethoscope, title: t.trustHumanTitle, desc: t.trustHumanDesc, accent: false },\n          ].map((card, idx) => {\n            const CIcon = card.Icon;\n            return (\n              <Reveal key={card.title} delay={idx * 0.07} className=\"h-full\">\n                <TiltCard className=\"h-full\" maxTilt={4}>\n                  <div className=\"paper-card paper-card-hover p-6 space-y-2.5 h-full\">\n                    <CIcon\n                      className={`w-6 h-6 ${\n                        card.accent ? \'text-[var(--accent-text)]\' : \'text-[var(--brand)]\'\n                      }`}\n                    />\n                    <h3 className=\"font-heading font-bold text-base text-[var(--text-main)]\">\n                      {card.title}\n                    </h3>\n                    <p className=\"text-sm sm:text-base text-[var(--text-muted)] leading-relaxed\">\n                      {card.desc}\n                    </p>\n                  </div>\n                </TiltCard>\n              </Reveal>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* 6. Bottom CTA */}\n      <Reveal className=\"max-w-3xl mx-auto px-4 text-center\">\n        <div className=\"paper-card p-8 sm:p-10 space-y-4\">\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-heading text-[var(--text-main)]\">\n            Ready to explore your reproductive health in complete confidence?\n          </h2>\n          <p className=\"text-base text-[var(--text-muted)] max-w-lg mx-auto leading-relaxed\">\n            Take 4 minutes to gain clarity. You control what is stored, who sees it, and when to delete it.\n          </p>\n          <div className=\"pt-2 flex justify-center\">\n            <Magnetic>\n              <Link\n                to=\"/consent\"\n                className=\"inline-flex items-center justify-center gap-2 px-8 min-h-[52px] rounded-2xl font-heading font-semibold text-base\n                           bg-[var(--accent)] text-white hover:opacity-95 shadow-sm transition-opacity btn-calm\"\n              >\n                <span>{t.startCheck}</span>\n                <ArrowRight className=\"w-4 h-4 rtl:rotate-180\" />\n              </Link>\n            </Magnetic>\n          </div>\n        </div>\n      </Reveal>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/LandingPage.tsx"
        }
        overwrite: true
      }
    }
    action_result {
