            lines {
              text: "  // Body & Metabolic"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (answers.heightCm && answers.weightKg) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    items.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      field: \'Height & Weight (BMI)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      val: `${answers.heightCm} cm, ${answers.weightKg} kg`,"
