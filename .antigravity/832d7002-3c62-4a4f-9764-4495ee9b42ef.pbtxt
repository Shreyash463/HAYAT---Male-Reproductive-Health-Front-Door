    end_line: 89
    content: "import React, { useState } from \'react\';\nimport { RiskFactor } from \'../types\';\nimport { ArrowUpRight, ArrowDownRight, Minus, ChevronDown, ChevronUp, RefreshCw, Lock } from \'lucide-react\';\nimport { useApp } from \'../store/AppContext\';\n\ninterface FactorBarProps {\n  factor: RiskFactor;\n  detailed: boolean;\n}\n\nexport const FactorBar: React.FC<FactorBarProps> = ({ factor, detailed }) => {\n  const { t } = useApp();\n  const [expanded, setExpanded] = useState(false);\n\n  const isRaises = factor.direction === \'raises\';\n  const isLowers = factor.direction === \'lowers\';\n\n  const badgeColor = isRaises\n    ? \'bg-amber-500/10 text-amber-300 border-amber-500/20\'\n    : isLowers\n    ? \'bg-emerald-500/10 text-emerald-300 border-emerald-500/20\'\n    : \'bg-slate-500/10 text-slate-300 border-slate-500/20\';\n\n  const barColor = isRaises\n    ? \'bg-gradient-to-r from-amber-500 to-rose-400\'\n    : isLowers\n    ? \'bg-gradient-to-r from-teal-400 to-emerald-400\'\n    : \'bg-slate-400\';\n\n  // Normalize weight for bar width (max ~35)\n  const barWidth = Math.min(100, Math.max(12, Math.abs(factor.weight) * 3));\n\n  return (\n    <div className=\"glass-panel p-4 rounded-xl border border-white/5 space-y-2 transition-all\">\n      <div className=\"flex items-start justify-between gap-3\">\n        <div className=\"flex items-center gap-2\">\n          {isRaises && <ArrowUpRight className=\"w-4 h-4 text-amber-400 shrink-0\" />}\n          {isLowers && <ArrowDownRight className=\"w-4 h-4 text-emerald-400 shrink-0\" />}\n          {!isRaises && !isLowers && <Minus className=\"w-4 h-4 text-slate-400 shrink-0\" />}\n\n          <div>\n            <h4 className=\"text-xs font-semibold text-[#EAF4F4] leading-snug\">{factor.label}</h4>\n            <div className=\"flex items-center gap-2 mt-1\">\n              <span className=\"text-[10px] text-[#9FB4BA] font-mono\">\n                Input: <strong className=\"text-[#EAF4F4]\">{factor.userValue}</strong>\n              </span>\n              <span className={`text-[10px] px-2 py-0.5 rounded-full border ${badgeColor} inline-flex items-center gap-1`}>\n                {factor.modifiable ? (\n                  <>\n                    <RefreshCw className=\"w-2.5 h-2.5\" />\n                    <span>{t.canChange}</span>\n                  </>\n                ) : (\n                  <>\n                    <Lock className=\"w-2.5 h-2.5\" />\n                    <span>{t.cannotChange}</span>\n                  </>\n                )}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <button\n          onClick={() => setExpanded(!expanded)}\n          className=\"text-xs text-[#9FB4BA] hover:text-[#2DD4BF] p-1 rounded transition-colors\"\n          aria-label=\"Toggle details\"\n        >\n          {expanded ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n        </button>\n      </div>\n\n      {/* Visual Weight Bar */}\n      <div className=\"w-full bg-white/5 h-1.5 rounded-full overflow-hidden\">\n        <div\n          className={`h-full rounded-full transition-all duration-700 ${barColor}`}\n          style={{ width: `${barWidth}%` }}\n        />\n      </div>\n\n      {/* Detailed Plain Language Explanation */}\n      {(detailed || expanded) && (\n        <div className=\"pt-2 text-xs text-[#9FB4BA] leading-relaxed border-t border-white/5\">\n          <p>{factor.explanation}</p>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 90
    num_bytes: 3374
    line_range_bytes: 3374
  }
}
