    content: "import React from \'react\';\nimport { ShieldCheck, Info } from \'lucide-react\';\nimport { useApp } from \'../store/AppContext\';\n\nexport const SafetyFooter: React.FC = () => {\n  const { t } = useApp();\n\n  return (\n    <footer className=\"mt-auto border-t border-white/10 bg-[#07131A]/95 py-6 px-4 sm:px-6 transition-colors\">\n      <div className=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-[#A5BAC1]\">\n        <div className=\"flex items-center gap-2\">\n          <ShieldCheck className=\"w-5 h-5 text-[#2DD4BF] shrink-0\" />\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-xs font-semibold border border-[#2DD4BF]/20 whitespace-nowrap\">\n            {t.safetyBadge}\n          </span>\n        </div>\n\n        <p className=\"text-center md:text-left max-w-3xl leading-relaxed text-xs sm:text-sm text-[#A5BAC1]\">\n          <Info className=\"inline w-4 h-4 mr-1 text-[#E8D5B5]\" />\n          {t.safetyDisclaimer}\n        </p>\n\n        <div className=\"text-xs text-[#A5BAC1]/70 font-mono whitespace-nowrap\">\n          Abu Dhabi Innovation Challenge 2026\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
