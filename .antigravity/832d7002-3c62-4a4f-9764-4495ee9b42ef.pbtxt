              text: "| **Care Navigator** | `/care` | Discreet teleconsultation booking, Abu Dhabi clinics list with privacy filters, referral tracker |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Privacy Dashboard** | `/privacy` | Real-time data inventory, JSON export, device access log, immediate data erasure |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **Evidence & Evaluation** | `/evidence` | 500-case simulated cohort metrics, time-to-evaluation reduction, demographic fairness audit |"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "| **How It Works & Safety** | `/how-it-works` | Rule engine breakdown, emergency red-flag limits, 8-question FAQ |"
