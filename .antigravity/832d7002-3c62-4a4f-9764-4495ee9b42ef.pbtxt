    content: "import React from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { \n  ShieldCheck, \n  Lock, \n  CheckCircle2, \n  XCircle, \n  ArrowRight, \n  Info,\n  Clock,\n  Sparkles\n} from \'lucide-react\';\n\nexport const ConsentPage: React.FC = () => {\n  const { t, consent, updateConsent } = useApp();\n  const navigate = useNavigate();\n\n  const handleContinue = () => {\n    if (!consent.processAnswers) return;\n    navigate(\'/check\');\n  };\n\n  return (\n    <div className=\"max-w-3xl mx-auto px-4 py-8 space-y-8\">\n      {/* Title */}\n      <div className=\"text-center space-y-2\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-xs font-mono font-medium border border-[#2DD4BF]/20\">\n          <Lock className=\"w-3.5 h-3.5\" />\n          <span>Privacy By Design</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#EAF4F4]\">\n          {t.consentTitle}\n        </h1>\n        <p className=\"text-xs sm:text-sm text-[#9FB4BA] max-w-lg mx-auto\">\n          {t.consentSub}\n        </p>\n      </div>\n\n      {/* Two-Column Comparison Panel: What HAYAT Does vs Never Does */}\n      <div className=\"grid md:grid-cols-2 gap-4\">\n        {/* Does Panel */}\n        <div className=\"p-5 rounded-2xl glass-panel border border-[#2DD4BF]/20 bg-[#2DD4BF]/[0.02] space-y-3\">\n          <div className=\"flex items-center gap-2 text-[#2DD4BF]\">\n            <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n            <h2 className=\"font-heading font-semibold text-xs tracking-wide uppercase\">\n              {t.whatWeDo}\n            </h2>\n          </div>\n          <ul className=\"space-y-2 text-xs text-[#9FB4BA]\">\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[#2DD4BF] mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo1}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[#2DD4BF] mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo2}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-[#2DD4BF] mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeDo3}</span>\n            </li>\n          </ul>\n        </div>\n\n        {/* Never Does Panel */}\n        <div className=\"p-5 rounded-2xl glass-panel border border-rose-500/20 bg-rose-500/[0.02] space-y-3\">\n          <div className=\"flex items-center gap-2 text-rose-400\">\n            <XCircle className=\"w-4 h-4 shrink-0\" />\n            <h2 className=\"font-heading font-semibold text-xs tracking-wide uppercase\">\n              {t.whatWeNeverDo}\n            </h2>\n          </div>\n          <ul className=\"space-y-2 text-xs text-[#9FB4BA]\">\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-rose-400 mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever1}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-rose-400 mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever2}</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-rose-400 mt-0.5\">\342\200\242</span>\n              <span>{t.whatWeNever3}</span>\n            </li>\n          </ul>\n        </div>\n      </div>\n\n      {/* Granular Consent Toggles */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <h3 className=\"font-heading font-semibold text-sm text-[#EAF4F4]\">\n          Select your data permissions:\n        </h3>\n\n        <div className=\"space-y-3\">\n          {/* Toggle 1: Required */}\n          <label className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-white/15 cursor-pointer transition-all\">\n            <input\n              type=\"checkbox\"\n              checked={consent.processAnswers}\n              onChange={e => updateConsent({ processAnswers: e.target.checked })}\n              className=\"mt-0.5 w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n            <div className=\"text-xs\">\n              <span className=\"font-medium text-[#EAF4F4] block\">\n                {t.consentOpt1}\n              </span>\n              <span className=\"text-[11px] text-[#2DD4BF] font-mono\">\n                Mandatory for screening calculation\n              </span>\n            </div>\n          </label>\n\n          {/* Toggle 2: Save on Device */}\n          <label className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-white/15 cursor-pointer transition-all\">\n            <input\n              type=\"checkbox\"\n              checked={consent.saveOnDevice}\n              onChange={e => updateConsent({ saveOnDevice: e.target.checked })}\n              className=\"mt-0.5 w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n            <div className=\"text-xs\">\n              <span className=\"font-medium text-[#EAF4F4] block\">\n                {t.consentOpt2}\n              </span>\n              <span className=\"text-[11px] text-[#9FB4BA]\">\n                Saves in local browser cache only. Can be cleared at any time.\n              </span>\n            </div>\n          </label>\n\n          {/* Toggle 3: Research */}\n          <label className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-white/15 cursor-pointer transition-all\">\n            <input\n              type=\"checkbox\"\n              checked={consent.shareAnonymisedResearch}\n              onChange={e => updateConsent({ shareAnonymisedResearch: e.target.checked })}\n              className=\"mt-0.5 w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n            <div className=\"text-xs\">\n              <span className=\"font-medium text-[#EAF4F4] block\">\n                {t.consentOpt3}\n              </span>\n              <span className=\"text-[11px] text-[#9FB4BA]\">\n                Aggregated, non-identifiable parity metrics to assess algorithm fairness.\n              </span>\n            </div>\n          </label>\n\n          {/* Toggle 4: Clinician Summary */}\n          <label className=\"flex items-start gap-3 p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-white/15 cursor-pointer transition-all\">\n            <input\n              type=\"checkbox\"\n              checked={consent.createClinicianSummary}\n              onChange={e => updateConsent({ createClinicianSummary: e.target.checked })}\n              className=\"mt-0.5 w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n            <div className=\"text-xs\">\n              <span className=\"font-medium text-[#EAF4F4] block\">\n                {t.consentOpt4}\n              </span>\n              <span className=\"text-[11px] text-[#9FB4BA]\">\n                Formats a printable PDF summary for your clinical consultation.\n              </span>\n            </div>\n          </label>\n        </div>\n\n        {/* Data Minimisation Note */}\n        <div className=\"p-3 rounded-xl bg-white/[0.03] border border-white/5 flex items-center gap-2 text-[11px] text-[#9FB4BA]\">\n          <Info className=\"w-4 h-4 text-[#E8D5B5] shrink-0\" />\n          <span>{t.dataMinimisationNote}</span>\n        </div>\n      </div>\n\n      {/* Continue Button */}\n      <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4 pt-2\">\n        <span className=\"text-xs text-[#9FB4BA]\">\n          {consent.timestamp && (\n            <span className=\"font-mono text-[10px] text-white/50\">\n              Recorded: {new Date(consent.timestamp).toLocaleTimeString()}\n            </span>\n          )}\n        </span>\n\n        <button\n          onClick={handleContinue}\n          disabled={!consent.processAnswers}\n          className={`w-full sm:w-auto px-8 py-3 rounded-xl font-heading font-semibold text-sm flex items-center justify-center gap-2 transition-all ${\n            consent.processAnswers\n              ? \'bg-[#2DD4BF] text-[#07131A] hover:bg-[#2DD4BF]/90 shadow-md shadow-[#2DD4BF]/20 cursor-pointer\'\n              : \'bg-white/10 text-white/30 cursor-not-allowed\'\n          }`}\n        >\n          <span>{t.btnUnderstandContinue}</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 204
    num_bytes: 8485
    line_range_bytes: 8485
  }
}
