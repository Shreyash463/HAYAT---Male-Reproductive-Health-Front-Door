      create_file {
        instruction: "import React, { useRef, useState } from \'react\';\nimport { useIsTouchDevice, usePrefersReducedMotion } from \'./usePrefersReducedMotion\';\nimport { CSS_EASE_CALM } from \'./config\';\n\ninterface TiltCardProps {\n  children: React.ReactNode;\n  className?: string;\n  maxTilt?: number;\n}\n\nexport const TiltCard: React.FC<TiltCardProps> = ({\n  children,\n  className = \'\',\n  maxTilt = 3.2,\n}) => {\n  const isTouch = useIsTouchDevice();\n  const reduced = usePrefersReducedMotion();\n  const ref = useRef<HTMLDivElement>(null);\n  const [tilt, setTilt] = useState({ rx: 0, ry: 0, active: false });\n\n  if (isTouch || reduced) {\n    return <div className={className}>{children}</div>;\n  }\n\n  const handleMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    const el = ref.current;\n    if (!el) return;\n    const rect = el.getBoundingClientRect();\n    const px = (e.clientX - rect.left) / rect.width - 0.5;\n    const py = (e.clientY - rect.top) / rect.height - 0.5;\n    setTilt({\n      rx: -py * maxTilt * 2,\n      ry: px * maxTilt * 2,\n      active: true,\n    });\n  };\n\n  const handleLeave = () => setTilt({ rx: 0, ry: 0, active: false });\n\n  return (\n    <div\n      ref={ref}\n      onPointerMove={handleMove}\n      onPointerLeave={handleLeave}\n      className={className}\n      style={{\n        transform: `perspective(900px) rotateX(${tilt.rx.toFixed(2)}deg) rotateY(${tilt.ry.toFixed(2)}deg) translateY(${tilt.active ? -2 : 0}px)`,\n        transition: `transform 360ms ${CSS_EASE_CALM}`,\n        willChange: tilt.active ? \'transform\' : \'auto\',\n      }}\n    >\n      {children}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/motion/TiltCard.tsx"
        }
        overwrite: true
      }
