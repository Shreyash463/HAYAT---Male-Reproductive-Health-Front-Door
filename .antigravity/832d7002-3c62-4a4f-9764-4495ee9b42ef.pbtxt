    tool_calls {
      id: "call_13666372964660965724"
      name: "run_command"
      arguments_json: "{\"CommandLine\":\"npx tsx -e \\\"\\nimport { assessRisk, calculateBmi } from \'./src/engine/riskEngine\';\\nimport { DEMO_PERSONAS } from \'./src/data/personas\';\\nimport { generateSyntheticCohort, MOCK_CLINICS } from \'./src/data/syntheticCohort\';\\nimport { getHumanReadableInventory, formatLabel } from \'./src/utils/formatters\';\\nimport { en } from \'./src/i18n/en\';\\nimport { ar } from \'./src/i18n/ar\';\\nimport { hi } from \'./src/i18n/hi\';\\n\\n// 1. Personas\\nfor (const p of DEMO_PERSONAS) {\\n  const res = assessRisk(p.answers);\\n  console.log(\'Persona:\', p.id, \'-> Band:\', res.band, \'Score:\', res.score, \'Triage:\', res.triage);\\n}\\n\\n// 2. Conditional tryingDuration check\\nconst notTryingRes = assessRisk({ familyPlanning: \'not_now\', tryingDuration: \'over_12\' });\\nif (notTryingRes.factors.some(f => f.id === \'trying_12m\')) {\\n  throw new Error(\'tryingDuration should NOT be counted when familyPlanning !== trying\');\\n}\\n\\n// 3. What-if improvement check\\nconst modPersona = DEMO_PERSONAS.find(p => p.id === \'moderate\')!;\\nconst baseRes = assessRisk(modPersona.answers);\\nconst improvedRes = assessRisk({ ...modPersona.answers, smoking: \'never\', exerciseDays: 5, sleepHours: 8, heatExposure: [\'none\'] });\\nconsole.log(\'What-If Mod:\', baseRes.score, baseRes.band, \'->\', improvedRes.score, improvedRes.band);\\n\\n// 4. Raw enum leak check\\nconst inv = getHumanReadableInventory(modPersona.answers);\\nfor (const item of inv) {\\n  if (/under_3|not_now|over_12|prefer_not_to_say|hot_baths/.test(item.val)) {\\n    throw new Error(\'Raw enum leaked in inventory: \' + item.val);\\n  }\\n}\\n\\n// 5. Cohort check\\nconst cohort = generateSyntheticCohort();\\nconsole.log(\'Cohort cases:\', cohort.totalCases, \'Recall:\', cohort.redFlagRecall, \'MaxGap:\', cohort.maxGapPercentage);\\nif (cohort.redFlagRecall !== 100 || cohort.maxGapPercentage >= 5) {\\n  throw new Error(\'Cohort verification failed\');\\n}\\n\\n// 6. i18n key parity\\nconst enKeys = Object.keys(en);\\nfor (const k of enKeys) {\\n  if (!(k in ar) || !(k in hi)) throw new Error(\'Missing i18n key: \' + k);\\n}\\nconsole.log(\'All functional & i18n checks passed! Clinics count:\', MOCK_CLINICS.length);\\n\\\"\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Running engine and i18n verification\", \"toolSummary\":\"Verify engine and i18n\"}"
