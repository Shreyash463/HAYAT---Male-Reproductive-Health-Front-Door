  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@layer base {\n  /* Warm Sand Light Theme (DEFAULT) */\n  :root {\n    --bg-deep: #E8E1D5;\n    --surface: #F4EFE6;\n    --card: #FBF8F2;\n    --card-alt: #F0EADF;\n    --text-main: #2B2420;\n    --text-muted: #6B5F57;\n    --brand: #7A645C;\n    --brand-soft: rgba(122, 100, 92, 0.12);\n    --accent: #1F8A7D;\n    --accent-text: #156A60;\n    --accent-soft: rgba(31, 138, 125, 0.12);\n    --border-hairline: rgba(43, 36, 32, 0.11);\n    --border-strong: rgba(43, 36, 32, 0.22);\n    --card-shadow: 0 2px 12px -2px rgba(43, 36, 32, 0.06), 0 1px 3px 0 rgba(43, 36, 32, 0.04);\n    --card-shadow-hover: 0 12px 28px -8px rgba(43, 36, 32, 0.12), 0 4px 10px -2px rgba(43, 36, 32, 0.06);\n    --nav-bg: rgba(244, 239, 230, 0.88);\n    --input-bg: #F4EFE6;\n    --gauge-track: rgba(43, 36, 32, 0.10);\n\n    /* Risk Band Colors (accessible on light sand) */\n    --risk-low: #1D7A52;\n    --risk-low-bg: rgba(29, 122, 82, 0.10);\n    --risk-low-border: rgba(29, 122, 82, 0.28);\n\n    --risk-mod: #9A5B06;\n    --risk-mod-bg: rgba(154, 91, 6, 0.10);\n    --risk-mod-border: rgba(154, 91, 6, 0.28);\n\n    --risk-elev: #B44B18;\n    --risk-elev-bg: rgba(180, 75, 24, 0.10);\n    --risk-elev-border: rgba(180, 75, 24, 0.28);\n\n    --risk-urg: #B42323;\n    --risk-urg-bg: rgba(180, 35, 35, 0.10);\n    --risk-urg-border: rgba(180, 35, 35, 0.35);\n\n    --chart-grid: rgba(43, 36, 32, 0.12);\n    --chart-axis: #4E433D;\n\n    --font-heading: \'Outfit\', \'IBM Plex Sans Arabic\', \'Noto Sans Devanagari\', sans-serif;\n    --font-serif: \'Fraunces\', Georgia, serif;\n    --font-body: \'Inter\', \'IBM Plex Sans Arabic\', \'Noto Sans Devanagari\', sans-serif;\n  }\n\n  /* Polished Warm Charcoal Dark Theme (Toggle) */\n  .theme-dark {\n    --bg-deep: #171412;\n    --surface: #1F1B18;\n    --card: #27221E;\n    --card-alt: #2F2924;\n    --text-main: #F5EFE8;\n    --text-muted: #BEB2A9;\n    --brand: #C4AEA5;\n    --brand-soft: rgba(196, 174, 165, 0.14);\n    --accent: #3AB4A5;\n    --accent-text: #56CEC0;\n    --accent-soft: rgba(58, 180, 165, 0.15);\n    --border-hairline: rgba(245, 239, 232, 0.11);\n    --border-strong: rgba(245, 239, 232, 0.24);\n    --card-shadow: 0 4px 18px -4px rgba(0, 0, 0, 0.35);\n    --card-shadow-hover: 0 14px 32px -8px rgba(0, 0, 0, 0.5);\n    --nav-bg: rgba(23, 20, 18, 0.90);\n    --input-bg: #1F1B18;\n    --gauge-track: rgba(245, 239, 232, 0.12);\n\n    --risk-low: #4ADE80;\n    --risk-low-bg: rgba(74, 222, 128, 0.12);\n    --risk-low-border: rgba(74, 222, 128, 0.32);\n\n    --risk-mod: #FBBF24;\n    --risk-mod-bg: rgba(251, 191, 36, 0.12);\n    --risk-mod-border: rgba(251, 191, 36, 0.32);\n\n    --risk-elev: #FB923C;\n    --risk-elev-bg: rgba(251, 146, 60, 0.12);\n    --risk-elev-border: rgba(251, 146, 60, 0.32);\n\n    --risk-urg: #F87171;\n    --risk-urg-bg: rgba(248, 113, 113, 0.14);\n    --risk-urg-border: rgba(248, 113, 113, 0.42);\n\n    --chart-grid: rgba(245, 239, 232, 0.12);\n    --chart-axis: #D2C7BE;\n  }\n\n  html[lang=\"ar\"] body {\n    --font-heading: \'IBM Plex Sans Arabic\', \'Outfit\', sans-serif;\n    --font-body: \'IBM Plex Sans Arabic\', \'Inter\', sans-serif;\n  }\n\n  html[lang=\"hi\"] body {\n    --font-heading: \'Noto Sans Devanagari\', \'Outfit\', sans-serif;\n    --font-body: \'Noto Sans Devanagari\', \'Inter\', sans-serif;\n  }\n\n  body {\n    font-family: var(--font-body);\n    font-size: 16px;\n    line-height: 1.6;\n    background-color: var(--bg-deep);\n    color: var(--text-main);\n    transition: background-color 0.25s ease, color 0.25s ease;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-heading);\n    color: var(--text-main);\n  }\n\n  ::placeholder {\n    color: var(--text-muted);\n    opacity: 0.9;\n  }\n\n  *:focus-visible {\n    outline: 2px solid var(--accent);\n    outline-offset: 2px;\n  }\n}\n\n.font-serif-accent {\n  font-family: var(--font-serif);\n}\n\n/* Soft matte paper cards (no neon glow) */\n.paper-card {\n  background-color: var(--card);\n  border: 1px solid var(--border-hairline);\n  border-radius: 22px;\n  box-shadow: var(--card-shadow);\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, background-color 0.25s ease;\n}\n\n.paper-card-hover:hover {\n  border-color: var(--border-strong);\n  box-shadow: var(--card-shadow-hover);\n  transform: translateY(-2px);\n}\n\n.surface-panel {\n  background-color: var(--surface);\n  border: 1px solid var(--border-hairline);\n  border-radius: 20px;\n}\n\n.subtle-sand-bg {\n  background-color: var(--bg-deep);\n  background-image: radial-gradient(circle at 18% 12%, var(--brand-soft) 0%, transparent 48%),\n                    radial-gradient(circle at 82% 88%, var(--accent-soft) 0%, transparent 44%);\n}\n\n/* Reduced motion safety */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Print Styles for Clinician Summary */\n@media print {\n  body {\n    background-color: #fff !important;\n    color: #000 !important;\n    font-size: 13px !important;\n  }\n  .no-print {\n    display: none !important;\n  }\n  .paper-card, .surface-panel {\n    border: 1px solid #ccc !important;\n    background: #fff !important;\n    box-shadow: none !important;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
