      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useApp } from \'../store/AppContext\';\nimport { exportData } from \'../services/api\';\nimport { getHumanReadableInventory } from \'../utils/formatters\';\nimport { \n  ShieldCheck, \n  Trash2, \n  Download, \n  Clock, \n  ChevronDown, \n  ChevronUp, \n  AlertCircle,\n  CheckCircle2,\n  Database\n} from \'lucide-react\';\n\nexport const PrivacyDashboardPage: React.FC = () => {\n  const { \n    t, \n    consent, \n    updateConsent, \n    answers, \n    result, \n    clearAllData, \n    accessLogs, \n    addLog\n  } = useApp();\n\n  const [expandedFaq, setExpandedFaq] = useState<number | null>(null);\n  const [showWipeModal, setShowWipeModal] = useState(false);\n  const [wipeSuccess, setWipeSuccess] = useState(false);\n\n  const handleExport = async () => {\n    const jsonStr = await exportData(answers, result, consent);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `hayat-privacy-export-${new Date().toISOString().slice(0, 10)}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n    addLog(\'Data Exported\', \'Full JSON archive downloaded to user device\');\n  };\n\n  const handleWipe = () => {\n    clearAllData();\n    setShowWipeModal(false);\n    setWipeSuccess(true);\n    setTimeout(() => setWipeSuccess(false), 5000);\n  };\n\n  // Uses human-readable labels instead of raw enum keys\n  const inventoryItems = getHumanReadableInventory(answers);\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-10\">\n      {/* Header - Relabeled to \"You\'re in control\" */}\n      <div className=\"space-y-2\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#2DD4BF]/10 text-[#2DD4BF] text-xs font-mono font-medium border border-[#2DD4BF]/20\">\n          <ShieldCheck className=\"w-3.5 h-3.5\" />\n          <span>You\'re in control</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold font-heading text-[#EAF4F4]\">\n          {t.privacyTitle}\n        </h1>\n        <p className=\"text-sm text-[#9FB4BA]\">\n          {t.privacySub}\n        </p>\n      </div>\n\n      {wipeSuccess && (\n        <div className=\"p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-sm flex items-center gap-2\">\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-400 shrink-0\" />\n          <span>All data, answers, session caches, and persistent keys were completely deleted from this device.</span>\n        </div>\n      )}\n\n      {/* Action Controls Bar */}\n      <div className=\"p-5 rounded-2xl glass-panel border border-white/10 flex flex-wrap items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">Instant Data Export & Purge</h2>\n          <p className=\"text-sm text-[#9FB4BA]\">\n            You have full ownership of every bit stored. Download in standard JSON or wipe everything.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={handleExport}\n            className=\"px-4 py-2.5 rounded-xl border border-white/15 hover:border-white/30 text-sm font-medium text-[#EAF4F4] hover:bg-white/5 flex items-center gap-1.5 transition-colors\"\n          >\n            <Download className=\"w-4 h-4 text-[#2DD4BF]\" />\n            <span>{t.exportJson}</span>\n          </button>\n\n          <button\n            onClick={() => setShowWipeModal(true)}\n            className=\"px-4 py-2.5 rounded-xl bg-rose-500/20 text-rose-300 border border-rose-500/30 hover:bg-rose-500/30 text-sm font-medium flex items-center gap-1.5 transition-colors\"\n          >\n            <Trash2 className=\"w-4 h-4\" />\n            <span>{t.deleteEverything}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* DATA INVENTORY TABLE (Uses \"Why we use it\" header and human-readable text) */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Database className=\"w-4 h-4 text-[#2DD4BF]\" />\n            <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n              {t.dataInventory}\n            </h2>\n          </div>\n          <span className=\"text-xs font-mono text-[#9FB4BA] bg-white/5 px-2 py-0.5 rounded\">\n            Storage: {consent.saveOnDevice ? \'Local browser storage (authorized)\' : \'Ephemeral session memory only\'}\n          </span>\n        </div>\n\n        <div className=\"border border-white/10 rounded-xl overflow-x-auto\">\n          <table className=\"w-full text-left text-sm\">\n            <thead className=\"bg-white/[0.04] text-[#EAF4F4] border-b border-white/10\">\n              <tr>\n                <th className=\"p-3.5 font-semibold\">Data Attribute</th>\n                <th className=\"p-3.5 font-semibold\">Current Value</th>\n                <th className=\"p-3.5 font-semibold\">Stored Where</th>\n                <th className=\"p-3.5 font-semibold\">Why we use it</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-white/5 text-[#EAF4F4]\">\n              {inventoryItems.map((item, idx) => (\n                <tr key={idx} className=\"hover:bg-white/[0.02]\">\n                  <td className=\"p-3.5 font-medium text-[#EAF4F4]\">{item.field}</td>\n                  <td className=\"p-3.5 text-xs font-medium text-[#2DD4BF]\">{item.val}</td>\n                  <td className=\"p-3.5 text-xs text-[#9FB4BA]\">{item.storage}</td>\n                  <td className=\"p-3.5 text-xs text-[#9FB4BA] leading-relaxed\">{item.purpose}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* LIVE CONSENT TOGGLES (Editable anytime with instant effect) */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n            Live Consent Settings\n          </h2>\n          <span className=\"text-xs text-[#2DD4BF] font-mono\">Changes apply immediately</span>\n        </div>\n\n        <div className=\"space-y-3\">\n          <label className=\"flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/5 cursor-pointer\">\n            <div>\n              <span className=\"text-sm font-medium text-[#EAF4F4] block\">\n                {t.consentOpt1}\n              </span>\n              <span className=\"text-xs text-[#9FB4BA]\">\n                Processes answers in browser memory to compute your results.\n              </span>\n            </div>\n            <input\n              type=\"checkbox\"\n              checked={consent.processAnswers}\n              onChange={e => updateConsent({ processAnswers: e.target.checked })}\n              className=\"w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n          </label>\n\n          <label className=\"flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/5 cursor-pointer\">\n            <div>\n              <span className=\"text-sm font-medium text-[#EAF4F4] block\">\n                {t.consentOpt2}\n              </span>\n              <span className=\"text-xs text-[#9FB4BA]\">\n                Saves session in your browser localStorage for later review.\n              </span>\n            </div>\n            <input\n              type=\"checkbox\"\n              checked={consent.saveOnDevice}\n              onChange={e => updateConsent({ saveOnDevice: e.target.checked })}\n              className=\"w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n          </label>\n\n          <label className=\"flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/5 cursor-pointer\">\n            <div>\n              <span className=\"text-sm font-medium text-[#EAF4F4] block\">\n                {t.consentOpt3}\n              </span>\n              <span className=\"text-xs text-[#9FB4BA]\">\n                Contributes anonymised parity data for algorithmic fairness audits.\n              </span>\n            </div>\n            <input\n              type=\"checkbox\"\n              checked={consent.shareAnonymisedResearch}\n              onChange={e => updateConsent({ shareAnonymisedResearch: e.target.checked })}\n              className=\"w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n          </label>\n\n          <label className=\"flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/5 cursor-pointer\">\n            <div>\n              <span className=\"text-sm font-medium text-[#EAF4F4] block\">\n                {t.consentOpt4}\n              </span>\n              <span className=\"text-xs text-[#9FB4BA]\">\n                Permits formatting of clinician summary documents.\n              </span>\n            </div>\n            <input\n              type=\"checkbox\"\n              checked={consent.createClinicianSummary}\n              onChange={e => updateConsent({ createClinicianSummary: e.target.checked })}\n              className=\"w-4 h-4 rounded text-[#2DD4BF] focus:ring-[#2DD4BF] bg-[#07131A] border-white/20\"\n            />\n          </label>\n        </div>\n      </div>\n\n      {/* DEVICE ACCESS LOG */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Clock className=\"w-4 h-4 text-[#E8D5B5]\" />\n            <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n              {t.accessLog}\n            </h2>\n          </div>\n          <span className=\"text-xs font-mono text-[#9FB4BA]\">\n            {accessLogs.length} events logged\n          </span>\n        </div>\n\n        <div className=\"space-y-2 max-h-48 overflow-y-auto pr-2\">\n          {accessLogs.map(log => (\n            <div\n              key={log.id}\n              className=\"p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-between text-sm\"\n            >\n              <div>\n                <span className=\"font-semibold text-[#EAF4F4]\">{log.action}</span>\n                <span className=\"text-xs text-[#9FB4BA] block mt-0.5\">{log.detail}</span>\n              </div>\n              <span className=\"text-xs font-mono text-white/50 shrink-0\">\n                {new Date(log.timestamp).toLocaleTimeString()}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* HOW YOUR DATA IS PROTECTED ACCORDION */}\n      <div className=\"p-6 rounded-2xl glass-panel border border-white/10 space-y-4\">\n        <h2 className=\"text-base font-bold font-heading text-[#EAF4F4]\">\n          {t.howProtected}\n        </h2>\n\n        <div className=\"space-y-2\">\n          {[\n            {\n              title: \'Data Minimisation & Ephemerality\',\n              body: \'HAYAT does not ask for identity markers (such as name, phone, Emirates ID, or email). All evaluation happens client-side or in ephemeral server-side enclaves with zero session persistence.\'\n            },\n            {\n              title: \'Zero Third-Party Ad-Trackers or Cookies\',\n              body: \'We strictly omit Google Analytics, Meta Pixel, advertising identifiers, or tracking cookies. No demographic information is sold or transferred.\'\n            },\n            {\n              title: \'Cryptographic Protection & Transit Security\',\n              body: \'All communications operate over TLS 1.3 with AES-256 encryption. Stored preferences are scoped solely to the local origin sandboxed inside your mobile browser.\'\n            },\n            {\n              title: \'Unilateral Data Purge Rights\',\n              body: \'Clicking \"Delete everything now\" executes an unrecoverable wipe of application state and local storage, returning the application to initial zero-state.\'\n            }\n          ].map((item, idx) => (\n            <div key={idx} className=\"border border-white/10 rounded-xl overflow-hidden\">\n              <button\n                onClick={() => setExpandedFaq(expandedFaq === idx ? null : idx)}\n                className=\"w-full text-left p-3.5 bg-white/[0.02] hover:bg-white/[0.05] flex items-center justify-between text-sm font-medium text-[#EAF4F4]\"\n              >\n                <span>{item.title}</span>\n                {expandedFaq === idx ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n              </button>\n              {expandedFaq === idx && (\n                <div className=\"p-3.5 text-xs sm:text-sm text-[#9FB4BA] bg-black/10 leading-relaxed border-t border-white/10\">\n                  {item.body}\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* WIPE MODAL */}\n      {showWipeModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md\">\n          <div className=\"max-w-md w-full p-6 rounded-2xl bg-[#0D1F29] border border-rose-500/30 space-y-4\">\n            <div className=\"flex items-center gap-2 text-rose-400\">\n              <AlertCircle className=\"w-5 h-5\" />\n              <h3 className=\"text-base font-bold font-heading\">Permanently Erase All Data?</h3>\n            </div>\n            <p className=\"text-sm text-[#9FB4BA] leading-relaxed\">\n              This will immediately wipe your answers, screening results, consent records, and audit events. This action is instantaneous and cannot be reversed.\n            </p>\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                onClick={() => setShowWipeModal(false)}\n                className=\"px-4 py-2 rounded-xl text-sm text-[#9FB4BA] hover:text-white\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleWipe}\n                className=\"px-5 py-2 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition-colors\"\n              >\n                Erase Everything Now\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
