    content: "import { en } from \'./en\';\n\nexport const ar: typeof en = {\n  appName: \"\330\255\331\212\330\247\330\251 (HAYAT)\",\n  tagline: \"\330\247\331\204\330\250\331\210\330\247\330\250\330\251 \330\247\331\204\330\256\330\247\330\265\330\251 \331\204\330\265\330\255\330\251 \330\247\331\204\330\261\330\254\331\204 \330\247\331\204\330\245\331\206\330\254\330\247\330\250\331\212\330\251\",\n  heroTitle: \"\330\256\330\267\331\210\330\251 \330\243\331\210\331\204\331\211 \330\256\330\247\330\265\330\251 \331\210\330\263\330\261\331\212\330\251 \331\204\330\265\330\255\330\251 \330\247\331\204\330\261\330\254\331\204 \330\247\331\204\330\245\331\206\330\254\330\247\330\250\331\212\330\251.\",\n  heroSub: \"\330\250\330\257\331\210\331\206 \330\247\330\263\331\205. \330\250\330\257\331\210\331\206 \330\252\330\263\330\254\331\212\331\204 \330\257\330\256\331\210\331\204. \330\250\330\257\331\210\331\206 \330\243\331\212 \330\255\330\261\330\254. \330\245\330\261\330\264\330\247\330\257\330\247\330\252 \330\267\330\250\331\212\330\251 \331\210\330\247\330\266\330\255\330\251 \331\210\331\205\331\201\330\263\330\261\330\251 \330\250\330\247\331\204\331\203\330\247\331\205\331\204 \330\256\331\204\330\247\331\204 4 \330\257\331\202\330\247\330\246\331\202.\",\n  startCheck: \"\330\247\330\250\330\257\330\243 \330\252\331\202\331\212\331\212\331\205\331\212 \330\247\331\204\330\263\330\261\331\212 \330\247\331\204\330\242\331\206\",\n  howItWorks: \"\331\203\331\212\331\201 \331\212\330\271\331\205\331\204 \330\247\331\204\330\252\330\267\330\250\331\212\331\202\",\n\n  quickHide: \"\330\245\330\256\331\201\330\247\330\241 \330\263\330\261\331\212\330\271\",\n  quickHideTooltip: \"\330\256\330\261\331\210\330\254 \331\201\331\210\330\261\331\212 \331\210\330\263\330\261\331\212 (\331\205\331\201\330\252\330\247\330\255 Esc)\",\n  safetyBadge: \"\331\206\331\205\331\210\330\260\330\254 \330\243\331\210\331\204\331\212 \330\250\330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\255\330\247\331\203\330\247\330\251\",\n  safetyDisclaimer: \"\330\252\330\267\330\250\331\212\331\202 \330\255\331\212\330\247\330\251 \331\207\331\210 \330\243\330\257\330\247\330\251 \331\201\330\255\330\265 \331\210\330\252\331\210\330\254\331\212\331\207 \331\201\331\202\330\267. \331\210\331\204\330\247 \331\212\330\271\330\257 \330\252\330\264\330\256\331\212\330\265\330\247\331\213 \330\267\330\250\331\212\330\247\331\213 \330\243\331\210 \331\210\330\265\331\201\330\251 \330\271\331\204\330\247\330\254\331\212\330\251 \331\210\331\204\330\247 \331\212\330\272\331\206\331\212 \330\271\331\206 \330\247\331\204\330\267\330\250\331\212\330\250. \330\247\331\204\331\202\330\261\330\247\330\261 \330\247\331\204\330\267\330\250\331\212 \330\247\331\204\331\206\331\207\330\247\330\246\331\212 \330\257\330\247\330\246\331\205\330\247\331\213 \330\250\331\212\330\257 \330\247\331\204\331\205\330\256\330\252\330\265\331\212\331\206.\",\n  screeningNotDiagnosis: \"\331\207\330\260\330\247 \330\252\331\202\331\212\331\212\331\205 \330\243\331\210\331\204\331\212 \331\202\330\247\330\246\331\205 \330\271\331\204\331\211 \330\247\331\204\330\264\330\261\330\255\330\214 \331\210\331\204\331\212\330\263 \330\252\330\264\330\256\331\212\330\265\330\247\331\213 \330\267\330\250\331\212\330\247\331\213.\",\n\n  navHome: \"\330\247\331\204\330\261\330\246\331\212\330\263\331\212\330\251\",\n  navCheck: \"\330\250\330\257\330\241 \330\247\331\204\331\201\330\255\330\265\",\n  navCare: \"\330\257\331\204\331\212\331\204 \330\247\331\204\330\261\330\271\330\247\331\212\330\251\",\n  navPrivacy: \"\331\204\331\210\330\255\330\251 \330\247\331\204\330\256\330\265\331\210\330\265\331\212\330\251\",\n  navEvidence: \"\330\247\331\204\330\243\330\257\331\204\330\251 \331\210\330\247\331\204\331\206\330\252\330\247\330\246\330\254\",\n  navHowItWorks: \"\330\267\330\261\331\212\331\202\330\251 \330\247\331\204\330\271\331\205\331\204\",\n\n  trustNoAccount: \"\330\250\330\257\331\210\331\206 \330\245\331\206\330\264\330\247\330\241 \330\255\330\263\330\247\330\250\",\n  trustDataControl: \"\330\243\331\206\330\252 \330\252\330\252\330\255\331\203\331\205 \330\250\330\250\331\212\330\247\331\206\330\247\330\252\331\203 \331\203\331\204\331\212\330\247\331\213\",\n  trustExplainable: \"\330\264\331\201\330\247\331\201 \331\210\331\202\330\247\330\250\331\204 \331\204\331\204\330\252\331\201\330\263\331\212\330\261\",\n\n  whyEarlierTitle: \"\331\204\331\205\330\247\330\260\330\247 \331\212\330\271\330\257 \330\247\331\204\331\203\330\264\331\201 \330\247\331\204\331\205\330\250\331\203\330\261 \331\207\330\247\331\205\330\247\331\213\330\237\",\n  whyModifiableTitle: \"\330\247\331\204\330\271\330\257\331\212\330\257 \331\205\331\206 \330\247\331\204\330\271\331\210\330\247\331\205\331\204 \331\202\330\247\330\250\331\204\330\251 \331\204\331\204\330\252\330\271\330\257\331\212\331\204\",\n  whyModifiableDesc: \"\330\247\331\204\330\271\330\247\330\257\330\247\330\252 \330\247\331\204\330\255\331\212\330\247\330\252\331\212\330\251 \331\210\330\247\331\204\330\252\330\271\330\261\330\266 \331\204\331\204\330\255\330\261\330\247\330\261\330\251 \331\210\330\247\331\204\330\271\331\210\330\247\331\205\331\204 \330\247\331\204\330\243\331\212\330\266\331\212\330\251 \331\212\331\205\331\203\331\206 \330\252\330\255\330\263\331\212\331\206\331\207\330\247 \330\256\331\204\330\247\331\204 3 \330\243\330\264\331\207\330\261.\",\n  whyEarlyBeatsLateTitle: \"\330\247\331\204\331\201\330\255\330\265 \330\247\331\204\331\205\330\250\331\203\330\261 \331\212\330\256\330\252\330\265\330\261 \330\263\331\206\331\210\330\247\330\252\",\n  whyEarlyBeatsLateDesc: \"\331\212\330\265\331\204 \331\205\330\271\330\270\331\205 \330\247\331\204\330\261\330\254\330\247\331\204 \330\245\331\204\331\211 \330\247\331\204\330\271\331\212\330\247\330\257\330\251 \330\250\330\271\330\257 \330\252\330\243\330\256\330\261 \330\267\331\210\331\212\331\204