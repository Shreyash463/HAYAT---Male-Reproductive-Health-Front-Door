            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Age"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  items.push({"
