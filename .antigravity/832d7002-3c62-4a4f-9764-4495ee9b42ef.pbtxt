  code_action {
    action_spec {
      create_file {
        instruction: "import React, { Suspense, useEffect, useMemo, useRef, useState } from \'react\';\nimport { useApp } from \'../store/AppContext\';\n\nconst LazyHeroDottedWave = React.lazy(() => import(\'./HeroDottedWave\'));\n\nconst StaticWaveFallback: React.FC = () => {\n  const dots = useMemo(() => {\n    const pts: { cx: number; cy: number; r: number; o: number }[] = [];\n    const cols = 42;\n    const rows = 14;\n    for (let r = 0; r < rows; r++) {\n      for (let c = 0; c < cols; c++) {\n        const nx = c / (cols - 1);\n        const nz = r / (rows - 1);\n        const wave =\n          Math.sin(nx * Math.PI * 3.2) * 18 +\n          Math.cos(nz * Math.PI * 2.1 + nx * 2.5) * 12;\n        const cx = nx * 1200;\n        const cy = 110 + nz * 210 + wave;\n        const radius = 1.2 + nz * 1.1;\n        const opacity = 0.14 + (1 - Math.abs(nz - 0.5) * 1.4) * 0.25;\n        pts.push({ cx, cy, r: radius, o: Math.max(0.08, opacity) });\n      }\n    }\n    return pts;\n  }, []);\n\n  return (\n    <svg\n      viewBox=\"0 0 1200 380\"\n      preserveAspectRatio=\"xMidYMid slice\"\n      className=\"w-full h-full pointer-events-none select-none\"\n      aria-hidden=\"true\"\n    >\n      {dots.map((d, i) => (\n        <circle\n          key={i}\n          cx={d.cx}\n          cy={d.cy}\n          r={d.r}\n          fill=\"var(--brand)\"\n          fillOpacity={d.o}\n        />\n      ))}\n    </svg>\n  );\n};\n\nfunction detectWebGLSupport(): boolean {\n  try {\n    const canvas = document.createElement(\'canvas\');\n    return !!(\n      window.WebGLRenderingContext &&\n      (canvas.getContext(\'webgl2\') || canvas.getContext(\'webgl\') || canvas.getContext(\'experimental-webgl\'))\n    );\n  } catch {\n    return false;\n  }\n}\n\nexport const HeroWaveWrapper: React.FC = () => {\n  const { theme } = useApp();\n  const pointerRef = useRef({ x: 0, y: 0 });\n  const [canUseWebGL, setCanUseWebGL] = useState(false);\n\n  useEffect(() => {\n    const prefersReduced =\n      typeof window !== \'undefined\' &&\n      window.matchMedia?.(\'(prefers-reduced-motion: reduce)\').matches;\n    const lowPower =\n      typeof navigator !== \'undefined\' &&\n      typeof navigator.hardwareConcurrency === \'number\' &&\n      navigator.hardwareConcurrency <= 2;\n\n    if (!prefersReduced && !lowPower && detectWebGLSupport()) {\n      setCanUseWebGL(true);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (!canUseWebGL) return;\n    const handleMove = (e: PointerEvent) => {\n      const nx = (e.clientX / window.innerWidth) * 2 - 1;\n      const ny = (e.clientY / window.innerHeight) * 2 - 1;\n      pointerRef.current.x = nx;\n      pointerRef.current.y = ny;\n    };\n    window.addEventListener(\'pointermove\', handleMove, { passive: true });\n    return () => window.removeEventListener(\'pointermove\', handleMove);\n  }, [canUseWebGL]);\n\n  return (\n    <div\n      className=\"absolute inset-0 overflow-hidden pointer-events-none\"\n      aria-hidden=\"true\"\n    >\n      {canUseWebGL ? (\n        <Suspense fallback={<StaticWaveFallback />}>\n          <LazyHeroDottedWave theme={theme} pointerRef={pointerRef} />\n        </Suspense>\n      ) : (\n        <StaticWaveFallback />\n      )}\n      {/* Soft top & bottom fade into page sand background */}\n      <div\n        className=\"absolute inset-x-0 bottom-0 h-28 pointer-events-none\"\n        style={{\n          background:\n            \'linear-gradient(to bottom, transparent 0%, var(--bg-deep) 100%)\',\n        }}\n      />\n      <div\n        className=\"absolute inset-x-0 top-0 h-16 pointer-events-none\"\n        style={{\n          background:\n            \'linear-gradient(to top, transparent 0%, var(--bg-deep) 100%)\',\n        }}\n      />\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/HeroWaveWrapper.tsx"
        }
        overwrite: true
      }
    }
