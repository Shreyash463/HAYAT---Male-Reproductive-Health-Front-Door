    end_line: 56
    content: "import React from \'react\';\nimport { HashRouter, Routes, Route, Navigate } from \'react-router-dom\';\nimport { AppProvider, useApp } from \'./store/AppContext\';\nimport { Navbar } from \'./components/Navbar\';\nimport { SafetyFooter } from \'./components/SafetyFooter\';\nimport { QuickHideScreen } from \'./components/QuickHideScreen\';\n\n// Screens\nimport { LandingPage } from \'./pages/LandingPage\';\nimport { ConsentPage } from \'./pages/ConsentPage\';\nimport { WizardPage } from \'./pages/WizardPage\';\nimport { AnalysingPage } from \'./pages/AnalysingPage\';\nimport { ResultsPage } from \'./pages/ResultsPage\';\nimport { CareNavigatorPage } from \'./pages/CareNavigatorPage\';\nimport { PrivacyDashboardPage } from \'./pages/PrivacyDashboardPage\';\nimport { EvidencePage } from \'./pages/EvidencePage\';\nimport { HowItWorksPage } from \'./pages/HowItWorksPage\';\n\nconst AppLayout: React.FC = () => {\n  const { isQuickHideActive } = useApp();\n\n  if (isQuickHideActive) {\n    return <QuickHideScreen />;\n  }\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-wave-mesh\">\n      <Navbar />\n      <main className=\"flex-1\">\n        <Routes>\n          <Route path=\"/\" element={<LandingPage />} />\n          <Route path=\"/consent\" element={<ConsentPage />} />\n          <Route path=\"/check\" element={<WizardPage />} />\n          <Route path=\"/analysing\" element={<AnalysingPage />} />\n          <Route path=\"/results\" element={<ResultsPage />} />\n          <Route path=\"/care\" element={<CareNavigatorPage />} />\n          <Route path=\"/privacy\" element={<PrivacyDashboardPage />} />\n          <Route path=\"/evidence\" element={<EvidencePage />} />\n          <Route path=\"/how-it-works\" element={<HowItWorksPage />} />\n          <Route path=\"*\" element={<Navigate to=\"/\" replace />} />\n        </Routes>\n      </main>\n      <SafetyFooter />\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <HashRouter>\n      <AppProvider>\n        <AppLayout />\n      </AppProvider>\n    </HashRouter>\n  );\n}\n"
    num_lines: 57
    num_bytes: 1983
    line_range_bytes: 1983
  }
}
