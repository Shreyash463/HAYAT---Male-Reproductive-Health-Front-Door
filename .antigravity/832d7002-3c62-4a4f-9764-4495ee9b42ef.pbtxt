    content: "import React from \'react\';\nimport { useApp } from \'../store/AppContext\';\nimport { EyeOff } from \'lucide-react\';\n\nexport const QuickHideButton: React.FC = () => {\n  const { triggerQuickHide, t } = useApp();\n\n  return (\n    <button\n      onClick={triggerQuickHide}\n      aria-label={t.quickHideTooltip}\n      title={`${t.quickHide} (Esc)`}\n      className=\"group relative inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium \n                 bg-[#132B38]/80 text-[#9FB4BA] hover:text-[#EAF4F4] hover:bg-[#1A3848] \n                 border border-white/10 hover:border-[#2DD4BF]/40 \n                 shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#2DD4BF]\"\n    >\n      <EyeOff className=\"w-3.5 h-3.5 text-[#2DD4BF] group-hover:scale-110 transition-transform\" />\n      <span className=\"hidden sm:inline font-sans\">{t.quickHide}</span>\n      <kbd className=\"hidden md:inline-block px-1.5 py-0.2 text-[10px] uppercase font-mono bg-black/30 rounded border border-white/10 text-white/60\">\n        Esc\n      </kbd>\n    </button>\n  );\n};\n"
