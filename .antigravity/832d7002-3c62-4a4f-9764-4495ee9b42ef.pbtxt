    end_line: 100
    content: "import React, { useEffect, useState } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useApp } from \'../store/AppContext\';\nimport { assess } from \'../services/api\';\nimport { ShieldCheck, Heart, Sparkles, CheckCircle2 } from \'lucide-react\';\nimport { motion, AnimatePresence, useReducedMotion } from \'motion/react\';\n\nexport const AnalysingPage: React.FC = () => {\n  const { answers, setResult, t } = useApp();\n  const navigate = useNavigate();\n  const shouldReduceMotion = useReducedMotion();\n\n  const [activeMessageIndex, setActiveMessageIndex] = useState(0);\n\n  const messages = [\n    { text: t.reassurance1, icon: ShieldCheck, color: \'var(--risk-mod)\' },\n    { text: t.reassurance2, icon: Heart, color: \'var(--accent-text)\' },\n    { text: t.reassurance3, icon: Sparkles, color: \'var(--brand)\' }\n  ];\n\n  useEffect(() => {\n    const interval = setInterval(() => {\n      setActiveMessageIndex(prev => (prev < messages.length - 1 ? prev + 1 : prev));\n    }, 850);\n\n    let cancelled = false;\n    assess(answers).then(computed => {\n      if (cancelled) return;\n      setResult(computed);\n      setTimeout(() => {\n        if (!cancelled) navigate(\'/results\');\n      }, shouldReduceMotion ? 600 : 2200);\n    });\n\n    return () => {\n      cancelled = true;\n      clearInterval(interval);\n    };\n  }, []);\n\n  const CurrentIcon = messages[activeMessageIndex].icon;\n\n  return (\n    <div className=\"min-h-[70vh] flex flex-col items-center justify-center px-4 text-center\">\n      <div className=\"max-w-md w-full p-8 sm:p-10 paper-card space-y-8 relative overflow-hidden\">\n        <div className=\"relative mx-auto w-20 h-20 rounded-full flex items-center justify-center\">\n          {!shouldReduceMotion && (\n            <motion.div\n              className=\"absolute inset-0 rounded-full bg-[var(--accent-soft)]\"\n              animate={{ scale: [1, 1.25, 1], opacity: [0.6, 0.2, 0.6] }}\n              transition={{ repeat: Infinity, duration: 2, ease: \'easeInOut\' }}\n            />\n          )}\n          <div className=\"relative w-16 h-16 rounded-full bg-[var(--surface)] border border-[var(--border-strong)] flex items-center justify-center shadow-xs\">\n            <CurrentIcon\n              className=\"w-7 h-7 transition-colors duration-300\"\n              style={{ color: messages[activeMessageIndex].color }}\n            />\n          </div>\n        </div>\n\n        <div className=\"space-y-2\">\n          <h1 className=\"text-xl font-bold font-heading text-[var(--text-main)]\">\n            {t.analysingTitle}\n          </h1>\n          <p className=\"text-sm sm:text-base text-[var(--text-muted)]\">\n            Applying transparent clinical guidelines in a private on-device session.\n          </p>\n        </div>\n\n        <div className=\"min-h-[48px] flex items-center justify-center\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeMessageIndex}\n              initial={shouldReduceMotion ? false : { opacity: 0, y: 8 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={shouldReduceMotion ? { opacity: 0 } : { opacity: 0, y: -8 }}\n              transition={shouldReduceMotion ? { duration: 0 } : { duration: 0.25 }}\n              className=\"flex items-center gap-2 text-sm sm:text-base font-medium text-[var(--text-main)]\"\n            >\n              <CheckCircle2 className=\"w-4 h-4 text-[var(--accent-text)] shrink-0\" />\n              <span>{messages[activeMessageIndex].text}</span>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        <div className=\"flex justify-center gap-2 pt-2\">\n          {messages.map((_, i) => (\n            <div\n              key={i}\n              className={`h-2 rounded-full transition-all duration-300 ${\n                i === activeMessageIndex ? \'w-7 bg-[var(--accent)]\' : \'w-2 bg-[var(--gauge-track)]\'\n              }`}\n            />\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 101
    num_bytes: 3924
    line_range_bytes: 3924
  }
}
