    end_line: 160
    content: "import React, { useMemo, useRef, useEffect } from \'react\';\nimport { Canvas, useFrame, useThree } from \'@react-three/fiber\';\nimport * as THREE from \'three\';\nimport { Theme } from \'../types\';\n\ninterface WavePointsProps {\n  theme: Theme;\n  pointerRef: React.MutableRefObject<{ x: number; y: number }>;\n}\n\nconst COLS = 100;\nconst ROWS = 60;\nconst COUNT = COLS * ROWS; // 6,000 points\n\nconst WavePoints: React.FC<WavePointsProps> = ({ theme, pointerRef }) => {\n  const pointsRef = useRef<THREE.Points>(null);\n  const { invalidate } = useThree();\n  const timeRef = useRef(0);\n  const lastFrameRef = useRef(0);\n\n  const { baseX, baseZ, positions } = useMemo(() => {\n    const pos = new Float32Array(COUNT * 3);\n    const bx = new Float32Array(COUNT);\n    const bz = new Float32Array(COUNT);\n\n    const width = 22;\n    const depth = 13;\n    let idx = 0;\n\n    for (let r = 0; r < ROWS; r++) {\n      for (let c = 0; c < COLS; c++) {\n        const x = (c / (COLS - 1) - 0.5) * width;\n        const z = (r / (ROWS - 1) - 0.5) * depth;\n        bx[idx] = x;\n        bz[idx] = z;\n\n        pos[idx * 3] = x;\n        pos[idx * 3 + 1] =\n          Math.sin(x * 0.42) * 0.45 +\n          Math.cos(z * 0.55) * 0.35 +\n          Math.sin((x + z) * 0.25) * 0.25;\n        pos[idx * 3 + 2] = z;\n        idx++;\n      }\n    }\n\n    return { baseX: bx, baseZ: bz, positions: pos };\n  }, []);\n\n  // Controlled demand-driven loop throttled to ~28fps and paused when tab is hidden\n  useEffect(() => {\n    let rafId = 0;\n    const INTERVAL_MS = 35;\n\n    const tick = (now: number) => {\n      if (!document.hidden && now - lastFrameRef.current >= INTERVAL_MS) {\n        lastFrameRef.current = now;\n        invalidate();\n      }\n      rafId = requestAnimationFrame(tick);\n    };\n\n    const handleVisibility = () => {\n      if (!document.hidden) {\n        lastFrameRef.current = performance.now();\n        invalidate();\n      }\n    };\n\n    document.addEventListener(\'visibilitychange\', handleVisibility);\n    rafId = requestAnimationFrame(tick);\n\n    return () => {\n      cancelAnimationFrame(rafId);\n      document.removeEventListener(\'visibilitychange\', handleVisibility);\n    };\n  }, [invalidate]);\n\n  useFrame((_, delta) => {\n    if (!pointsRef.current) return;\n    const clampedDelta = Math.min(delta, 0.08);\n    timeRef.current += clampedDelta * 0.65;\n    const t = timeRef.current;\n\n    const geom = pointsRef.current.geometry;\n    const attr = geom.getAttribute(\'position\') as THREE.BufferAttribute;\n    const arr = attr.array as Float32Array;\n\n    const px = pointerRef.current.x;\n    const py = pointerRef.current.y;\n\n    for (let i = 0; i < COUNT; i++) {\n      const x = baseX[i];\n      const z = baseZ[i];\n      const wave1 = Math.sin(x * 0.42 + t) * 0.48;\n      const wave2 = Math.cos(z * 0.55 + t * 0.78) * 0.34;\n      const wave3 = Math.sin((x * 0.26 - z * 0.32) + t * 0.55) * 0.26;\n      arr[i * 3 + 1] = wave1 + wave2 + wave3;\n    }\n\n    attr.needsUpdate = true;\n\n    // Gentle parallax drift toward pointer\n    pointsRef.current.rotation.y = THREE.MathUtils.lerp(\n      pointsRef.current.rotation.y,\n      px * 0.08,\n      0.06\n    );\n    pointsRef.current.rotation.x = THREE.MathUtils.lerp(\n      pointsRef.current.rotation.x,\n      0.16 + py * 0.04,\n      0.06\n    );\n  });\n\n  const pointColor = theme === \'dark\' ? \'#C4AEA5\' : \'#7A645C\';\n  const pointOpacity = theme === \'dark\' ? 0.42 : 0.48;\n\n  return (\n    <points ref={pointsRef} rotation={[0.16, 0, 0]} position={[0, -0.8, 0]}>\n      <bufferGeometry>\n        <bufferAttribute\n          attach=\"attributes-position\"\n          args={[positions, 3]}\n          count={COUNT}\n          itemSize={3}\n        />\n      </bufferGeometry>\n      <pointsMaterial\n        color={pointColor}\n        size={0.075}\n        sizeAttenuation\n        transparent\n        opacity={pointOpacity}\n        depthWrite={false}\n      />\n    </points>\n  );\n};\n\ninterface HeroDottedWaveProps {\n  theme: Theme;\n  pointerRef: React.MutableRefObject<{ x: number; y: number }>;\n}\n\nexport const HeroDottedWave: React.FC<HeroDottedWaveProps> = ({ theme, pointerRef }) => {\n  return (\n    <Canvas\n      dpr={[1, 1.5]}\n      frameloop=\"demand\"\n      camera={{ position: [0, 3.2, 8.8], fov: 46 }}\n      gl={{ antialias: true, alpha: true, powerPreference: \'low-power\' }}\n      style={{ width: \'100%\', height: \'100%\', pointerEvents: \'none\' }}\n    >\n      <WavePoints theme={theme} pointerRef={pointerRef} />\n    </Canvas>\n  );\n};\n\nexport default HeroDottedWave;\n"
    num_lines: 161
    num_bytes: 4459
    line_range_bytes: 4459
  }
}
