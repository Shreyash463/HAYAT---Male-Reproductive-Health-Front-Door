    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "832d7002-3c62-4a4f-9764-4495ee9b42ef"
      step_index: 1
      cascade_id: "832d7002-3c62-4a4f-9764-4495ee9b42ef"
