# Gemini API Key (Required for AI explanation endpoint)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional - defaults to auto-detected latest stable Flash model)
GEMINI_MODEL=gemini-2.5-flash

# Port for FastAPI server
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional Firebase Service Account JSON Path (for research aggregation in production)
# If empty, falls back to local SQLite database in backend/data/
FIREBASE_CREDENTIALS_PATH=
